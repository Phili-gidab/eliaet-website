---
import { responsive } from '../lib/media'
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
import SectionHead from '../components/SectionHead.astro'
import MembershipForm from '../components/MembershipForm.astro'
import { Login } from '../app/Auth'
import { CATEGORIES, CATEGORY_NOTES } from '../../../shared/options'
import {
  SECTORS, SIZE_NOTE, BY_SIZE, SECTOR_TOTALS, SIZE_TOTALS, TOTAL_MEMBERS, MEMBERS_HEAD, LOGIN_NOTE, BENEFITS, JOIN,
  type SectorKey, type SizeKey,
} from '../copy/members'
import '../styles/app.css'

const sectorKeys = Object.keys(SECTORS) as SectorKey[]
const sizeKeys: SizeKey[] = ['large', 'medium', 'small']
const SIZE_LABEL: Record<SizeKey, string> = { large: 'Large', medium: 'Medium', small: 'Small' }
/* the content document's column names */
const COLUMN: Record<SectorKey, string> = { tannery: 'Tannery', footwear: 'Shoe', 'leather-goods': 'Other Leather Products' }

/* one dot per member company, a band per sector, large to small inside each band */
const bands = sectorKeys.map((k) => ({
  key: k,
  total: SECTOR_TOTALS[k],
  dots: sizeKeys.flatMap((s) => Array.from({ length: BY_SIZE[s][k] }, () => s)),
  mix: sizeKeys.filter((s) => BY_SIZE[s][k] > 0).map((s) => ({ size: s, n: BY_SIZE[s][k] })),
}))
const dotCount = bands.reduce((n, b) => n + b.dots.length, 0)
if (dotCount !== TOTAL_MEMBERS || bands.some((b) => b.dots.length !== b.total)) {
  console.warn(`[members] BY_SIZE adds up to ${dotCount}, the totals say ${TOTAL_MEMBERS}: check src/copy/members.ts`)
}
const CATEGORY_TITLE: Record<string, string> = { tannery: 'Tannery Members', footwear: 'Footwear Members', leather_goods: 'Leather Goods Members', associate: 'Associate Members' }
const pad = (n: number) => String(n).padStart(2, '0')
const arrow = 'M4 12h15m-6-6 6 6-6 6'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`
---

<Base
  title={MEMBERS_HEAD.title}
  description={`${MEMBERS_HEAD.subtitle} ${TOTAL_MEMBERS} member companies: ${SECTOR_TOTALS.tannery} tanneries, ${SECTOR_TOTALS.footwear} shoe manufacturers and ${SECTOR_TOTALS['leather-goods']} other leather product manufacturers.`}
>
  <PageHead
    index="01"
    eyebrow="Members"
    amharic="አባላት"
    title={['Members', '<em>directory</em>.']}
    lede={MEMBERS_HEAD.subtitle}
    image="/media/studio/goods-sectors.webp"
    imageAlt="A chestnut leather tote, a roll of tan leather and a pair of brown leather boots on a warm brown studio backdrop"
  >
    <p class="body ph-intro" data-reveal style="--d:.3s">{MEMBERS_HEAD.intro}</p>
    <div class="row mt-m" data-reveal style="--d:.36s">
      <a class="btn" href="/members/login" data-account><span data-account-label>Member Login</span> <Fragment set:html={svg(arrow)} /></a>
      <a class="btn btn--ghost" href="#apply">Become a Member</a>
    </div>
    <p class="ph-note" data-reveal style="--d:.42s">
      <b>Buyers and investors:</b> not a member? ELIA connects international buyers and investors with suitable manufacturers.
      Visit <a href="/invest">Investor and Buyer Information</a> or <a href="/contact?form=buyer#forms">send us an inquiry</a>.
    </p>
  </PageHead>

  <!-- 02 · our membership at a glance -->
  <section class="sec sec--paper sheet size" id="at-a-glance" aria-labelledby="size-h">
    <div class="wrap">
      <SectionHead index="02" eyebrow="Our membership at a glance" title={`${TOTAL_MEMBERS} companies, <em>three</em> sectors.`} intro={SIZE_NOTE} id="size-h" />

      <div class="ind">
        <div class="ind__top" aria-hidden="true" data-reveal="fade">
          <p class="ind__unit"><span class="sw sw--unit"></span>One dot, one member company</p>
          <ul class="key" role="list">
            {sizeKeys.map((s) => <li class={`key__i k--${s[0]}`}><span class={`sw sw--${s[0]}`}></span>{SIZE_LABEL[s]} <b>{SIZE_TOTALS[s]}</b></li>)}
          </ul>
        </div>
        <div class="ind__field" aria-hidden="true">
          {bands.map((b) => (
            <div class="band">
              <div class="band__head" data-reveal style="--d:.05s">
                <p class="band__n figure-num">{b.total}</p>
                <p class="band__name">{SECTORS[b.key].plural}<span class="band__am geez" lang="am">{SECTORS[b.key].amharic}</span></p>
                <p class="band__mix">
                  {b.mix.map((x, i) => <>{i > 0 && <span class="band__dot">·</span>}<span class={`mix mix--${x.size[0]}`}>{x.n} {x.size}</span></>)}
                </p>
              </div>
              <div class="band__dots" data-reveal="fade">
                {b.dots.map((s, j) => <i class={`d d--${s[0]}`} style={`--k:${j}`}></i>)}
              </div>
            </div>
          ))}
        </div>

        <div class="tbl">
          <p class="label tbl__label" data-reveal="fade">In figures</p>
          <div class="tbl__scroll" data-reveal>
            <table>
              <caption>Member companies by size and category</caption>
              <thead>
                <tr>
                  <th scope="col">Category</th>
                  {sectorKeys.map((k) => <th scope="col">{COLUMN[k]}</th>)}
                  <th scope="col">Total</th>
                </tr>
              </thead>
              <tbody>
                {sizeKeys.map((s) => (
                  <tr>
                    <th scope="row"><span class={`sw sw--${s[0]}`} aria-hidden="true"></span>{SIZE_LABEL[s]}</th>
                    {sectorKeys.map((k) => <td>{BY_SIZE[s][k]}</td>)}
                    <td>{SIZE_TOTALS[s]}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">Total</th>
                  {sectorKeys.map((k) => <td>{SECTOR_TOTALS[k]}</td>)}
                  <td>{TOTAL_MEMBERS}</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · member login -->
  <section class="sec sheet lit login" id="login" aria-labelledby="login-h">
    <div class="wrap login__in">
      <div>
        <p class="label label--rule" data-reveal="fade"><b>03</b> Member login</p>
        <h2 class="h2 mt-m" id="login-h" data-reveal>The directory is for <em>members</em>.</h2>
        <p class="body mt-m login__note" data-reveal style="--d:.08s">{LOGIN_NOTE}</p>
        <ul class="login__list" role="list" data-reveal style="--d:.12s">
          <li><b>Find a member</b> Search by company name, product or keyword; filter by category, size, region, export capability and certification.</li>
          <li><b>Member dashboard</b> Your profile, member notices, members-only documents, opportunities, and your membership status.</li>
        </ul>
      </div>
      <div class="login__card sec--paper" data-reveal style="--d:.1s">
        <Login client:only="preact" compact><p slot="fallback" class="loading">Loading…</p></Login>
      </div>
    </div>
  </section>

  <!-- 04 · membership benefits -->
  <section class="sec sec--paper sheet benefits" id="benefits" aria-labelledby="ben-h">
    <div class="wrap benefits__in">
      <div class="benefits__head">
        <p class="label label--rule" data-reveal="fade"><b>04</b> Membership benefits</p>
        <h2 class="h2 mt-m" id="ben-h" data-reveal>What membership <em>brings</em>.</h2>
        <p class="mt-l" data-reveal style="--d:.1s"><a class="btn btn--dark" href="#apply">Apply for Membership <Fragment set:html={svg(arrow)} /></a></p>
      </div>
      <ol class="blist" role="list">
        {BENEFITS.map((b, i) => (
          <li data-reveal style={`--d:${(i % 2) * 0.06}s`}>
            <span class="blist__n figure-num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="blist__t">{b.title}</h3>
            <p class="blist__p">{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 · membership categories -->
  <section class="sec sec--saddle grain cats-sec" aria-labelledby="cat-h">
    <div class="wrap">
      <SectionHead index="05" eyebrow="Membership categories" title="Four kinds of <em>member</em>." id="cat-h" />
      <ul class="mcats" role="list">
        {Object.keys(CATEGORIES).map((k, i) => (
          <li class="mcat card" data-reveal style={`--d:${i * 0.06}s`}>
            <span class="mcat__n figure-num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="mcat__t">{CATEGORY_TITLE[k]}</h3>
            <p class="mcat__p">{CATEGORY_NOTES[k as keyof typeof CATEGORY_NOTES]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 · apply for membership -->
  <section class="sec sec--paper sheet apply" id="apply" aria-labelledby="apply-h">
    <div class="wrap apply__in">
      <aside class="apply__side">
        <p class="label label--rule" data-reveal="fade"><b>06</b> Apply for membership</p>
        <h2 class="h2 mt-m" id="apply-h" data-reveal>Join <em>ELIA</em>.</h2>
        <p class="body mt-m apply__note" data-reveal style="--d:.08s">{JOIN.text}</p>
        <figure class="frame apply__pic" data-reveal="mask">
          <img src="/media/studio/member-card.webp" alt="An ELIA member’s card in dark brown leather, the association’s logo stamped in amber foil, on a chestnut leather card wallet" loading="lazy" decoding="async" {...responsive('/media/studio/member-card.webp', '(max-width: 960px) 92vw, 380px')} />
        </figure>
      </aside>
      <MembershipForm labelledby="apply-h" />
    </div>
  </section>
</Base>

<style>
  :global(.ph__media img) { object-position: 50% 62%; }
  .ph-intro { margin-top: 22px; max-width: 52ch; }
  .ph-note { margin-top: clamp(26px, 3vw, 36px); padding: 16px 18px; max-width: 60ch; border-radius: var(--radius-s); background: rgb(255 252 245 / 0.05); box-shadow: inset 0 0 0 1px var(--line-2); color: var(--bone); font-size: 15px; line-height: 1.55; }
  .ph-note b { color: var(--cream); }
  .ph-note a { color: var(--amber); font-weight: 600; text-decoration: underline; text-decoration-color: rgb(226 160 37 / 0.5); text-underline-offset: 3px; }

  /* 02 · at a glance: the three sizes as one hue, dark to light */
  .size { --s-l: var(--brand-brown); --s-m: var(--brand-taupe); --s-s: var(--brand-amber); }
  .sw { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex: none; background: var(--c); }
  .sw--l { --c: var(--s-l); } .sw--m { --c: var(--s-m); } .sw--s { --c: var(--s-s); }
  .ind { margin-top: clamp(48px, 6vw, 92px); }
  .ind__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 32px; padding-bottom: 18px; border-bottom: 1px solid var(--line-dark); }
  .ind__unit, .key__i { display: inline-flex; align-items: center; gap: 10px; font-weight: 560; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--taupe); }
  .sw--unit { width: 10px; height: 10px; background: none; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .key { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .key__i b { font-weight: 600; color: var(--ink); letter-spacing: 0.04em; }
  .band { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 18px clamp(24px, 3vw, 48px); padding: clamp(24px, 3vw, 36px) 0; border-bottom: 1px solid var(--line-dark); align-items: center; }
  .band__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 18px; align-items: start; }
  .band__n { font-size: clamp(2.6rem, 1.5rem + 2.6vw, 4.2rem); color: var(--ink); margin-top: -0.06em; grid-row: span 2; }
  .band__name { padding-top: 0.25em; font-family: var(--f-display); font-weight: 650; font-stretch: 88%; font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem); line-height: 1.15; color: var(--ink); text-wrap: balance; }
  .band__am { display: block; margin-top: 4px; font-size: 13px; color: var(--taupe); font-weight: 400; }
  .band__mix { margin-top: 6px; font-size: 13px; color: var(--taupe); }
  .band__dot { margin-inline: 0.5em; }
  .mix { white-space: nowrap; transition: color 0.25s; }
  .band__dots { display: grid; grid-template-columns: repeat(auto-fill, minmax(14px, 1fr)); gap: 3px; }
  .d { display: grid; place-items: center; aspect-ratio: 1; }
  .d::before { content: ''; width: 72%; height: 72%; border-radius: 50%; background: var(--c); transition: transform 0.25s var(--ease), opacity 0.25s; }
  .d--l { --c: var(--s-l); } .d--m { --c: var(--s-m); } .d--s { --c: var(--s-s); }
  .d:hover::before { transform: scale(1.35); }
  .ind:has(:is(.d--l, .k--l):hover) .d:not(.d--l)::before, .ind:has(:is(.d--m, .k--m):hover) .d:not(.d--m)::before, .ind:has(:is(.d--s, .k--s):hover) .d:not(.d--s)::before { opacity: 0.16; }
  .ind:has(:is(.d--l, .k--l):hover) .mix:not(.mix--l), .ind:has(:is(.d--m, .k--m):hover) .mix:not(.mix--m), .ind:has(:is(.d--s, .k--s):hover) .mix:not(.mix--s) { color: rgb(122 103 98 / 0.4); }
  .ind:has(:is(.d--l, .k--l):hover) .mix--l, .ind:has(:is(.d--m, .k--m):hover) .mix--m, .ind:has(:is(.d--s, .k--s):hover) .mix--s { color: var(--ink); }
  .tbl { margin-top: clamp(40px, 5vw, 72px); display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 18px clamp(24px, 3vw, 48px); }
  .tbl__label { align-self: start; padding-top: 14px; }
  .tbl__scroll { overflow-x: auto; }
  .tbl table { width: 100%; max-width: 860px; border-collapse: collapse; font-size: 15px; table-layout: fixed; }
  .tbl thead th:first-child { width: 22%; }
  .tbl thead th:nth-child(4) { width: 26%; }
  .tbl caption { caption-side: top; text-align: left; padding: 14px 0 16px; font-size: 14.5px; color: var(--ink); }
  .tbl th, .tbl td { padding: 13px 0 12px 14px; border-bottom: 1px solid var(--line-dark); text-align: right; vertical-align: baseline; }
  .tbl th:first-child { padding-left: 0; text-align: left; }
  .tbl thead th { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--taupe); }
  .tbl tbody th { font-weight: 500; color: var(--ink); }
  .tbl tbody th .sw { width: 9px; height: 9px; margin-right: 10px; vertical-align: 0.05em; }
  .tbl td { font-weight: 520; font-variant-numeric: tabular-nums; color: var(--ink); }
  .tbl td:last-child { font-weight: 650; }
  .tbl tfoot th, .tbl tfoot td { border-bottom: 0; border-top: 1.6px solid var(--ink); color: var(--ink); font-weight: 650; }

  /* 03 · login */
  .login__in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 40px clamp(32px, 5vw, 96px); align-items: center; }
  .login__note { max-width: 44ch; }
  .login__list { list-style: none; margin: clamp(28px, 3vw, 40px) 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); max-width: 560px; }
  .login__list li { padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--bone); font-size: 15.5px; line-height: 1.5; }
  .login__list b { display: block; color: var(--cream); font-weight: 650; margin-bottom: 4px; }
  .login__card { padding: clamp(24px, 3vw, 40px); border-radius: var(--radius); background: var(--paper); color: var(--ink); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8); }

  /* 04 · benefits */
  .benefits__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(28px, 5vw, 96px); align-items: start; }
  .benefits__head { position: sticky; top: 110px; }
  .blist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(20px, 3vw, 48px); }
  .blist li { display: grid; grid-template-columns: 3.2em minmax(0, 1fr); column-gap: 6px; row-gap: 8px; padding: 24px 0 26px; border-top: 1px solid var(--line-dark); }
  .blist__n { grid-row: span 2; font-size: 1.5rem; color: var(--taupe); }
  .blist__t { font-family: var(--f-display); font-weight: 650; font-stretch: 88%; font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.45rem); line-height: 1.12; letter-spacing: -0.02em; }
  .blist__p { color: var(--brown-80); font-size: 15.5px; line-height: 1.55; }

  /* 05 · categories */
  .mcats { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .mcat { display: grid; align-content: start; gap: 10px; padding: clamp(20px, 2.2vw, 30px); }
  .mcat__n { font-size: 15px; color: var(--amber); }
  .mcat__t { font-family: var(--f-display); font-weight: 650; font-stretch: 88%; font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.45rem); line-height: 1.12; letter-spacing: -0.02em; }
  .mcat__p { color: var(--bone); font-size: 15.5px; line-height: 1.55; }

  /* 06 · apply */
  .apply__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px clamp(32px, 5vw, 96px); align-items: start; }
  .apply__side { position: sticky; top: calc(var(--header-h) + 28px); }
  .apply__note { max-width: 36ch; }
  .apply__pic { margin: clamp(28px, 3vw, 40px) 0 0; aspect-ratio: 4 / 5; max-width: 380px; }

  @media (max-width: 1100px) { .mcats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 960px) {
    .login__in, .benefits__in, .apply__in { grid-template-columns: 1fr; }
    .benefits__head, .apply__side { position: static; }
    .apply__pic { display: none; }
  }
  @media (max-width: 760px) {
    .band, .tbl { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .blist, .mcats { grid-template-columns: 1fr; }
  }
</style>
