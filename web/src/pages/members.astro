---
import fs from 'node:fs'
import path from 'node:path'
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
import SectionHead from '../components/SectionHead.astro'
import { loadMembers } from '../data/load'
import {
  SECTORS,
  SIZE_NOTE,
  BY_SIZE,
  SECTOR_TOTALS,
  SIZE_TOTALS,
  TOTAL_MEMBERS,
  type SectorKey,
  type SizeKey,
} from '../copy/members'

const sectorKeys = Object.keys(SECTORS) as SectorKey[]
const sizeKeys: SizeKey[] = ['large', 'medium', 'small']
const SIZE_LABEL: Record<SizeKey, string> = { large: 'Large', medium: 'Medium', small: 'Small' }

/* The industry by size: one dot per member company, a band per sector, large to small inside each band. */
const bands = sectorKeys.map((k) => ({
  key: k,
  total: SECTOR_TOTALS[k],
  dots: sizeKeys.flatMap((s) => Array.from({ length: BY_SIZE[s][k] }, () => s)),
  mix: sizeKeys.filter((s) => BY_SIZE[s][k] > 0).map((s) => ({ size: s, n: BY_SIZE[s][k] })),
}))
const dotCount = bands.reduce((n, b) => n + b.dots.length, 0)
if (dotCount !== TOTAL_MEMBERS || bands.some((b) => b.dots.length !== b.total)) {
  console.warn(`[members] BY_SIZE adds up to ${dotCount}, the totals say ${TOTAL_MEMBERS}: check src/copy/members.ts`)
}

/* The directory. Phone numbers become tel: links only when they resolve to a clean international number;
   fax lines stay text. A logo is shown only if the file is really in public/. */
const publicDir = path.resolve(process.cwd(), 'public')
const telHref = (value: string) => {
  const v = value.trim()
  const digits = v.replace(/\D/g, '')
  if (v.startsWith('+251')) {
    const local = digits.slice(3).replace(/^0/, '')
    return local.length === 9 ? `tel:+251${local}` : undefined
  }
  return v.startsWith('+') && digits.length >= 8 && digits.length <= 15 ? `tel:+${digits}` : undefined
}
const nameKey = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9\u1200-\u137f]+/g, '')

const members = loadMembers().map((m) => {
  const sectors = (m.sectors ?? []).filter((s): s is SectorKey => s in SECTORS)
  const logo = m.logo && fs.existsSync(path.join(publicDir, m.logo.replace(/^\//, ''))) ? m.logo : undefined
  const phones = (m.phones ?? [])
    .filter((p) => p && p.value?.trim())
    .map((p) => ({ label: p.label || 'Tel', value: p.value.trim(), href: /fax/i.test(p.label) ? undefined : telHref(p.value) }))
  const emails = (m.emails ?? []).map((e) => e.trim()).filter(Boolean)
  const web = typeof m.website === 'string' ? m.website.trim() : ''
  const website = web
    ? {
        href: /^https?:\/\//i.test(web) ? web : `https://${web}`,
        text: web.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/$/, ''),
      }
    : undefined
  return { ...m, sectors, logo, phones, emails, website, initial: m.name.trim().charAt(0).toUpperCase() }
})
const listed = members.length

/* "Tanneries, shoe manufacturers and leather product manufacturers" */
const plurals = sectorKeys.map((k) => SECTORS[k].plural.toLowerCase())
const sentence = new Intl.ListFormat('en-GB', { style: 'long', type: 'conjunction' }).format(plurals)
const whoCanApply = sentence.charAt(0).toUpperCase() + sentence.slice(1)

const arrow = 'M4 12h15m-6-6 6 6-6 6'
const down = 'M12 4v15m-6-6 6 6 6-6'
const out = 'M7 17 17 7M9 7h8v8'
---

<Base
  title="Members"
  description={`${TOTAL_MEMBERS} member companies of the Ethiopian Leather Industries Association: ${SECTOR_TOTALS.tannery} tanneries, ${SECTOR_TOTALS.footwear} shoe manufacturers and ${SECTOR_TOTALS['leather-goods']} leather product manufacturers. The industry by size, and the member directory.`}
>
  <PageHead
    index="01"
    eyebrow="Members"
    amharic="አባላት"
    title={[`${TOTAL_MEMBERS} companies,`, 'one <em>voice</em>.']}
    lede={`${SECTOR_TOTALS.tannery} tanneries, ${SECTOR_TOTALS.footwear} shoe manufacturers and ${SECTOR_TOTALS['leather-goods']} leather product manufacturers: the member companies of the association, and how to reach them.`}
    image="/media/home/eldsc.webp"
    imageAlt="Leather hides dyed blue, brown, red, pink and yellow, hung side by side"
  >
    <div class="ph-cta" data-reveal style="--d:.35s">
      <a class="btn" href="#directory">Find a member <svg viewBox="0 0 24 24" aria-hidden="true"><path d={down} fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
      <a class="link" href="/membership">Apply for membership <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
    </div>
  </PageHead>

  <!-- 02 · the industry by size: 194 dots, one per company -->
  <section class="sec sec--paper size" id="by-size">
    <div class="wrap">
      <SectionHead index="02" eyebrow="By size" title="The industry <em>by size</em>." intro={SIZE_NOTE} />

      <div class="ind">
        <div class="ind__top" aria-hidden="true" data-reveal="fade">
          <p class="ind__unit"><span class="sw sw--unit"></span>One dot, one member company</p>
          <ul class="key" role="list">
            {sizeKeys.map((s) => (
              <li class={`key__i k--${s[0]}`}><span class={`sw sw--${s[0]}`}></span>{SIZE_LABEL[s]} <b>{SIZE_TOTALS[s]}</b></li>
            ))}
          </ul>
        </div>

        <div class="ind__field" aria-hidden="true">
          {bands.map((b) => (
            <div class="band">
              <div class="band__head" data-reveal style="--d:.05s">
                <p class="band__n figure-num">{b.total}</p>
                <p class="band__name">{SECTORS[b.key].plural}<span class="band__am geez" lang="am">{SECTORS[b.key].amharic}</span></p>
                <p class="band__mix">
                  {b.mix.map((x, i) => (
                    <>{i > 0 && <span class="band__dot">·</span>}<span class={`mix mix--${x.size[0]}`}>{x.n} {x.size}</span></>
                  ))}
                </p>
              </div>
              <div class="band__dots" data-reveal="fade">
                {b.dots.map((s, j) => <i class={`d d--${s[0]}`} style={`--k:${j}`}></i>)}
              </div>
            </div>
          ))}
        </div>

        <div class="tbl">
          <p class="label tbl__label" data-reveal="fade">In figures</p>
          <div class="tbl__scroll" data-reveal>
            <table>
              <caption>Ethiopian leather industry by size: member companies by sector</caption>
              <thead>
                <tr>
                  <th scope="col">Sector</th>
                  {sizeKeys.map((s) => <th scope="col"><span class={`sw sw--${s[0]}`} aria-hidden="true"></span>{SIZE_LABEL[s]}</th>)}
                  <th scope="col">Total</th>
                </tr>
              </thead>
              <tbody>
                {sectorKeys.map((k) => (
                  <tr>
                    <th scope="row">{SECTORS[k].plural}</th>
                    {sizeKeys.map((s) => <td>{BY_SIZE[s][k]}</td>)}
                    <td>{SECTOR_TOTALS[k]}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">All members</th>
                  {sizeKeys.map((s) => <td>{SIZE_TOTALS[s]}</td>)}
                  <td>{TOTAL_MEMBERS}</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · the directory -->
  <section class="sec grain dir" id="directory" aria-labelledby="dir-h" data-directory>
    <div class="wrap">
      <header class="dir__head">
        <p class="label label--rule" data-reveal="fade"><b>03</b> Directory <span class="geez" lang="am">አባላት</span></p>
        <h2 class="h2 dir__title" id="dir-h" data-reveal>Find a <em>member</em>.</h2>
        <p class="dir__note" data-reveal style="--d:.1s">
          <span class="stamp"><i></i>{listed} of {TOTAL_MEMBERS}</span>
          <span>The directory is being completed: {listed} of {TOTAL_MEMBERS} members listed so far.</span>
        </p>
      </header>

      <form class="dir__tools" role="search" aria-label="Members" data-reveal style="--d:.15s">
        <fieldset class="chips field dir__chips">
          <legend>Sector</legend>
          <label class="chip"><input type="radio" name="sector" value="" checked /><span>All</span></label>
          {sectorKeys.map((k) => (
            <label class="chip">
              <input type="radio" name="sector" value={k} data-total={SECTOR_TOTALS[k]} data-plural={SECTORS[k].plural.toLowerCase()} />
              <span>{SECTORS[k].plural}</span>
            </label>
          ))}
        </fieldset>
        <label class="field dir__search">
          <span>Search by name</span>
          <input type="search" name="q" autocomplete="off" spellcheck="false" maxlength="120" placeholder="Company name" />
        </label>
      </form>
      <p class="dir__status" role="status" data-dir-status></p>

      <ul class="dir__grid" role="list">
        {members.map((m, i) => (
          <li class="mc seam" data-member data-sectors={m.sectors.join(' ')} data-name={nameKey(m.name)} data-reveal style={`--d:${(i % 3) * 0.06}s`}>
            <article class="mc__in" aria-labelledby={`m-${m.slug}`}>
              <div class="mc__top">
                {m.logo ? (
                  <span class="mc__logo"><img src={m.logo} alt="" width="310" height="310" loading="lazy" decoding="async" /></span>
                ) : (
                  <span class="mc__mono" aria-hidden="true">{m.initial}</span>
                )}
                {m.ehlCertified && (
                  <a class="stamp mc__ehl" href="/ehl"><i></i>EHL certified<span class="sr-only"> (Ethiopian Highland Leather)</span></a>
                )}
              </div>
              <h3 class="mc__name" id={`m-${m.slug}`}>{m.name}</h3>
              <p class="mc__meta">
                {m.city && <span class="mc__city">{m.city}</span>}
                {m.sectors.map((s) => <span class="mc__tag">{SECTORS[s].label}</span>)}
              </p>
              {(m.phones.length > 0 || m.emails.length > 0 || m.website) && (
                <dl class="mc__lines">
                  {m.phones.map((p) => (
                    <div>
                      <dt>{p.label}</dt>
                      <dd>{p.href ? <a href={p.href}>{p.value}</a> : p.value}</dd>
                    </div>
                  ))}
                  {m.emails.map((e, j) => {
                    const at = e.lastIndexOf('@')
                    return (
                      <div>
                        <dt>{j === 0 ? 'E-mail' : <span class="sr-only">E-mail</span>}</dt>
                        <dd><a href={`mailto:${e}`}>{at > 0 ? <>{e.slice(0, at)}<wbr />{e.slice(at)}</> : e}</a></dd>
                      </div>
                    )
                  })}
                  {m.website && (
                    <div>
                      <dt>Web</dt>
                      <dd>
                        <a href={m.website.href} target="_blank" rel="noopener">
                          {m.website.text}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={out} fill="none" stroke="currentColor" stroke-width="1.8" /></svg><span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      </dd>
                    </div>
                  )}
                </dl>
              )}
            </article>
          </li>
        ))}
      </ul>

      <div class="dir__empty seam" data-dir-empty hidden>
        <p class="dir__empty-t">No members match.</p>
        <p class="dir__empty-s">Try another name, or look in every sector.</p>
        <button class="btn btn--ghost" type="button" data-dir-reset>Show all members</button>
      </div>
    </div>
  </section>

  <!-- 04 · join -->
  <section class="sec sec--paper sec--tight join" aria-labelledby="join-h">
    <div class="wrap join__in">
      <div class="join__text">
        <p class="label label--rule" data-reveal="fade"><b>04</b> Membership <span class="geez" lang="am">አባልነት</span></p>
        <h2 class="h2 join__title" id="join-h" data-reveal>Become a member<em>.</em></h2>
        <p class="body join__body" data-reveal style="--d:.08s">{whoCanApply} can apply to join the association online.</p>
      </div>
      <div class="join__cta" data-reveal style="--d:.12s">
        <a class="btn btn--dark" href="/membership">Apply for membership <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
        <a class="link" href="/contact">Contact the secretariat <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/members-directory'
</script>

<style>
  /* the hides photo has a flat brown band along its foot; keep it out of the frame */
  :global(.ph__media img) { transform: scale(1.18); transform-origin: 50% 0; }
  .ph-cta { margin-top: clamp(28px, 3.4vw, 44px); display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }

  /* 02 · the industry by size. The three sizes are an ordered scale, so one hue from light to dark:
     small #c8955f, medium cognac, large saddle (checked: monotone, 2.2:1 for the light end on paper). */
  .size { --s-l: var(--saddle); --s-m: var(--cognac); --s-s: #c8955f; }
  .sw { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex: none; background: var(--c); }
  .sw--l { --c: var(--s-l); } .sw--m { --c: var(--s-m); } .sw--s { --c: var(--s-s); }

  .ind { margin-top: clamp(48px, 6vw, 92px); }
  .ind__top {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 32px;
    padding-bottom: 18px; border-bottom: 1px solid var(--line-dark);
  }
  .ind__unit, .key__i {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #6f5a4b;
  }
  .sw--unit { width: 10px; height: 10px; background: none; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .key { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .key__i { cursor: default; }
  .key__i b { font-weight: 500; color: var(--ink); letter-spacing: 0.04em; }

  .band {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 18px clamp(24px, 3vw, 48px); align-items: start;
    padding-block: clamp(24px, 2.8vw, 40px); border-bottom: 1px solid var(--line-dark);
  }
  .band__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 18px; align-items: start; }
  .band__n { font-size: clamp(2.6rem, 1.5rem + 2.6vw, 4.2rem); color: var(--ink); margin-top: -0.06em; }
  .band__name { padding-top: 0.25em; font-family: var(--f-display); font-size: var(--step-1); line-height: 1.15; color: var(--ink); text-wrap: balance; }
  .band__am { display: block; margin-top: 4px; font-size: 13px; color: #6f5a4b; }
  .band__mix {
    grid-column: 1 / -1; margin-top: 12px;
    font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #6f5a4b;
  }
  .band__dot { margin-inline: 0.5em; }
  .mix { white-space: nowrap; transition: color 0.25s; }

  /* the field: a fixed number of dots per row, so the bands compare like bars */
  .band__dots {
    --cols: 50; --cell: 24px;
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); max-width: calc(var(--cols) * var(--cell));
    padding-top: 0.55em;
  }
  .d { display: grid; place-items: center; aspect-ratio: 1; }
  .d::before {
    content: ''; width: 64%; aspect-ratio: 1; border-radius: 50%; background: var(--c);
    transition: scale 0.6s var(--ease) calc(var(--k) * 9ms), transform 0.25s var(--ease), opacity 0.25s;
  }
  .d--l { --c: var(--s-l); } .d--m { --c: var(--s-m); } .d--s { --c: var(--s-s); }
  .d:hover::before { transform: scale(1.35); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .band__dots:not(.in) .d::before { scale: 0; }
  }
  /* point at a dot or a key: that size stands out across the three sectors */
  .ind:has(:is(.d--l, .k--l):hover) .d:not(.d--l)::before,
  .ind:has(:is(.d--m, .k--m):hover) .d:not(.d--m)::before,
  .ind:has(:is(.d--s, .k--s):hover) .d:not(.d--s)::before { opacity: 0.16; }
  .ind:has(:is(.d--l, .k--l):hover) .mix:not(.mix--l),
  .ind:has(:is(.d--m, .k--m):hover) .mix:not(.mix--m),
  .ind:has(:is(.d--s, .k--s):hover) .mix:not(.mix--s) { color: rgb(111 90 75 / 0.4); }
  .ind:has(:is(.d--l, .k--l):hover) .mix--l,
  .ind:has(:is(.d--m, .k--m):hover) .mix--m,
  .ind:has(:is(.d--s, .k--s):hover) .mix--s { color: var(--ink); }

  /* the same figures as a table */
  .tbl { margin-top: clamp(40px, 5vw, 72px); display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 18px clamp(24px, 3vw, 48px); }
  .tbl__label { align-self: start; padding-top: 14px; }
  .tbl__scroll { overflow-x: auto; }
  .tbl table { width: 100%; max-width: 860px; border-collapse: collapse; font-size: 15px; }
  .tbl caption { caption-side: top; text-align: left; padding: 14px 0 16px; font-size: 14.5px; color: #3d2e24; }
  .tbl th, .tbl td { padding: 13px 0 12px 14px; border-bottom: 1px solid var(--line-dark); text-align: right; vertical-align: baseline; }
  .tbl th:first-child { padding-left: 0; text-align: left; }
  .tbl thead th {
    font-family: var(--f-mono); font-size: 10px; font-weight: 450; letter-spacing: 0.14em; text-transform: uppercase; color: #6f5a4b;
    white-space: nowrap; border-bottom-color: rgb(36 25 18 / 0.3);
  }
  .tbl thead .sw { width: 9px; height: 9px; margin-right: 8px; vertical-align: 0.05em; }
  .tbl tbody th { font-weight: 500; color: var(--ink); }
  .tbl td { font-family: var(--f-mono); font-variant-numeric: tabular-nums; font-size: 14px; color: #3d2e24; }
  .tbl td:last-child { color: var(--ink); font-weight: 500; }
  .tbl tfoot th, .tbl tfoot td { border-bottom: 0; border-top: 1.6px solid var(--ink); color: var(--ink); font-weight: 600; }

  /* 03 · the directory */
  .dir { background: var(--ink); }
  .dir__head { display: grid; gap: 22px; }
  .dir__title { max-width: 16ch; }
  .dir__note { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; font-size: 15px; color: var(--muted); }
  .dir__note .stamp { flex: none; }

  .dir__tools { display: none; }
  :global(.js) .dir__tools {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 340px); gap: 22px clamp(24px, 3vw, 48px); align-items: end;
    margin-top: clamp(40px, 5vw, 72px); padding-top: clamp(26px, 3vw, 36px); border-top: 1px solid var(--line);
  }
  .dir__chips legend { margin-bottom: 12px; }
  .dir__search input { min-height: 46px; padding-block: 10px; }
  .dir__search input::-webkit-search-cancel-button { filter: invert(0.8) sepia(0.4); cursor: pointer; }
  .dir__status { min-height: 1.6em; margin-top: 18px; font-size: 14.5px; color: var(--muted); }

  .dir__grid {
    --gap: clamp(12px, 1.4vw, 20px);
    list-style: none; margin: 10px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: var(--gap);
  }
  .mc {
    display: flex; border-radius: 8px;
    background: linear-gradient(165deg, #2a1c14 0%, #1d1510 60%, #181009 100%);
    box-shadow: inset 0 1px 0 rgb(255 236 210 / 0.06), 0 24px 50px -36px rgb(0 0 0 / 0.9);
  }
  .mc[hidden], .dir__empty[hidden] { display: none; }
  .mc__in { flex: 1; display: flex; flex-direction: column; padding: clamp(24px, 2.2vw, 32px); min-width: 0; }
  .mc__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding-bottom: 22px; }
  .mc__meta { padding-top: 12px; }
  /* side by side, a card's logo, name, sectors and contacts line up with its neighbours' */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 521px) {
      .dir__grid { row-gap: 0; }
      .mc { display: grid; grid-row: span 4; grid-template-rows: subgrid; margin-bottom: var(--gap); }
      .mc__in { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; row-gap: 0; align-items: start; }
    }
  }
  .mc__logo, .mc__mono { width: 64px; height: 64px; border-radius: 6px; flex: none; overflow: hidden; }
  .mc__logo { background: #fff; box-shadow: 0 0 0 1px rgb(255 240 220 / 0.12), 0 14px 26px -18px rgb(0 0 0 / 0.9); }
  .mc__logo img { width: 100%; height: 100%; object-fit: contain; }
  .mc__mono {
    display: grid; place-items: center; font-family: var(--f-display); font-style: italic; font-size: 2.1rem; line-height: 1; color: var(--amber);
    background: rgb(10 7 5 / 0.55);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.85), inset 0 -1px 0 rgb(255 222 175 / 0.07), 0 1px 0 rgb(255 222 175 / 0.07);
  }
  .mc__ehl { transition: color 0.25s; }
  .mc__ehl:hover { color: var(--amber); }
  .mc__name { font-family: var(--f-display); font-weight: 400; font-size: var(--step-1); line-height: 1.15; color: var(--cream); text-wrap: balance; }
  .mc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .mc__city { font-size: 14px; color: var(--bone); margin-right: 4px; }
  .mc__tag {
    font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
    padding: 6px 10px 5px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(255 240 220 / 0.18);
  }
  .mc__lines {
    margin: 20px 0 0; padding-top: 18px; border-top: 1px dashed rgb(226 160 37 / 0.3);
    display: grid; gap: 6px; font-size: 14px; line-height: 1.45;
  }
  .mc__lines div { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 10px; align-items: baseline; }
