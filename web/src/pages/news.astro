---
import Base from '../layouts/Base.astro'
import Cover from '../components/Cover.astro'
import { posts, postCount, events, publications, html } from '../data/cms'
import { POST_CATEGORIES, PUBLICATION_TYPES } from '../../../shared/options'

/* The page as built shows the content the database starts with; on every visit the server puts the current posts,
   events and publications between the <template data-cms> marks (server/src/pages.ts), and sets data-tab to the tab
   asked for (?tab=news), which shows that tab's sections only. */
const PER = 9
const latest = posts({ limit: PER })
const more = postCount() > PER
const evs = events()
const pubs = publications()
const years = [...new Set(pubs.map((p) => p.year).filter(Boolean))].sort((a, b) => Number(b) - Number(a))
const featured = posts({ featured: true, limit: 2 })

const TABS = [
  { k: 'all', label: 'All', href: '/news' },
  { k: 'news', label: 'News', href: '/news?tab=news#news' },
  { k: 'events', label: 'Events', href: '/news?tab=events#events' },
  { k: 'publications', label: 'Publications', href: '/news?tab=publications#publications' },
  { k: 'spotlights', label: 'Member Spotlights', href: '/news?tab=spotlights#news' },
]
const arrow = 'M4 12h15m-6-6 6 6-6 6'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`
const pagerBuilt = more ? `<nav class="pager" aria-label="More posts"><span></span><span class="label">Page 1</span><a class="link" href="/news?tab=news&page=2#news">Older posts</a></nav>` : ''
---

<Base newsletter={false} title="News, Events and Publications" description="Updates from ELIA and Ethiopia’s leather industry: news, the events calendar, and ELIA’s reports and downloads.">
  <div class="ntabs-page" data-tab="all">
  <Cover
    n="09" kicker="News · Events · Publications" amharic="ዜና"
    title={['News, events', 'and <em>publications</em>.']}
    lede="Updates from ELIA and Ethiopia’s leather industry."
    bg="var(--brand-page)" numeral="ELIA"
  >
    <nav class="ntabs" aria-label="News, events and publications" data-reveal style="--d:.32s">
      {TABS.map((t) => <a class="ntab" href={t.href} data-k={t.k}>{t.label}</a>)}
    </nav>
    <p class="unsub" role="status" data-unsub hidden>You are unsubscribed from ELIA’s updates. You can subscribe again at any time below.</p>
  </Cover>

    <!-- 02 · news -->
    <section class="sec sec--paper sec--sand sheet nsec" id="news" data-in="all news spotlights" aria-labelledby="news-h">
      <div class="wrap">
        <div class="nsec__head">
          <p class="label label--rule" data-reveal="fade"><b>02</b> News</p>
          <h2 class="h2 mt-m" id="news-h" data-reveal>
            <span class="not-spot">Latest <em>news</em>.</span><span class="only-spot">Member <em>spotlights</em>.</span>
          </h2>
        </div>
        <ul class="cats not-spot" role="list" aria-label="Categories">
          <li><a class="cat" href="/news?tab=news#news" data-cat="">All categories</a></li>
          {Object.entries(POST_CATEGORIES).map(([k, v]) => <li><a class="cat" href={k === 'member-spotlights' ? '/news?tab=spotlights#news' : `/news?tab=news&cat=${k}#news`} data-cat={k}>{v}</a></li>)}
        </ul>
        <div class="news-grid">
          <template data-cms="news"></template><Fragment set:html={html.posts(latest)} /><template data-cms-end="news"></template>
        </div>
        <template data-cms="news-pager"></template><Fragment set:html={pagerBuilt} /><template data-cms-end="news-pager"></template>
        <p class="mt-l only-all"><a class="link nsec__all" href="/news?tab=news#news">View all news <Fragment set:html={svg(arrow)} /></a></p>
      </div>
    </section>

    <!-- 03 · events -->
    <section class="sec sec--brown sheet lit nsec" id="events" data-in="all events" aria-labelledby="events-h">
      <div class="wrap nsec__split">
        <div class="nsec__head">
          <p class="label label--rule" data-reveal="fade"><b>03</b> Events calendar</p>
          <h2 class="h2 mt-m" id="events-h" data-reveal>Upcoming <em>events</em>.</h2>
          <p class="body mt-m nsec__note" data-reveal style="--d:.08s">Each event has its own page: the details, the venue on a map, registration, and a file to add it to your calendar.</p>
        </div>
        <ol class="ev-list" role="list">
          <template data-cms="events"></template><Fragment set:html={evs.length ? html.events(evs) : '<li class="empty">No events are announced at the moment.</li>'} /><template data-cms-end="events"></template>
        </ol>
      </div>
    </section>

    <!-- 04 · publications -->
    <section class="sec sec--paper sheet nsec" id="publications" data-in="all publications" aria-labelledby="pubs-h">
      <div class="wrap">
        <div class="nsec__head nsec__head--row">
          <div>
            <p class="label label--rule" data-reveal="fade"><b>04</b> Publications library</p>
            <h2 class="h2 mt-m" id="pubs-h" data-reveal>Reports and <em>downloads</em>.</h2>
          </div>
          <p class="body nsec__note" data-reveal style="--d:.08s">Download ELIA publications and industry resources. Some documents are available to members only.</p>
        </div>
        <form class="pubf" data-pubf aria-label="Filter the publications">
          <label class="field">
            <span>Year</span>
            <select name="year">
              <template data-cms="pub-years"></template><option value="">All years</option>{years.map((y) => <option>{y}</option>)}<template data-cms-end="pub-years"></template>
            </select>
          </label>
          <label class="field">
            <span>Type</span>
            <select name="type"><option value="">All types</option>{PUBLICATION_TYPES.map((t) => <option>{t}</option>)}</select>
          </label>
          <label class="field">
            <span>Access</span>
            <select name="access"><option value="">Public and members only</option><option value="public">Public</option><option value="members">Members only</option></select>
          </label>
          <p class="pubf__count small" aria-live="polite" data-pubf-count></p>
        </form>
        <ul class="pub-list" role="list" data-pubs>
          <template data-cms="pubs"></template><Fragment set:html={pubs.length ? html.pubs(pubs) : '<li class="empty">No publications yet.</li>'} /><template data-cms-end="pubs"></template>
        </ul>
        <p class="empty pubf__none" data-pubf-none hidden>No documents match. <button type="button" class="pubf__reset" data-pubf-reset>Show them all</button></p>
      </div>
    </section>

    <!-- 05 · featured articles -->
    <section class="sec sec--paper sec--mist sheet nsec" id="featured" data-in="all" aria-labelledby="feat-h">
      <div class="wrap">
        <div class="nsec__head">
          <p class="label label--rule" data-reveal="fade"><b>05</b> Featured articles</p>
          <h2 class="h2 mt-m" id="feat-h" data-reveal>Worth <em>reading</em>.</h2>
        </div>
        <div class="news-grid news-grid--two">
          <template data-cms="featured"></template><Fragment set:html={html.posts(featured)} /><template data-cms-end="featured"></template>
        </div>
      </div>
    </section>
  </div>

  <!-- 06 · newsletter -->
  <section class="sec sec--saddle grain sheet stay" aria-labelledby="stay-h">
    <div class="wrap stay__in">
      <div>
        <p class="label label--rule" data-reveal="fade"><b>06</b> Newsletter</p>
        <h2 class="h2 mt-m" id="stay-h" data-reveal>Stay <em>informed</em>.</h2>
        <p class="body mt-m" data-reveal style="--d:.08s">Subscribe to receive ELIA news, event announcements and industry updates by email.</p>
      </div>
      <form class="stay__form" action="/api/forms/subscribe" method="post" data-form="subscribe"
        data-ok="Thank you. You are subscribed; a confirmation is on its way to your inbox." aria-labelledby="stay-h" novalidate data-reveal>
        <label class="field stay__field"><span class="sr-only">E-mail address</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" placeholder="Your e-mail address" /></label>
        <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn" type="submit">Subscribe <Fragment set:html={svg(arrow)} /></button>
        <p class="form__msg stay__msg" role="status" aria-live="polite" data-form-msg></p>
      </form>
    </div>
  </section>
</Base>

<script>
  /* the tab and category shown (the server shows the right content; this marks the links for screen readers), the
     unsubscribed note, and the publications' filters */
  const q = new URLSearchParams(location.search)
  const page = document.querySelector<HTMLElement>('[data-tab]')
  const tab = page?.dataset.tab ?? 'all'
  document.querySelectorAll<HTMLAnchorElement>('.ntab').forEach((a) => { if (a.dataset.k === tab) a.setAttribute('aria-current', 'page') })
  const cat = q.get('cat') ?? ''
  if (tab === 'news') document.querySelectorAll<HTMLAnchorElement>('.cat').forEach((a) => { if (a.dataset.cat === cat) a.setAttribute('aria-current', 'true') })
  if (q.get('unsubscribed') === '1') document.querySelector<HTMLElement>('[data-unsub]')?.removeAttribute('hidden')

  const form = document.querySelector<HTMLFormElement>('[data-pubf]')
  const list = document.querySelector<HTMLElement>('[data-pubs]')
  if (form && list) {
    const count = form.querySelector<HTMLElement>('[data-pubf-count]')
    const none = document.querySelector<HTMLElement>('[data-pubf-none]')
    const apply = () => {
      const f = new FormData(form)
      const want = { year: String(f.get('year') ?? ''), type: String(f.get('type') ?? ''), access: String(f.get('access') ?? '') }
      const rows = [...list.querySelectorAll<HTMLElement>('.pub')]
      let shown = 0
      for (const r of rows) {
        const ok = (!want.year || r.dataset.year === want.year) && (!want.type || r.dataset.type === want.type) && (!want.access || r.dataset.access === want.access)
        r.hidden = !ok
        if (ok) shown++
      }
      const filtered = !!(want.year || want.type || want.access)
      if (count) count.textContent = filtered ? `${shown} of ${rows.length} documents` : `${rows.length} documents`
      if (none) none.hidden = shown > 0
    }
    form.addEventListener('change', apply)
    form.addEventListener('submit', (e) => e.preventDefault())
    document.querySelector('[data-pubf-reset]')?.addEventListener('click', () => { form.reset(); apply() })
    apply()
  }
</script>

<style>
  /* on the wide crop of small screens keep the keeper and its ring in the frame */
  .unsub { margin-top: 28px; padding: 14px 18px; border-radius: var(--radius-s); background: rgb(226 160 37 / 0.12); box-shadow: inset 0 0 0 1px rgb(226 160 37 / 0.4); color: var(--cream); max-width: 52ch; }
  .unsub[hidden] { display: none; }

  /* the tabs, under the page's title */
  .ntabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(28px, 3.4vw, 44px); }
  .ntab { flex: none; display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: 999px; font-size: 14.5px; font-weight: 560; color: var(--bone); box-shadow: inset 0 0 0 1px var(--line-2); transition: background 0.25s, color 0.25s; }
  .ntab:hover { color: var(--cream); background: rgb(255 252 245 / 0.06); }
  [data-tab='all'] .ntab[data-k='all'], [data-tab='news'] .ntab[data-k='news'], [data-tab='events'] .ntab[data-k='events'],
  [data-tab='publications'] .ntab[data-k='publications'], [data-tab='spotlights'] .ntab[data-k='spotlights'] { background: #3c1e16; color: #fffcf5; box-shadow: none; }

  /* a tab shows its own sections only */
  [data-tab='news'] .nsec:not([data-in~='news']), [data-tab='events'] .nsec:not([data-in~='events']),
  [data-tab='publications'] .nsec:not([data-in~='publications']), [data-tab='spotlights'] .nsec:not([data-in~='spotlights']) { display: none; }
  .only-spot { display: none; }
  [data-tab='spotlights'] .only-spot { display: inline; }
  [data-tab='spotlights'] .not-spot { display: none; }
  .ntabs-page:not([data-tab='all']) .only-all { display: none; }
  .nsec { scroll-margin-top: 40px; }

  .nsec__head { margin-bottom: clamp(32px, 4vw, 56px); }
  .nsec__head--row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 20px 40px; align-items: end; }
  .nsec__note { max-width: 44ch; }
  .nsec__split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px clamp(32px, 5vw, 96px); align-items: start; }
  .nsec__split .nsec__head { position: sticky; top: 110px; margin: 0; }

  .cats { list-style: none; margin: -12px 0 clamp(28px, 3vw, 40px); padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cat { display: inline-flex; align-items: center; min-height: 38px; padding: 0 14px; border-radius: 999px; font-size: 13.5px; font-weight: 560; color: var(--bone); box-shadow: inset 0 0 0 1px var(--line-2); transition: background 0.25s, color 0.25s; }
  .cat:hover { color: var(--cream); background: rgb(255 252 245 / 0.06); }
  .cat[aria-current] { background: var(--cream); color: var(--ink); box-shadow: none; }
  /* on the light news sheet */
  .sec--paper .cat { color: var(--ink); box-shadow: inset 0 0 0 1px rgb(60 30 22 / 0.2); }
  .sec--paper .cat:hover { color: var(--ink); background: rgb(60 30 22 / 0.06); }
  .sec--paper .cat[aria-current] { background: var(--ink); color: var(--cream); box-shadow: none; }
  .nsec__all { color: var(--amber); }
  .news-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .pubf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 14px 18px; align-items: end; margin-bottom: 26px; }
  .pubf__count { color: var(--taupe); padding-bottom: 14px; white-space: nowrap; }
  .pubf__none { padding: 22px 0; }
  .pubf__none[hidden] { display: none; }
  .pubf__reset { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  .stay__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px clamp(32px, 5vw, 96px); align-items: center; }
  .stay__form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; }
  .stay__msg { grid-column: 1 / -1; }

  @media (max-width: 960px) {
    .nsec__split, .stay__in, .nsec__head--row { grid-template-columns: 1fr; }
    .nsec__split .nsec__head { position: static; }
  }
  @media (max-width: 760px) {
    .pubf { grid-template-columns: 1fr 1fr; }
    .pubf__count { grid-column: 1 / -1; padding: 0; }
    .news-grid--two { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .pubf { grid-template-columns: 1fr; }
    .stay__form { grid-template-columns: 1fr; }
  }
</style>
