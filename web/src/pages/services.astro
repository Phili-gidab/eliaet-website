---
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
import Appointment from '../components/Appointment.astro'
import { SERVICES_INTRO, SERVICES } from '../copy/services'

const pad = (n: number) => String(n).padStart(2, '0')
---

<Base title="Services" description={SERVICES_INTRO.text}>
  <PageHead
    index="01"
    eyebrow={SERVICES_INTRO.eyebrow}
    amharic="አገልግሎቶች"
    title={['What the association', 'does for its', 'members<em>.</em>']}
    lede={SERVICES_INTRO.text}
    image="/media/samra-leather.webp"
    imageAlt="A woman carrying a black leather handbag"
  />

  <!-- 02 · the service areas: number, area, what it covers -->
  <section class="sec sec--paper svc" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="svc__head">
        <h2 class="label label--rule" id="svc-h" data-reveal="fade"><b>02</b> Service areas</h2>
        <ol class="svc__index" role="list" aria-label="Jump to a service area">
          {SERVICES.map((s, i) => (
            <li><a href={`#service-${i + 1}`}><span>{pad(i + 1)}</span>{s.title}</a></li>
          ))}
        </ol>
      </div>
      <div class="stitch svc__stitch" aria-hidden="true"></div>
      <ol class="svc__list" role="list">
        {SERVICES.map((s, i) => (
          <li class="svc__row" id={`service-${i + 1}`}>
            <p class="svc__n figure-num" aria-hidden="true" data-reveal="fade">{pad(i + 1)}</p>
            <h3 class="svc__title" data-reveal>{s.title.replace(' & ', '\u00a0& ')}</h3>
            <ul class="svc__points" role="list" data-reveal style="--d:.08s">
              {s.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </li>
        ))}
      </ol>
      <div class="stitch svc__stitch svc__stitch--end" aria-hidden="true"></div>
    </div>
  </section>

  <!-- a pause between the two paper sections: the material itself -->
  <div class="plate grain">
    <div class="wrap">
      <div class="plate__img frame duo" data-reveal="fade">
        <img src="/media/carousel-5.webp" alt="" loading="lazy" decoding="async" width="1920" height="1080" />
      </div>
    </div>
  </div>

  <Appointment index="03" />
</Base>

<style>
  /* the photo is tall; on the wide crop of small screens keep the bag in view */
  @media (max-width: 900px) { :global(.ph__media img) { object-position: 50% 62%; } }

  /* 02 · service areas */
  .svc__head { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px clamp(24px, 3vw, 48px); align-items: start; }
  .svc__index {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 32px;
    font-size: 15px; line-height: 1.4;
  }
  .svc__index a { display: flex; gap: 12px; align-items: baseline; padding: 7px 0; border-bottom: 1px solid var(--line-dark); color: #3d2e24; transition: color 0.25s, padding 0.4s var(--ease); }
  .svc__index a span { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--cognac); }
  .svc__index a:hover { color: var(--ink); padding-left: 6px; }
  .svc__stitch { margin-top: clamp(40px, 5vw, 72px); }
  .svc__stitch--end { margin-top: 0; }

  .svc__list { list-style: none; margin: 0; padding: 0; }
  .svc__row {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) minmax(0, 6fr); gap: 18px clamp(20px, 2.4vw, 40px);
    padding-block: clamp(34px, 4.4vw, 68px); align-items: start;
  }
  .svc__row + .svc__row { border-top: 1px solid var(--line-dark); }
  .svc__n { font-size: clamp(2.6rem, 1.4rem + 3.4vw, 5rem); color: var(--cognac); margin-top: -0.04em; }
  .svc__title {
    font-family: var(--f-display); font-weight: 400; font-size: var(--step-3); line-height: 1.02; letter-spacing: -0.016em;
    color: var(--ink); text-wrap: balance; max-width: 13ch;
  }
  .svc__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .svc__points li { position: relative; padding-left: 34px; color: #3d2e24; max-width: 58ch; text-wrap: pretty; }
  /* each point hangs from a short saddle stitch */
  .svc__points li::before {
    content: ''; position: absolute; left: 0; top: 0.8em; width: 20px; height: 1.6px;
    background: linear-gradient(90deg, var(--cognac) 0 7px, transparent 7px 13px, var(--cognac) 13px 20px);
  }

  /* the plate between the list and the appointment form */
  .plate { background: var(--ink); padding-block: clamp(36px, 5vw, 80px); }
  .plate__img { aspect-ratio: 21 / 8; }
  .plate__img img { object-position: 50% 50%; }

  @media (max-width: 1100px) {
    .svc__row { grid-template-columns: minmax(0, 1.4fr) minmax(0, 4fr) minmax(0, 6fr); }
    .svc__title { font-size: var(--step-2); }
  }
  @media (max-width: 900px) {
    .svc__head { grid-template-columns: 1fr; }
    .svc__index { display: none; }
    .svc__row { grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; }
    .svc__title { max-width: none; align-self: end; }
    .svc__points { grid-column: 1 / -1; }
    .plate__img { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 520px) {
    .svc__row { grid-template-columns: 1fr; row-gap: 10px; }
    .svc__n { font-size: 2.4rem; }
    .svc__points { margin-top: 8px; }
    .svc__points li { padding-left: 28px; }
  }
</style>
