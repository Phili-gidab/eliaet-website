---
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
import MembershipForm from '../components/MembershipForm.astro'
import { ORG, CONTACT, SOCIAL } from '../copy/site'
import { INQUIRIES, TEAMS, INTERESTS } from '../../../shared/options'
import { BUYERS } from '../copy/invest'

const coord = `${CONTACT.map.lat.toFixed(4)}° N · ${CONTACT.map.lng.toFixed(4)}° E`
const arrow = 'M4 12h15m-6-6 6 6-6 6'
const out = 'M7 17 17 7M9 7h8v8'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`

/* the content document's confirmation message (the server e-mails it too, with the reference) */
const ACK = 'Thank you for contacting the Ethiopian Leather Industries Association. We have received your message and will reply within three working days.'

/* the forms, in the content document's order; each says which Secretariat team answers it */
const FORMS = [
  { key: 'general', title: 'General Inquiry', tab: 'General inquiry', team: TEAMS[INQUIRIES.general.team] },
  { key: 'membership', title: 'Membership Application', tab: 'Membership application', team: TEAMS.members },
  { key: 'buyer', title: 'Buyer Inquiry', tab: 'Buyer inquiry', team: TEAMS[INQUIRIES.buyer.team] },
  { key: 'investor', title: 'Investor Inquiry', tab: 'Investor inquiry', team: TEAMS[INQUIRIES.investor.team] },
  { key: 'aalf', title: 'AALF Exhibitor and Sponsor Inquiry', tab: 'AALF exhibitor and sponsor', team: TEAMS[INQUIRIES.aalf.team] },
  { key: 'media', title: 'Media Inquiry', tab: 'Media inquiry', team: TEAMS[INQUIRIES.media.team] },
] as const
const PRODUCTS = [...BUYERS.products.map((p) => p.category), 'Other']
const AREAS = ['Tanning and finishing', 'Footwear manufacturing', 'Leather goods manufacturing', 'Joint venture with an Ethiopian manufacturer', 'Effluent treatment, chemicals or machinery', 'Gelatin and other by-products', 'Other']
const social = SOCIAL.filter((s) => s.href)
const today = new Date().toISOString().slice(0, 10)
---

<Base
  newsletter={false}
  title="Contact Us"
  description={`Contact the ${ORG.name}: ${CONTACT.address.full}. Phone ${CONTACT.phones.map((p) => p.value).join(' / ')}, e-mail ${CONTACT.emails[0].value}.`}
>
  <PageHead
    index="01"
    eyebrow="Contact"
    amharic="አድራሻ"
    title={['Contact', '<em>us</em>.']}
    lede="We welcome inquiries from members, buyers, investors, partners and the media."
  >
    <address class="ledger" data-reveal style="--d:.35s">
      <div class="ledger__col">
        <p class="label"><b>Visit</b></p>
        <p class="ledger__addr">{CONTACT.address.lines.map((l, i) => <Fragment><span>{l}</span>{i < CONTACT.address.lines.length - 1 && ' '}</Fragment>)}</p>
        <dl class="ledger__dl">
          <div><dt>P.O. Box</dt><dd>{CONTACT.poBox}, Addis Ababa</dd></div>
          <div><dt>Office hours</dt><dd>{CONTACT.hours}</dd></div>
        </dl>
      </div>
      <div class="ledger__col">
        <p class="label"><b>Call</b></p>
        <dl class="ledger__dl">
          {CONTACT.phones.map((p) => (
            <div><dt>{p.label}</dt><dd><a href={p.href}>{p.value}</a></dd></div>
          ))}
        </dl>
      </div>
      <div class="ledger__col">
        <p class="label"><b>Write</b></p>
        <dl class="ledger__dl ledger__dl--mail">
          {CONTACT.emails.map((e) => (
            <div><dt>{e.label}</dt><dd><a href={`mailto:${e.value}`}>{e.value}</a></dd></div>
          ))}
          <div><dt>Website</dt><dd><a href={`https://${CONTACT.website}`}>{CONTACT.website}</a></dd></div>
        </dl>
      </div>
    </address>
    <p class="ph-forms" data-reveal style="--d:.42s"><a class="btn" href="#forms">Inquiry forms <Fragment set:html={svg('M12 4v15m-6-6 6 6 6-6')} /></a></p>
  </PageHead>

  <!-- 02 · the map -->
  <section class="sec sec--hide map" aria-labelledby="map-h">
    <div class="wrap map__in">
      <div class="map__text">
        <p class="label label--rule" data-reveal="fade"><b>02</b> Find us</p>
        <h2 class="h2 map__title" id="map-h" data-reveal>At Meskel <em>Square</em>.</h2>
        <p class="body map__addr" data-reveal style="--d:.08s">{CONTACT.address.full}</p>
        <p class="map__cta" data-reveal style="--d:.14s">
          <a class="btn btn--ghost" href={CONTACT.map.link} target="_blank" rel="noopener">
            Open in Maps <Fragment set:html={svg(out)} /><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
      <div class="map__frame frame" data-reveal="fade" style="--d:.1s">
        <!-- shown until the map has loaded, or if it cannot -->
        <div class="map__under" aria-hidden="true">
          <span class="map__pin"><i></i></span>
          <span class="map__coord">{coord}</span>
        </div>
        <iframe
          src={CONTACT.map.embed}
          title={`Map: the ${ORG.short} office, ${CONTACT.address.lines[0]}, ${CONTACT.address.lines[1]}, Addis Ababa`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- 03 · the inquiry forms -->
  <section class="sec sec--paper sheet forms" id="forms" aria-labelledby="forms-h">
    <div class="wrap forms__in" data-ftabs>
      <div class="forms__side">
        <p class="label label--rule" data-reveal="fade"><b>03</b> Inquiry forms</p>
        <h2 class="h2 mt-m" id="forms-h" data-reveal>Send an <em>inquiry</em>.</h2>
        <p class="body mt-m forms__note" data-reveal style="--d:.08s">
          Each form goes straight to the Secretariat team responsible for it. You receive a confirmation by e-mail, with a reference.
        </p>
        <div class="ftabs" role="tablist" aria-label="Inquiry forms">
          {FORMS.map((f, i) => (
            <button class="ftab" type="button" role="tab" id={`ft-${f.key}`} aria-controls={`fp-${f.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-key={f.key}>
              <span class="ftab__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{f.tab}
            </button>
          ))}
        </div>
      </div>

      <div class="forms__panels">
        <!-- General inquiry -->
        <div class="fpanel" role="tabpanel" id="fp-general" aria-labelledby="ft-general">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-general">{FORMS[0].title}</h3><p class="fpanel__to">Answered by the {FORMS[0].team}</p></header>
          <form class="form" action="/api/forms/general" method="post" data-form="general" data-ok={ACK} aria-labelledby="fh-general" novalidate>
            <label class="field"><span>Full name</span><input name="name" autocomplete="name" required maxlength="120" /></label>
            <label class="field"><span>Organization <b>(optional)</b></span><input name="organization" autocomplete="organization" maxlength="160" /></label>
            <label class="field"><span>E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
            <label class="field"><span>Phone <b>(optional)</b></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
            <label class="field"><span>Country <b>(optional)</b></span><input name="country" autocomplete="country-name" maxlength="80" /></label>
            <label class="field"><span>Subject</span><input name="subject" required maxlength="200" /></label>
            <label class="field full"><span>Message</span><textarea name="message" required maxlength="5000" rows="6"></textarea></label>
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__end full">
              <button class="btn btn--dark" type="submit">Send <Fragment set:html={svg(arrow)} /></button>
              <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
            </div>
          </form>
        </div>

        <!-- Membership application -->
        <div class="fpanel fpanel--bare" role="tabpanel" id="fp-membership" aria-labelledby="ft-membership">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-membership">{FORMS[1].title}</h3><p class="fpanel__to">Answered by {FORMS[1].team}</p></header>
          <p class="fpanel__intro">Membership is open to leather manufacturers and industry service providers operating in Ethiopia. <a href="/members#benefits">What membership brings</a>.</p>
          <MembershipForm labelledby="fh-membership" id="cm" />
        </div>

        <!-- Buyer inquiry -->
        <div class="fpanel" role="tabpanel" id="fp-buyer" aria-labelledby="ft-buyer">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-buyer">{FORMS[2].title}</h3><p class="fpanel__to">Answered by {FORMS[2].team}</p></header>
          <form class="form" action="/api/forms/buyer" method="post" data-form="buyer" data-ok={ACK} aria-labelledby="fh-buyer" novalidate>
            <label class="field"><span>Company name</span><input name="company" autocomplete="organization" required maxlength="160" /></label>
            <label class="field"><span>Contact person</span><input name="name" autocomplete="name" required maxlength="120" /></label>
            <label class="field"><span>Country</span><input name="country" autocomplete="country-name" required maxlength="80" /></label>
            <label class="field"><span>E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
            <label class="field"><span>Phone <b>(optional)</b></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
            <label class="field">
              <span>Product category</span>
              <select name="product" required>
                <option value="">Choose…</option>
                {PRODUCTS.map((p) => <option>{p}</option>)}
              </select>
            </label>
            <label class="field"><span>Quantity <b>(optional)</b></span><input name="quantity" maxlength="120" placeholder="e.g. 5,000 pairs a month" /></label>
            <label class="field"><span>Target delivery date <b>(optional)</b></span><input name="delivery" type="date" min={today} /></label>
            <label class="field full"><span>Quality requirements <b>(optional)</b></span><textarea name="quality" maxlength="1000" rows="3" placeholder="Leather type, finish, standards or certifications"></textarea></label>
            <label class="field full"><span>Message <b>(optional)</b></span><textarea name="message" maxlength="5000" rows="4"></textarea></label>
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__end full">
              <button class="btn btn--dark" type="submit">Send <Fragment set:html={svg(arrow)} /></button>
              <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
            </div>
          </form>
        </div>

        <!-- Investor inquiry -->
        <div class="fpanel" role="tabpanel" id="fp-investor" aria-labelledby="ft-investor">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-investor">{FORMS[3].title}</h3><p class="fpanel__to">Answered by the {FORMS[3].team}</p></header>
          <form class="form" action="/api/forms/investor" method="post" data-form="investor" data-ok={ACK} aria-labelledby="fh-investor" novalidate>
            <label class="field"><span>Company name</span><input name="company" autocomplete="organization" required maxlength="160" /></label>
            <label class="field"><span>Contact person</span><input name="name" autocomplete="name" required maxlength="120" /></label>
            <label class="field"><span>Country</span><input name="country" autocomplete="country-name" required maxlength="80" /></label>
            <label class="field"><span>E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
            <label class="field"><span>Phone <b>(optional)</b></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
            <label class="field">
              <span>Investment area</span>
              <select name="area" required>
                <option value="">Choose…</option>
                {AREAS.map((a) => <option>{a}</option>)}
              </select>
            </label>
            <label class="field"><span>Estimated investment size <b>(optional)</b></span><input name="size" maxlength="120" placeholder="e.g. USD 5 million" /></label>
            <label class="field"><span>Preferred location <b>(optional)</b></span><input name="location" maxlength="160" placeholder="e.g. Modjo, Addis Ababa" /></label>
            <label class="field full"><span>Message <b>(optional)</b></span><textarea name="message" maxlength="5000" rows="5"></textarea></label>
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__end full">
              <button class="btn btn--dark" type="submit">Send <Fragment set:html={svg(arrow)} /></button>
              <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
            </div>
          </form>
        </div>

        <!-- AALF exhibitor and sponsor inquiry -->
        <div class="fpanel" role="tabpanel" id="fp-aalf" aria-labelledby="ft-aalf">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-aalf">{FORMS[4].title}</h3><p class="fpanel__to">Answered by the {FORMS[4].team}</p></header>
          <form class="form" action="/api/forms/aalf" method="post" data-form="aalf" data-ok={ACK} aria-labelledby="fh-aalf" novalidate>
            <label class="field"><span>Company name</span><input name="company" autocomplete="organization" required maxlength="160" /></label>
            <label class="field"><span>Contact person</span><input name="name" autocomplete="name" required maxlength="120" /></label>
            <label class="field"><span>E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
            <label class="field"><span>Phone <b>(optional)</b></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
            <fieldset class="chips field">
              <legend>Interest</legend>
              {['Exhibit', 'Sponsor', 'Visit'].map((v) => <label class="chip"><input type="radio" name="interest" value={v} required /><span>{v}</span></label>)}
            </fieldset>
            <label class="field"><span>Booth size <b>(optional)</b></span><input name="booth" maxlength="80" placeholder="e.g. 9 m²" /></label>
            <label class="field full"><span>Message <b>(optional)</b></span><textarea name="message" maxlength="5000" rows="5"></textarea></label>
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__end full">
              <button class="btn btn--dark" type="submit">Send <Fragment set:html={svg(arrow)} /></button>
              <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
            </div>
          </form>
        </div>

        <!-- Media inquiry -->
        <div class="fpanel" role="tabpanel" id="fp-media" aria-labelledby="ft-media">
          <header class="fpanel__head"><h3 class="fpanel__t" id="fh-media">{FORMS[5].title}</h3><p class="fpanel__to">Answered by {FORMS[5].team}</p></header>
          <form class="form" action="/api/forms/media" method="post" data-form="media" data-ok={ACK} aria-labelledby="fh-media" novalidate>
            <label class="field"><span>Name</span><input name="name" autocomplete="name" required maxlength="120" /></label>
            <label class="field"><span>Media outlet</span><input name="outlet" autocomplete="organization" required maxlength="160" /></label>
            <label class="field"><span>E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
            <label class="field"><span>Phone <b>(optional)</b></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
            <label class="field"><span>Deadline <b>(optional)</b></span><input name="deadline" type="date" min={today} /></label>
            <label class="field full"><span>Request</span><textarea name="request" required maxlength="5000" rows="6"></textarea></label>
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form__end full">
              <button class="btn btn--dark" type="submit">Send <Fragment set:html={svg(arrow)} /></button>
              <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
            </div>
          </form>
        </div>
      </div>
    </div>
    <script is:inline>
      /* open the form a link asked for (?form=buyer), and fill in what it brought (?subject=, ?interest=), before the
         page is painted; without the script every form is shown, one after another */
      (function (box) {
        if (!box) return
        var q = new URLSearchParams(location.search), want = q.get('form')
        var tabs = box.querySelectorAll('[role=tab]'), on = 0, i
        for (i = 0; i < tabs.length; i++) if (tabs[i].getAttribute('data-key') === want) on = i
        for (i = 0; i < tabs.length; i++) {
          tabs[i].setAttribute('aria-selected', i === on ? 'true' : 'false')
          tabs[i].tabIndex = i === on ? 0 : -1
          document.getElementById(tabs[i].getAttribute('aria-controls')).hidden = i !== on
        }
        var s = q.get('subject'), f = s && box.querySelector('#fp-general [name=subject]')
        if (f) f.value = s.slice(0, 200)
        var it = q.get('interest')
        box.querySelectorAll('#fp-aalf [name=interest]').forEach(function (r) { if (r.value === it) r.checked = true })
      })(document.querySelector('[data-ftabs]'))
    </script>
  </section>

  <!-- 04 · newsletter -->
  <section class="sec sheet lit news-sub" aria-labelledby="sub-h">
    <div class="wrap news-sub__in">
      <div>
        <p class="label label--rule" data-reveal="fade"><b>04</b> Newsletter</p>
        <h2 class="h2 mt-m" id="sub-h" data-reveal>Subscribe for <em>updates</em>.</h2>
        <p class="body mt-m" data-reveal style="--d:.08s">Receive the latest news, events and opportunities from ELIA.</p>
        {social.length > 0 && (
          <div class="follow" data-reveal style="--d:.12s">
            <p class="label">Follow ELIA</p>
            <ul class="follow__list" role="list">
              {social.map((s) => <li><a class="btn btn--ghost btn--sm" href={s.href} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
            </ul>
          </div>
        )}
      </div>
      <form class="form news-sub__form card" action="/api/forms/subscribe" method="post" data-form="subscribe"
        data-ok="Thank you. You are subscribed to ELIA’s updates; a confirmation is on its way to your inbox." aria-labelledby="sub-h" novalidate data-reveal>
        <label class="field full"><span>E-mail address</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" spellcheck="false" /></label>
        <fieldset class="chips field full">
          <legend>I am interested as a <b>(optional)</b></legend>
          {INTERESTS.map((v) => <label class="chip"><input type="checkbox" name="interests" value={v} /><span>{v}</span></label>)}
        </fieldset>
        <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form__end full">
          <button class="btn" type="submit">Subscribe <Fragment set:html={svg(arrow)} /></button>
          <p class="form__msg" role="status" aria-live="polite" data-form-msg></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  /* the forms' tabs: click, or the arrow keys, Home and End (a vertical list beside the forms, a row above them on a
     phone); the address keeps the open form, so a reload or a shared link opens the same one */
  const box = document.querySelector<HTMLElement>('[data-ftabs]')
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t
        x.setAttribute('aria-selected', String(on))
        x.tabIndex = on ? 0 : -1
        const p = document.getElementById(x.getAttribute('aria-controls')!)
        if (p) p.hidden = !on
      })
      if (focus) t.focus()
      t.scrollIntoView({ block: 'nearest', inline: 'nearest' })
      const u = new URL(location.href)
      u.searchParams.set('form', t.dataset.key!)
      history.replaceState(history.state, '', u)
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t))
      t.addEventListener('keydown', (e) => {
        const n = tabs.length
        const j = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? (i + 1) % n
          : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? (i - 1 + n) % n
          : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1
        if (j >= 0) { e.preventDefault(); select(tabs[j], true) }
      })
    })
  }
</script>

<style>
  /* 01 · the ledger under the title: visit, call, write */
  .ledger {
    margin-top: clamp(40px, 5vw, 72px); font-style: normal;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 1120px;
    border-top: 1px solid var(--line);
  }
  .ledger__col { display: grid; align-content: start; gap: 14px; padding: 26px clamp(18px, 2.4vw, 40px) 4px; }
  .ledger__col:first-child { padding-left: 0; }
  .ledger__col + .ledger__col { border-left: 1.4px dashed rgb(226 160 37 / 0.4); }
  .ledger__addr { display: grid; font-size: var(--step-0); line-height: 1.5; color: var(--cream); }
  .ledger__dl { margin: 0; display: grid; gap: 10px; }
  .ledger__dl div { display: grid; gap: 2px; }
  .ledger__dl dt { font-weight: 560; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ledger__dl dd { margin: 0; font-size: var(--step-0); color: var(--cream); overflow-wrap: anywhere; }
  .ledger__dl a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.4s var(--ease), color 0.25s; }
  .ledger__dl a:hover { background-size: 100% 1px; color: var(--amber); }
  .ph-forms { margin-top: clamp(28px, 3vw, 40px); }

  /* 02 · the map */
  .map__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(14px, 1.8vw, 28px); row-gap: 40px; align-items: end; }
  .map__text { grid-column: 1 / span 4; }
  .map__title { margin-top: 22px; max-width: 12ch; }
  .map__addr { margin-top: 24px; max-width: 34ch; }
  .map__cta { margin-top: 30px; }
  .map__frame { grid-column: 6 / -1; aspect-ratio: 16 / 11; box-shadow: 0 0 0 1px var(--line), 0 40px 80px -50px rgb(0 0 0 / 0.9); }
  .map__frame iframe { position: relative; z-index: 1; display: block; width: 100%; height: 100%; border: 0; filter: sepia(0.18) saturate(0.88); }
  .map__under {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 18px;
    background:
      radial-gradient(circle at 50% 46%, rgb(226 160 37 / 0.1), transparent 55%),
      repeating-linear-gradient(0deg, rgb(255 252 245 / 0.05) 0 1px, transparent 1px 56px),
      repeating-linear-gradient(90deg, rgb(255 252 245 / 0.05) 0 1px, transparent 1px 56px),
      var(--hide);
  }
  .map__pin { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; border: 1.4px dashed rgb(226 160 37 / 0.6); }
  .map__pin i { width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 18px var(--gold); }
  .map__coord { font-weight: 520; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  /* 03 · the forms: the list of forms beside them, each form a panel */
  .forms { scroll-margin-top: 40px; }
