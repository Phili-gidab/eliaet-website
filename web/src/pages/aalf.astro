---
import { responsive } from '../lib/media'
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
import SectionHead from '../components/SectionHead.astro'
import {
  AALF_2026,
  AALF_ABOUT,
  AALF_COMPONENTS,
  AALF_FACTS,
  AALF_PARTNERS,
  AALF_OUTCOMES,
  AALF_PAST,
  AALF_IMAGES,
} from '../copy/aalf'

const site = AALF_2026.site.replace(/^https?:\/\//, '').replace(/\/$/, '')
const registerHost = AALF_2026.register.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
const [factLead, ...facts] = AALF_FACTS
const dot = (s: string) => `${s.replace(/\.$/, '')}<em>.</em>`
const out = 'M7 17 17 7M9 7h8v8'
/* outcomes that have a page of their own */
const OUTCOME_LINKS: Record<string, string> = { 'EHL promotion': '/ehl' }
---

<Base
  title={AALF_2026.name}
  description={`${AALF_2026.name}, ${AALF_2026.edition}: ${AALF_2026.dates}, ${AALF_2026.venue}, ${AALF_2026.city}. ${AALF_2026.cobrand}.`}
>
  <PageHead
    index="01"
    eyebrow={AALF_2026.edition}
    title={['All Africa Leather', '&amp; Textile Fair', '<em>2026</em>']}
    lede={`${AALF_2026.cobrand}.`}
    image={AALF_IMAGES.model}
    imageAlt="A model in a cognac leather jacket"
  >
    <!-- the 2026 edition as a stitched ticket -->
    <div class="ticket seam" data-reveal style="--d:.35s">
      <img class="ticket__logo" src="/media/aalf-logo.svg" alt="All African Leather Fair" width="383" height="143" decoding="async" />
      <dl class="ticket__grid">
        <div class="ticket__cell">
          <dt class="label">Dates</dt>
          <dd class="ticket__big"><time datetime={AALF_2026.start.slice(0, 10)}>{AALF_2026.dates}</time></dd>
        </div>
        <div class="ticket__cell">
          <dt class="label">Venue</dt>
          <dd class="ticket__venue">{AALF_2026.venue}<span>{AALF_2026.city}</span></dd>
        </div>
      </dl>
      <p class="ticket__count" data-countdown={AALF_2026.start} hidden>
        <span class="label">Opens in</span>
        <span class="ticket__unit"><b class="figure-num" data-cd="d">00</b> days</span>
        <span class="ticket__unit"><b class="figure-num" data-cd="h">00</b> hours</span>
        <span class="ticket__unit"><b class="figure-num" data-cd="m">00</b> min</span>
      </p>
      <div class="ticket__cta">
        <a class="btn" href={AALF_2026.register} target="_blank" rel="noopener">
          Register
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={out} fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          <span class="sr-only">for {AALF_2026.name} on {registerHost} (opens in a new tab)</span>
        </a>
        <a class="link" href={AALF_2026.site} target="_blank" rel="noopener">
          {site}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={out} fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </PageHead>

  <!-- 02 · about the fair -->
  <section class="sec sec--paper about" id="about">
    <div class="wrap">
      <SectionHead index="02" eyebrow={AALF_ABOUT.eyebrow} title={dot(AALF_ABOUT.title)} intro={AALF_ABOUT.text} />
      <div class="about__pics">
        <img class="about__cut" src={AALF_IMAGES.hammer} alt="A woman in a traditional leather dress and beads, set against a map of Africa" width="1080" height="1080" loading="lazy" decoding="async" data-reveal="fade" {...responsive(AALF_IMAGES.hammer, '(max-width: 900px) 92vw, 650px')} />
        <div class="frame about__frame" data-reveal="fade" style="--d:.12s">
          <img src={AALF_IMAGES.model2} alt="A model seated on a hide beside a round leather vessel" width="990" height="990" loading="lazy" decoding="async" {...responsive(AALF_IMAGES.model2, '(max-width: 900px) 70vw, 540px')} />
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · what happens at the fair -->
  <section class="sec grain comp" id="components" aria-labelledby="comp-h">
    <div class="wrap">
      <p class="label label--rule" data-reveal="fade"><b>03</b> Components</p>
      <h2 class="h2 comp__title" id="comp-h" data-reveal>Components of the fair<em>.</em></h2>
      <ul class="comp__list" role="list">
        {AALF_COMPONENTS.map((c, i) => (
          <li class="comp__item" data-reveal style={`--d:${(i % 2) * 0.08}s`}>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 04 · facts -->
  <section class="sec sec--paper sec--tight facts" id="facts" aria-labelledby="facts-h">
    <div class="wrap">
      <div class="facts__head">
        <p class="label label--rule" data-reveal="fade"><b>04</b> Facts</p>
        <h2 class="h2 facts__lead" id="facts-h" data-reveal>{factLead.replace(/\.$/, '')}<em>.</em></h2>
      </div>
      <ul class="facts__list" role="list">
        {facts.map((f, i) => <li data-reveal style={`--d:${i * 0.08}s`}>{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- 05 · partners and financing -->
  <section class="sec sec--saddle grain partners" id="partners">
    <div class="wrap">
      <SectionHead index="05" eyebrow={AALF_PARTNERS.eyebrow} title={dot(AALF_PARTNERS.title)} intro={AALF_PARTNERS.body[0]} />
      <div class="partners__grid">
        <div class="body partners__body" data-reveal>
          {AALF_PARTNERS.body.slice(1).map((p) => <p>{p}</p>)}
          <p>{AALF_PARTNERS.selfFunding}</p>
        </div>
        <div class="ledger seam" data-reveal style="--d:.1s">
          <p class="label">Funding</p>
          <p class="ledger__intro">{AALF_PARTNERS.fundingIntro}</p>
          <ul class="ledger__list" role="list">
            {AALF_PARTNERS.funding.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · outcomes -->
  <section class="sec sec--paper outcomes" id="outcomes" aria-labelledby="outcomes-h">
    <div class="wrap outcomes__in">
      <h2 class="label label--rule outcomes__label" id="outcomes-h" data-reveal="fade"><b>06</b> Outcomes</h2>
      <ul class="outcomes__list" role="list">
        {AALF_OUTCOMES.map((o, i) => (
          <li data-reveal style={`--d:${(i % 3) * 0.05}s`}>
            {OUTCOME_LINKS[o] ? (
              <a href={OUTCOME_LINKS[o]}>{o}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
            ) : o}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 07 · past editions -->
  <section class="sec grain past" id="past" aria-labelledby="past-h">
    <div class="wrap past__in">
      <div class="frame past__poster" data-reveal="fade">
        <img src={AALF_PAST.poster} alt="Poster of the 14th All African Leather Fair at Millennium Hall, Addis Ababa" width="763" height="1080" loading="lazy" decoding="async" {...responsive(AALF_PAST.poster, '(max-width: 900px) 92vw, 540px')} />
      </div>
      <div class="past__text">
        <p class="label label--rule" data-reveal="fade"><b>07</b> Past editions</p>
        <h2 class="h2 past__title" id="past-h" data-reveal>{AALF_PAST.title}<em>.</em></h2>
        <p class="lede past__lede" data-reveal style="--d:.1s">{AALF_PAST.text}</p>
      </div>
    </div>
  </section>

  <!-- the 2026 edition again, for whoever read this far -->
  <section class="sec sec--paper sec--tight again" aria-label={`${AALF_2026.name}: register`}>
    <div class="wrap again__in">
      <div>
        <p class="label">{AALF_2026.edition}</p>
        <p class="again__name">{AALF_2026.name}</p>
        <p class="again__meta"><time datetime={AALF_2026.start.slice(0, 10)}>{AALF_2026.dates}</time><br />{AALF_2026.venue}, {AALF_2026.city}</p>
      </div>
      <a class="btn btn--dark" href={AALF_2026.register} target="_blank" rel="noopener">
        Register
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={out} fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        <span class="sr-only">for {AALF_2026.name} on {registerHost} (opens in a new tab)</span>
      </a>
    </div>
  </section>
</Base>

<script>
  /* days, hours and minutes to the opening; hidden once the fair has opened (and without JavaScript) */
  const el = document.querySelector<HTMLElement>('[data-countdown]')
  if (el) {
    const start = Date.parse(el.dataset.countdown || '')
    const put = (k: string, v: number) => {
      const n = el.querySelector(`[data-cd="${k}"]`)
      if (n) n.textContent = String(v).padStart(2, '0')
    }
    const tick = () => {
      const ms = start - Date.now()
      if (!(ms > 0)) { el.hidden = true; return false }
      put('d', Math.floor(ms / 864e5))
      put('h', Math.floor(ms / 36e5) % 24)
      put('m', Math.floor(ms / 6e4) % 60)
      el.hidden = false
      return true
    }
    if (tick()) setInterval(tick, 30000)
  }
</script>

<style>
  /* 01 · the ticket in the page head */
  .ticket {
    margin-top: clamp(30px, 3.6vw, 48px); max-width: 600px; padding: clamp(24px, 2.6vw, 36px); border-radius: 10px;
    background: linear-gradient(160deg, #2c1d14 0%, #1d1510 60%, #160f0b 100%);
    box-shadow: inset 0 1px 0 rgb(255 236 210 / 0.07), 0 30px 60px -40px rgb(0 0 0 / 0.95);
  }
  .ticket__logo { width: clamp(150px, 14vw, 190px); height: auto; }
  .ticket__grid { margin: 22px 0 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-top: 1px dashed rgb(226 160 37 / 0.35); }
  .ticket__cell { padding-top: 18px; display: grid; gap: 8px; align-content: start; }
  .ticket__cell + .ticket__cell { padding-left: 22px; border-left: 1px dashed rgb(226 160 37 / 0.35); margin-left: 22px; }
  .ticket__cell dd { margin: 0; }
  .ticket__big { font-family: var(--f-display); font-size: var(--step-2); line-height: 1.05; letter-spacing: -0.01em; color: var(--cream); }
  .ticket__venue { font-size: 15.5px; line-height: 1.45; color: var(--cream); font-weight: 500; }
  .ticket__venue span { display: block; font-weight: 400; color: var(--muted); }
  .ticket__count { margin-top: 22px; padding-top: 16px; border-top: 1px dashed rgb(226 160 37 / 0.35); display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; }
  .ticket__count[hidden] { display: none; }
  .ticket__count .label { margin-right: 4px; }
  .ticket__unit { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ticket__unit b { font-size: 1.85rem; font-weight: 300; color: var(--amber); letter-spacing: -0.04em; margin-right: 4px; }
  .ticket__cta { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }

  /* 02 · about: the cut-out over Africa beside a studio portrait */
  .about__pics { margin-top: clamp(48px, 6vw, 96px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(14px, 1.8vw, 28px); align-items: end; }
  .about__cut { grid-column: 1 / span 6; width: 100%; height: auto; }
  .about__frame { grid-column: 8 / span 5; aspect-ratio: 1; margin-bottom: clamp(0px, 4vw, 64px); }

  /* 03 · components */
  .comp { background: var(--ink); }
  .comp__title { margin-top: 22px; max-width: 16ch; }
  /* quilted like a stitched panel: the cells divided by saddle stitches, no outer edge */
  .comp__list {
    --st: rgb(226 160 37 / 0.42);
    list-style: none; margin: clamp(44px, 5.4vw, 84px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
  }
  .comp__item {
    position: relative; min-height: clamp(150px, 15vw, 220px); padding: clamp(24px, 2.6vw, 40px) clamp(20px, 2.4vw, 40px);
    font-family: var(--f-display); font-size: var(--step-1); line-height: 1.3; color: var(--cream); text-wrap: pretty;
  }
  /* each cell draws its stitch on the left and top; the list clips the ones on the outer edge */
  .comp__item::before, .comp__item::after { content: ''; position: absolute; pointer-events: none; }
  .comp__item::before { left: -1.6px; top: 0; bottom: 0; width: 1.6px; background: repeating-linear-gradient(180deg, var(--st) 0 7px, transparent 7px 13px); }
  .comp__item::after { top: -1.6px; left: 0; right: 0; height: 1.6px; background: repeating-linear-gradient(90deg, var(--st) 0 7px, transparent 7px 13px); }
  .comp__item:nth-child(3n + 1) { padding-left: 0; }

  /* 04 · facts */
  .facts__head { display: grid; gap: 22px; }
  .facts__lead { max-width: 24ch; }
  .facts__list { list-style: none; margin: clamp(36px, 4.4vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px clamp(20px, 3vw, 48px); }
  .facts__list li {
    padding-top: 20px; color: #3d2e24; text-wrap: pretty;
    border-top: 1.6px solid transparent; border-image: repeating-linear-gradient(90deg, var(--cognac) 0 7px, transparent 7px 13px) 1;
  }

  /* 05 · partners and financing: the sources of funding kept like a ledger */
  .partners__grid { margin-top: clamp(44px, 5.4vw, 84px); display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 40px clamp(32px, 5vw, 96px); align-items: start; }
  .partners__body { color: var(--bone); }
  .ledger { padding: clamp(26px, 2.8vw, 40px); border-radius: 10px; background: rgb(18 13 10 / 0.38); box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.5), 0 1px 0 rgb(255 222 175 / 0.06); }
  .ledger__intro { margin-top: 14px; color: var(--bone); max-width: 40ch; }
  .ledger__list { list-style: none; margin: 18px 0 0; padding: 0; }
  .ledger__list li {
    padding: 13px 0; border-top: 1px solid var(--line);
    font-family: var(--f-display); font-size: var(--step-1); line-height: 1.25; color: var(--cream);
  }

  /* 06 · outcomes, set large */
  .outcomes__in { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 28px clamp(24px, 3vw, 48px); }
  .outcomes__label { align-self: start; margin-top: 1.4em; }
  .outcomes__list { list-style: none; margin: 0; padding: 0; }
  .outcomes__list li {
    padding: clamp(14px, 1.6vw, 22px) 0; border-bottom: 1px solid var(--line-dark);
    font-family: var(--f-display); font-size: var(--step-3); line-height: 1.04; letter-spacing: -0.016em; color: var(--ink); text-wrap: balance;
  }
  .outcomes__list li:first-child { font-size: var(--step-2); line-height: 1.16; padding-top: 0; padding-right: 12%; }
  .outcomes__list a { display: inline-flex; align-items: center; gap: 0.3em; color: var(--cognac-ink); transition: gap 0.4s var(--ease); }
  .outcomes__list a svg { width: 0.62em; height: 0.62em; }
  .outcomes__list a:hover { gap: 0.5em; }

  /* 07 · past editions */
  .past { background: var(--ink); }
  .past__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(14px, 1.8vw, 28px); row-gap: 40px; align-items: center; }
  .past__poster { grid-column: 1 / span 5; aspect-ratio: 763 / 1080; }
  .past__text { grid-column: 7 / span 6; }
  .past__title { margin-top: 22px; max-width: 14ch; }
  .past__lede { margin-top: 26px; max-width: 44ch; }

  /* closing band */
  .again__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; }
  .again__name { margin-top: 12px; font-family: var(--f-display); font-size: var(--step-2); line-height: 1.08; color: var(--ink); }
  .again__meta { margin-top: 8px; color: #3d2e24; }

  @media (max-width: 1000px) {
    .partners__grid { grid-template-columns: 1fr; }
    .facts__list { grid-template-columns: 1fr; }
  }
  @media (max-width: 1000px) {
    .comp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .comp__item:nth-child(3n + 1) { padding-left: clamp(20px, 2.4vw, 40px); }
    .comp__item:nth-child(2n + 1) { padding-left: 0; }
  }
  @media (max-width: 860px) {
    .outcomes__in { grid-template-columns: 1fr; }
    .outcomes__label { margin-top: 0; }
    .past__poster { grid-column: 1 / span 6; }
    .past__text { grid-column: 7 / -1; }
  }
  @media (max-width: 640px) {
    .ticket__grid { grid-template-columns: 1fr; }
    .ticket__cell + .ticket__cell { padding-left: 0; margin-left: 0; border-left: 0; margin-top: 18px; border-top: 1px dashed rgb(226 160 37 / 0.35); }
    .about__cut { grid-column: 1 / -1; }
    .about__frame { grid-column: 4 / -1; margin: 18px 0 0; }
    .ticket__count .label { flex-basis: 100%; }
    .past__poster, .past__text { grid-column: 1 / -1; }
    .past__poster { max-width: 360px; }
    .outcomes__list li { font-size: var(--step-2); }
    .outcomes__list li:first-child { font-size: var(--step-1); padding-right: 0; }
    .comp__list { grid-template-columns: 1fr; }
    .comp__item, .comp__item:nth-child(3n + 1) { min-height: 0; padding-inline: 0; }
  }
</style>
