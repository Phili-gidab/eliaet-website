---
/* A news post's page. Not a page of its own: the server fills its @@tokens@@ and its marked regions with a post from
   the database for every /news/<slug> (server/src/pages.ts), and keeps /templates itself out of reach. */
import Base from '../../layouts/Base.astro'

const arrow = 'M4 12h15m-6-6 6 6-6 6'
const back = 'M20 12H5m6-6-6 6 6 6'
const out = 'M7 17 17 7M9 7h8v8'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`
---

<Base title="@@title@@" description="@@description@@" canonicalPath="/news/@@slug@@" imageRaw="@@image@@" section="/news">
  <article class="post">
    <header class="post__head lit">
      <div class="wrap post__headin">
        <p class="post__crumbs label" data-reveal="fade">
          <a href="/news">News</a><span aria-hidden="true">/</span><a href="/news?tab=news&cat=@@category_key@@#news">@@category@@</a>
        </p>
        <h1 class="h1 post__title" data-reveal>@@title@@</h1>
        <p class="post__meta" data-reveal style="--d:.08s"><time datetime="@@date@@">@@date_text@@</time></p>
      </div>
    </header>

    <div class="sec sec--paper sheet post__paper">
      <div class="wrap post__in">
        <figure class="frame post__img" data-hide="@@image_hidden@@" data-reveal="mask">
          <img src="@@image_src@@" alt="" decoding="async" />
        </figure>
        <div class="prose post__body">
          <template data-cms="post-body"></template><template data-cms-end="post-body"></template>
        </div>
        <p class="post__source" data-hide="@@source_hidden@@">
          <a class="btn btn--ghost" href="@@source@@" target="_blank" rel="noopener">Read the original <Fragment set:html={svg(out)} /><span class="sr-only"> (opens in a new tab)</span></a>
        </p>
        <p class="post__back"><a class="link" href="/news"><Fragment set:html={svg(back)} /> All news, events and publications</a></p>
      </div>
    </div>

    <section class="sec sheet lit post__more" aria-labelledby="more-h">
      <div class="wrap">
        <p class="label label--rule" data-reveal="fade">More news</p>
        <h2 class="h2 mt-m" id="more-h" data-reveal>Also <em>new</em>.</h2>
        <div class="news-grid mt-l">
          <template data-cms="post-more"></template><template data-cms-end="post-more"></template>
        </div>
        <p class="mt-l"><a class="link post__all" href="/news?tab=news#news">View all news <Fragment set:html={svg(arrow)} /></a></p>
      </div>
    </section>
  </article>
</Base>

<style>
  [data-hide='hidden'] { display: none; }
  .post__head { padding: calc(var(--header-h) + clamp(48px, 7vw, 110px)) 0 calc(var(--radius-l) + clamp(40px, 5vw, 72px)); background: var(--ink); }
  .post__headin { max-width: 1040px; }
  .post__crumbs { display: flex; flex-wrap: wrap; gap: 10px; }
  .post__crumbs a { color: var(--bone); transition: color 0.25s; }
  .post__crumbs a:hover { color: var(--amber); }
  .post__title { margin-top: 24px; font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.8rem); max-width: 22ch; text-wrap: balance; }
  .post__meta { margin-top: 22px; color: var(--muted); font-weight: 500; }
  .post__in { max-width: 820px; }
  .post__img { margin: 0 0 clamp(28px, 4vw, 48px); aspect-ratio: 16 / 9; }
  .post__source { margin-top: clamp(28px, 3vw, 40px); }
  .post__source .btn { --fg: var(--ink); }
  .post__back { margin-top: clamp(36px, 4vw, 56px); padding-top: 24px; border-top: 1px solid var(--line-dark); }
  .post__back .link { color: var(--ink); }
  .post__back .link svg { order: -1; }
  .post__all { color: var(--amber); }
</style>
