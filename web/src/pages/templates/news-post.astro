---
/* A news post's page. Not a page of its own: the server fills its @@tokens@@ and its marked regions with a post from
   the database for every /news/<slug> (server/src/pages.ts), and keeps /templates itself out of reach.
   Set as a magazine feature: on the brand brown, the title (its second part, after a colon, in the light italic), the
   standfirst, the date and the reading time, and the photograph standing tall beside them, down over the page's edge.
   On the paper, the story with a drop cap, headings with an amber rule and pull quotes; beside it, a stitched card to
   share it from; at its foot, the association's sign-off. An amber line along the top of the screen fills as it is read. */
import Base from '../../layouts/Base.astro'

const arrow = 'M4 12h15m-6-6 6 6-6 6'
const back = 'M20 12H5m6-6-6 6 6 6'
const out = 'M7 17 17 7M9 7h8v8'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`
const share = [
  ['Telegram', 'https://t.me/share/url?url=@@url_enc@@&text=@@title_enc@@'],
  ['LinkedIn', 'https://www.linkedin.com/sharing/share-offsite/?url=@@url_enc@@'],
  ['Facebook', 'https://www.facebook.com/sharer/sharer.php?u=@@url_enc@@'],
  ['X', 'https://x.com/intent/post?url=@@url_enc@@&text=@@title_enc@@'],
]
---

<Base title="@@title@@" description="@@description@@" canonicalPath="/news/@@slug@@" imageRaw="@@image@@" section="/news">
  <div class="readbar" aria-hidden="true"><span data-readbar></span></div>
  <article class="post">
    <header class="post__head">
      <div class="wrap post__grid">
        <div class="post__text">
          <p class="post__crumbs" data-reveal="fade">
            <a href="/news">News</a><span aria-hidden="true">/</span><a class="post__cat" href="/news?tab=news&cat=@@category_key@@#news">@@category@@</a>
          </p>
          <h1 class="post__title" data-reveal>@@title_html@@</h1>
          <p class="post__dek" data-hide="@@dek_hidden@@" data-reveal style="--d:.08s">@@dek@@</p>
          <ul class="post__facts" role="list" data-reveal style="--d:.14s">
            <li><time datetime="@@date@@">@@date_text@@</time></li>
            <li>@@read_time@@ min read</li>
            <li>ELIA</li>
          </ul>
        </div>
        <figure class="post__cover" data-hide="@@image_hidden@@" data-reveal="mask" style="--d:.1s">
          <img src="@@image_src@@" srcset="@@image_srcset@@" sizes="(max-width: 900px) 92vw, 40vw" alt="" decoding="async" fetchpriority="high" />
        </figure>
      </div>
    </header>

    <div class="sec sec--paper sheet post__paper">
      <div class="wrap post__in">
        <div class="post__main">
          <div class="prose post__body">
            <template data-cms="post-body"></template><template data-cms-end="post-body"></template>
          </div>
          <p class="post__source" data-hide="@@source_hidden@@">
            <a class="btn btn--ghost" href="@@source@@" target="_blank" rel="noopener">Read the original <Fragment set:html={svg(out)} /><span class="sr-only"> (opens in a new tab)</span></a>
          </p>
          <!-- the sign-off: a line of stitching, and who published it -->
          <footer class="post__end">
            <span class="post__stitch" aria-hidden="true"></span>
            <p>Published by the <b>Ethiopian Leather Industries Association</b>, Addis Ababa.</p>
            <a class="link post__back" href="/news"><Fragment set:html={svg(back)} /> All news, events and publications</a>
          </footer>
        </div>

        <aside class="post__rail" aria-label="Share this story">
          <div class="post__card">
            <p class="post__k">Share this story</p>
            <ul class="post__share" role="list">
              <li><button class="post__chip" type="button" data-copy="@@url@@">Copy the link</button></li>
              {share.map(([label, href]) => (
                <li><a class="post__chip" href={href} target="_blank" rel="noopener">{label}<span class="sr-only"> (opens in a new tab)</span></a></li>
              ))}
            </ul>
            <p class="post__k">Filed under</p>
            <p><a class="post__filed" href="/news?tab=news&cat=@@category_key@@#news">@@category@@ <Fragment set:html={svg(arrow)} /></a></p>
          </div>
        </aside>
      </div>
    </div>

    <section class="sec sheet lit post__more" aria-labelledby="more-h">
      <div class="wrap">
        <p class="label label--rule" data-reveal="fade">More news</p>
        <h2 class="h2 mt-m" id="more-h" data-reveal>Also <em>new</em>.</h2>
        <div class="news-grid mt-l">
          <template data-cms="post-more"></template><template data-cms-end="post-more"></template>
        </div>
        <p class="mt-l"><a class="link post__all" href="/news?tab=news#news">View all news <Fragment set:html={svg(arrow)} /></a></p>
      </div>
    </section>
  </article>
</Base>

<script>
  // the reading line: how far down the story the middle of the screen has come
  const story = document.querySelector<HTMLElement>('.post__main')
  const bar = document.querySelector<HTMLElement>('[data-readbar]')
  if (story && bar) {
    let queued = 0
    const draw = () => {
      queued = 0
      const r = story.getBoundingClientRect()
      const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height))
      bar.style.transform = `scaleX(${p.toFixed(4)})`
    }
    addEventListener('scroll', () => { if (!queued) queued = requestAnimationFrame(draw) }, { passive: true })
    addEventListener('resize', draw)
    draw()
  }
  // copy the link
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const was = b.textContent
    try { await navigator.clipboard.writeText(b.dataset.copy || location.href); b.textContent = 'Link copied' } catch { b.textContent = 'Copy it from the address bar' }
    setTimeout(() => { b.textContent = was }, 2200)
  }))
</script>

<style>
  [data-hide='hidden'] { display: none !important; }

  /* the reading line */
  .readbar { position: fixed; inset: 0 0 auto; z-index: 300; height: 3px; pointer-events: none; }
  .readbar span { display: block; height: 100%; background: linear-gradient(90deg, #ecc06e, var(--amber)); transform: scaleX(0); transform-origin: 0 50%; }

  /* the cover: the title on the brown, the photograph standing beside it and down over the page's edge */
  /* how far the photograph hangs below the brown, the brown's foot, and the paper's head: the share card is set under
     the photograph from these */
  .post { --oh: clamp(110px, 12vw, 200px); --hp: clamp(64px, 7vw, 110px); --pp: clamp(44px, 5vw, 72px); }
  .post__head {
    position: relative; padding: calc(var(--header-h) + clamp(40px, 6vw, 96px)) 0 var(--hp); color: var(--cream);
    background: radial-gradient(60% 80% at 88% 0%, rgb(226 160 37 / 0.16), transparent 62%), radial-gradient(50% 60% at 0% 100%, rgb(93 68 61 / 0.5), transparent 70%), var(--ink);
  }
  .post__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 96px); align-items: end; }
  .post__crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 12px; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
  .post__crumbs a { color: rgb(255 252 245 / 0.72); transition: color 0.25s; }
  .post__crumbs a:hover { color: var(--amber); }
  .post__crumbs span { color: rgb(255 252 245 / 0.35); }
  .post__crumbs .post__cat { padding: 5px 12px; border-radius: 999px; color: var(--ink); background: var(--amber); }
  .post__crumbs .post__cat:hover { color: var(--ink); background: #ecc06e; }
  .post__title {
    margin-top: 26px; max-width: 18ch; font-family: var(--f-display); font-weight: 760; font-stretch: 80%; color: var(--cream);
    font-size: clamp(2.5rem, 1.2rem + 3.6vw, 5.2rem); line-height: 0.94; letter-spacing: -0.035em; text-wrap: balance;
  }
  .post__title :global(em) { display: block; margin-top: 0.06em; font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; color: var(--amber); letter-spacing: -0.03em; }
  .post__dek { margin-top: 26px; max-width: 46ch; font-size: clamp(1.08rem, 0.98rem + 0.4vw, 1.3rem); line-height: 1.5; color: rgb(255 252 245 / 0.8); }
  .post__facts { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .post__facts li {
    display: inline-flex; align-items: center; min-height: 34px; padding: 0 14px; border-radius: 999px; font-size: 13.5px; font-weight: 560;
    color: rgb(255 252 245 / 0.86); background: rgb(255 252 245 / 0.07); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.14);
  }
  .post__cover {
    position: relative; z-index: 3; margin: 0 0 calc(-1 * var(--oh)); aspect-ratio: 10 / 11; border-radius: var(--radius-l); overflow: hidden;
    background: var(--ink-3); box-shadow: 0 60px 100px -50px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(255 252 245 / 0.08);
  }
  .post__cover img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 50%; }

  /* the paper: the story, and the card to share it beside it (under the photograph's overhang) */
  .post__paper { position: relative; z-index: 2; padding-top: var(--pp); }
  .post__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0 clamp(32px, 5vw, 96px); align-items: start; }
  .post__main { grid-column: 1; grid-row: 1; max-width: 720px; }
  .post__rail { grid-column: 2; grid-row: 1; position: sticky; top: 110px; margin-top: max(0px, calc(var(--oh) - var(--hp) + var(--radius-l) - var(--pp) + 28px)); }
  .post:has(.post__cover[data-hide='hidden']) .post__rail { margin-top: 0; }
  .post__card {
    position: relative; display: grid; gap: 14px; max-width: 420px; padding: 26px; border-radius: 22px; background: var(--paper-2);
    box-shadow: inset 0 0 0 1px rgb(226 160 37 / 0.35);
  }
  .post__card::before { content: ''; position: absolute; inset: 9px; border-radius: 14px; border: 1.4px dashed rgb(226 160 37 / 0.55); pointer-events: none; }
  .post__k { font-size: 11.5px; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brown-80); }
  .post__k + * { margin-top: -4px; }
  .post__share { list-style: none; margin: 0 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .post__chip {
    position: relative; display: inline-flex; align-items: center; min-height: 38px; padding: 0 15px; border-radius: 999px; font: 600 13.5px/1 var(--f-text);
    color: var(--ink); background: #fffcf5; box-shadow: inset 0 0 0 1px rgb(60 30 22 / 0.16); cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  .post__chip:hover { background: var(--ink); color: var(--cream); }
  .post__filed { display: inline-flex; align-items: center; gap: 8px; font-family: var(--f-display); font-weight: 680; font-stretch: 86%; font-size: 1.3rem; color: var(--ink); }
  .post__filed :global(svg) { width: 18px; height: 18px; color: var(--amber); transition: transform 0.4s var(--ease); }
  .post__filed:hover :global(svg) { transform: translateX(4px); }

  /* the story's type */
  .post__body { font-size: clamp(1.06rem, 1rem + 0.25vw, 1.2rem); line-height: 1.75; }
  .post__body > :global(p:first-of-type) { font-size: 1.14em; line-height: 1.65; color: var(--ink); }
  .post__body > :global(p:first-of-type::first-letter) {
    float: left; margin: 0.06em 0.12em 0 0; font-family: var(--f-display); font-weight: 780; font-stretch: 80%; font-size: 4.4em; line-height: 0.8; color: var(--amber);
  }
  .post__body :global(h2) { margin-top: 2em; font-size: clamp(1.6rem, 1.25rem + 1vw, 2.2rem); }
  .post__body :global(h2::before) { content: ''; display: block; width: 44px; height: 3px; margin-bottom: 16px; border-radius: 2px; background: var(--amber); }
  .post__body :global(blockquote) {
    margin: 1.8em 0; padding: 0; border: 0; font-style: italic; font-weight: 300; font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.3; color: var(--ink); letter-spacing: -0.01em;
  }
  .post__body :global(blockquote::before) { content: '“'; display: block; height: 0.5em; font-family: var(--f-display); font-style: normal; font-weight: 800; font-size: 3.4em; line-height: 0.9; color: var(--amber); }
  .post__body :global(ul li::marker) { color: var(--amber); }
  .post__body :global(img) { border-radius: 16px; }
  .post__source { margin-top: clamp(28px, 3vw, 40px); }
  .post__source .btn { --fg: var(--ink); }

  /* the sign-off */
  .post__end { margin-top: clamp(40px, 5vw, 64px); display: grid; gap: 14px; }
  .post__stitch { display: block; height: 0; border-top: 1.6px dashed rgb(226 160 37 / 0.7); }
  .post__end p { font-size: 14.5px; color: var(--brown-80); }
  .post__end b { color: var(--ink); font-weight: 650; }
  .post__back { justify-self: start; color: var(--ink); }
  .post__back :global(svg) { order: -1; }
  .post__all { color: var(--amber); }

  @media (max-width: 900px) {
    .post__grid, .post__in { grid-template-columns: 1fr; }
    .post { --oh: clamp(56px, 12vw, 96px); }
    .post__cover { aspect-ratio: 4 / 3; }
    .post__rail { grid-column: 1; grid-row: 2; position: static; margin-top: 40px !important; }
    .post__card { max-width: none; }
    .post__paper { padding-top: calc(var(--oh) - var(--hp) + var(--radius-l) + 28px); }
    .post:has(.post__cover[data-hide='hidden']) .post__paper { padding-top: var(--pp); }
  }
</style>
