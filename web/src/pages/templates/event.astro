---
/* An event's page, filled by the server for every /events/<slug> (server/src/pages.ts): the description, date and
   time, the venue with a map, registration, and "Add to calendar" (the content document's event page). */
import Base from '../../layouts/Base.astro'

const out = 'M7 17 17 7M9 7h8v8'
const back = 'M20 12H5m6-6-6 6 6 6'
const cal = 'M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm7 7v5m-2.5-2.5h5'
const pin = 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z'
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>`
---

<Base title="@@title@@" description="@@description@@" canonicalPath="/events/@@slug@@" imageRaw="@@image@@" section="/news">
  <article class="evp">
    <header class="evp__head lit">
      <div class="wrap evp__headin">
        <p class="evp__crumbs label" data-reveal="fade"><a href="/news?tab=events#events">Events</a></p>
        <h1 class="h1 evp__title" data-reveal>@@title@@</h1>
        <p class="evp__past" data-hide="@@past_hidden@@" data-reveal style="--d:.06s"><span class="stamp"><i></i>This event has taken place</span></p>
        <dl class="evp__facts" data-reveal style="--d:.1s">
          <div><dt>When</dt><dd>@@when@@<span data-hide="@@time_hidden@@"> · @@time@@</span></dd></div>
          <div><dt>Where</dt><dd>@@venue@@<span class="evp__addr">@@address@@</span></dd></div>
        </dl>
        <div class="row evp__cta" data-reveal style="--d:.16s">
          <a class="btn" href="@@register@@" target="_blank" rel="noopener" data-hide="@@register_hidden@@">Register <Fragment set:html={svg(out)} /><span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn--ghost" href="/events/@@slug@@.ics" download data-hide="@@ics_hidden@@">Add to Calendar <Fragment set:html={svg(cal)} /></a>
          <a class="btn btn--ghost" href="@@map@@" target="_blank" rel="noopener" data-hide="@@map_hidden@@">Map <Fragment set:html={svg(pin)} /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
    </header>

    <div class="sec sec--paper sheet">
      <div class="wrap evp__in">
        <div class="prose">
          <template data-cms="event-body"></template><template data-cms-end="event-body"></template>
        </div>
        <p class="evp__back"><a class="link" href="/news?tab=events#events"><Fragment set:html={svg(back)} /> All events</a></p>
      </div>
    </div>
  </article>
</Base>

<style>
  [data-hide='hidden'] { display: none; }
  .evp__head { padding: calc(var(--header-h) + clamp(48px, 7vw, 110px)) 0 calc(var(--radius-l) + clamp(40px, 5vw, 72px)); background: var(--ink); }
  .evp__headin { max-width: 1040px; }
  .evp__crumbs a { color: var(--bone); transition: color 0.25s; }
  .evp__crumbs a:hover { color: var(--amber); }
  .evp__title { margin-top: 24px; font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.8rem); max-width: 20ch; text-wrap: balance; }
  .evp__past { margin-top: 18px; }
  .evp__facts { margin: clamp(28px, 3vw, 40px) 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 820px; border-top: 1px solid var(--line); }
  .evp__facts div { display: grid; gap: 6px; padding: 20px 24px 0 0; }
  .evp__facts div + div { padding-left: 24px; border-left: 1.4px dashed rgb(226 160 37 / 0.4); }
  .evp__facts dt { font-size: 11px; font-weight: 560; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .evp__facts dd { margin: 0; font-size: var(--step-0); color: var(--cream); display: grid; gap: 2px; }
  .evp__addr { color: var(--muted); font-size: 15px; }
  .evp__cta { margin-top: clamp(28px, 3vw, 40px); }
  .evp__in { max-width: 820px; }
  .evp__back { margin-top: clamp(36px, 4vw, 56px); padding-top: 24px; border-top: 1px solid var(--line-dark); }
  .evp__back .link { color: var(--ink); }
  @media (max-width: 620px) {
    .evp__facts { grid-template-columns: 1fr; }
    .evp__facts div + div { padding-left: 0; border-left: 0; }
  }
</style>
