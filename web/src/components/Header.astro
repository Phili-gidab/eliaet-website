---
import Logo from './Logo.astro'
import { NAV, ORG, CONTACT, SOCIAL, PRIMARY_NAV, SHORT_LABEL, FAMILY } from '../copy/site'

interface Props { path: string; overHero?: boolean }
const { path, overHero = false } = Astro.props
const PRIMARY = PRIMARY_NAV.map((to) => {
  const n = NAV.find((x) => x.to === to)!
  return { label: SHORT_LABEL[to] ?? n.label, to, note: to === '/members' ? String(ORG.members) : undefined }
})
const isActive = (to: string) => (to === '/' ? path === '/' : path === to || path.startsWith(to + '/'))
const social = SOCIAL.filter((s) => s.href)
const pad = (n: number) => String(n).padStart(2, '0')
---

<header class:list={['hdr', { 'hdr--hero': overHero }]} data-header>
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="ELIA home">
      <Logo class="hdr__lockup" />
    </a>
    <!-- ELIA's initiatives, beside its mark: their initials, and their full names on hover -->
    <nav class="hdr__fam" aria-label="ELIA’s initiatives">
      <ul role="list">
        {FAMILY.map((f) => (
          <li>
            <a href={f.to} aria-label={`${f.short}, ${f.name}`} aria-current={isActive(f.to) ? 'page' : undefined}>
              {f.short}<span class="hdr__tip" aria-hidden="true">{f.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="hdr__nav" aria-label="Main">
      <ul role="list">
        {PRIMARY.map((n) => (
          <li>
            <a href={n.to} aria-current={isActive(n.to) ? 'page' : undefined}>
              {n.label}{n.note && <sup>{n.note}</sup>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__end">
      <!-- "Member login", or "My account" once signed in (a small cookie the server sets says so; see members.ts) -->
      <a href="/members/login" class="hdr__cta" data-account>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M5 19.5c1.4-3.3 4-5 7-5s5.6 1.7 7 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
        <span data-account-label>Member login</span>
      </a>
      <button class="hdr__menu" type="button" aria-label="Menu" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
        <span class="hdr__menu-txt">Menu</span>
        <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu grain" id="menu" aria-label="Site menu" data-menu>
  <div class="menu__in wrap">
    <div class="menu__top">
      <a href="/" class="menu__logo" aria-label="ELIA home"><Logo /></a>
      <button class="menu__close" type="button" data-menu-close>
        <span>Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </div>
    <nav class="menu__nav" aria-label="All pages">
      <ol role="list">
        <li style="--i:0"><a href="/" aria-current={path === '/' ? 'page' : undefined}><span class="menu__n">00</span><span class="menu__t">Home</span></a></li>
        {NAV.map((n, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={n.to} aria-current={isActive(n.to) ? 'page' : undefined}>
              <span class="menu__n">{pad(i + 1)}</span>
              <span class="menu__t">{n.label}</span>
              {n.note && <span class="menu__am">{n.note}</span>}
            </a>
          </li>
        ))}
        <li style={`--i:${NAV.length + 1}`}><a href="/members#apply"><span class="menu__n">{pad(NAV.length + 1)}</span><span class="menu__t">Become a member</span></a></li>
        <li style={`--i:${NAV.length + 2}`}><a href="/members/login" data-account aria-current={path.startsWith('/members/') ? 'page' : undefined}><span class="menu__n">{pad(NAV.length + 2)}</span><span class="menu__t" data-account-label>Member login</span></a></li>
      </ol>
    </nav>
    <div class="menu__foot">
      <div>
        <p class="label"><b>Visit</b></p>
        <p>{CONTACT.address.lines.slice(0, 2).join(', ')}<br />{CONTACT.address.lines[3]}</p>
      </div>
      <div>
        <p class="label"><b>Call</b></p>
        <p>{CONTACT.phones.slice(0, 2).map((p) => <a href={p.href}>{p.value}</a>)}</p>
      </div>
      <div>
        <p class="label"><b>Write</b></p>
        <p><a href={`mailto:${CONTACT.emails[0].value}`}>{CONTACT.emails[0].value}</a></p>
      </div>
      {social.length > 0 && (
        <div>
          <p class="label"><b>Follow</b></p>
          <p>{social.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
        </div>
      )}
    </div>
  </div>
</dialog>

<style>
  /* a floating bar: a glass pill over the page, the links in it lit on hover like tabs */
  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 50; height: var(--header-h); padding-top: 14px; pointer-events: none;
    transition: transform 0.6s var(--ease);
  }
  .hdr__in {
    pointer-events: auto; position: relative; height: 58px; max-width: 1280px; padding: 0 8px 0 20px;
    --hgap: clamp(12px, 2vw, 28px);
    display: flex; align-items: center; gap: var(--hgap); border-radius: 999px;
    width: calc(100% - 2 * var(--gutter)); margin-inline: auto;
  }
  .hdr__in::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; transition: background 0.4s, box-shadow 0.4s;
    background: rgb(60 30 22 / 0.38); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.1), inset 0 1px 0 rgb(255 252 245 / 0.08);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
  }
  :global(.scrolled) .hdr__in::before { background: rgb(60 30 22 / 0.72); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.12), 0 20px 50px -20px rgb(60 30 22 / 0.8); }
  /* over a light section the bar turns to light glass (scripts/motion.ts sets data-hdr from the section under it) */
  :global([data-hdr='light']) .hdr__in::before { background: rgb(255 252 245 / 0.72); box-shadow: inset 0 0 0 1px rgb(60 30 22 / 0.1), 0 18px 40px -26px rgb(60 30 22 / 0.4); }
  :global([data-hdr='light'].scrolled) .hdr__in::before { background: rgb(255 252 245 / 0.86); }
  :global([data-hdr='light']) .hdr__logo { color: var(--ink); }
  :global([data-hdr='light']) .hdr__nav a { color: rgb(60 30 22 / 0.78); }
  :global([data-hdr='light']) .hdr__nav a:hover { color: var(--ink); background: rgb(60 30 22 / 0.06); }
  :global([data-hdr='light']) .hdr__nav a[aria-current] { color: var(--ink); background: rgb(60 30 22 / 0.07); box-shadow: inset 0 0 0 1px rgb(60 30 22 / 0.1); }
  :global([data-hdr='light']) .hdr__nav sup { color: var(--ink); background: rgb(226 160 37 / 0.28); }
  :global([data-hdr='light']) .hdr__menu { color: var(--ink); background: rgb(60 30 22 / 0.04); box-shadow: inset 0 0 0 1px rgb(60 30 22 / 0.14); }
  :global([data-hdr='light']) .hdr__menu:hover { background: rgb(60 30 22 / 0.08); }
  :global([data-hdr='light']) .hdr__burger { background: rgb(60 30 22 / 0.08); }
  .hdr__logo, .hdr__nav a, .hdr__menu { transition: color 0.4s, background 0.25s, box-shadow 0.4s; }
  :global(.hide-hdr) .hdr { transform: translateY(-120%); }
  .hdr__logo { display: block; color: var(--cream); flex: none; }
  .hdr__logo :global(.hdr__lockup) { width: clamp(92px, 8vw, 116px); }
  /* the initiatives: their initials in amber small capitals after a hairline beside the mark, and a name tag under
     the bar on hover */
  .hdr__fam { position: relative; flex: none; margin-left: calc(var(--hgap) * -0.4); }
  .hdr__fam::before {
    content: ''; position: absolute; left: calc(var(--hgap) * -0.3 - 1px); top: 50%; width: 1px; height: 20px; translate: 0 -50%;
    background: rgb(255 252 245 / 0.2); transition: background 0.4s;
  }
  .hdr__fam ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .hdr__fam a {
    position: relative; display: inline-flex; align-items: center; height: 34px; padding: 0 9px; border-radius: 999px;
    font-size: 11.5px; font-weight: 650; letter-spacing: 0.1em; color: var(--amber); transition: color 0.4s, background 0.25s;
  }
  .hdr__fam a:hover, .hdr__fam a:focus-visible { background: rgb(226 160 37 / 0.16); }
  .hdr__fam a[aria-current] { color: var(--ink); background: var(--amber); }
  .hdr__tip {
    position: absolute; left: 50%; top: calc(100% + 18px); translate: -50% -6px; white-space: nowrap; pointer-events: none;
    padding: 8px 14px; border-radius: 999px; font-size: 12.5px; font-weight: 500; letter-spacing: 0; color: var(--cream);
    background: rgb(60 30 22 / 0.92); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.12), 0 16px 34px -16px rgb(60 30 22 / 0.7);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    opacity: 0; transition: opacity 0.2s, translate 0.4s var(--ease);
  }
  .hdr__fam a:hover .hdr__tip, .hdr__fam a:focus-visible .hdr__tip { opacity: 1; translate: -50% 0; }
  :global([data-hdr='light']) .hdr__fam::before { background: rgb(60 30 22 / 0.2); }
  :global([data-hdr='light']) .hdr__fam a { color: var(--ink); }
  :global([data-hdr='light']) .hdr__fam a:hover, :global([data-hdr='light']) .hdr__fam a:focus-visible { background: rgb(226 160 37 / 0.3); }
  :global([data-hdr='light']) .hdr__fam a[aria-current] { background: var(--amber); }
  .hdr__nav { margin-inline: auto; }
  .hdr__nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a {
    position: relative; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px; border-radius: 999px; white-space: nowrap;
    font-size: 14px; font-weight: 500; letter-spacing: -0.005em; color: rgb(255 252 245 / 0.78);
    transition: color 0.25s, background 0.25s;
  }
  .hdr__nav a:hover { color: var(--cream); background: rgb(255 252 245 / 0.07); }
  .hdr__nav a[aria-current] { color: var(--cream); background: rgb(255 252 245 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.1); }
  .hdr__nav sup {
    font-family: var(--f-mono); font-weight: 520; font-size: 11px; color: var(--amber); letter-spacing: 0.02em; top: 0;
    padding: 2px 6px; border-radius: 999px; background: rgb(226 160 37 / 0.12);
  }
  .hdr__end { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .hdr__nav + .hdr__end { margin-left: 0; }
  .hdr__cta {
    display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px 0 14px; border-radius: 999px; white-space: nowrap;
    font-size: 14px; font-weight: 600; color: var(--ink); background: var(--amber);
    box-shadow: inset 0 1px 0 rgb(255 252 245 / 0.35), 0 8px 24px -10px rgb(226 160 37 / 0.6); transition: background 0.3s, transform 0.4s var(--spring);
  }
  .hdr__cta svg { width: 18px; height: 18px; flex: none; }
  .hdr__cta:hover { background: var(--amber-hi); }
  .hdr__cta:active { transform: scale(0.97); }
  .hdr__menu {
    display: inline-flex; align-items: center; gap: 10px; height: 42px; padding: 0 6px 0 14px; border-radius: 999px;
    font-size: 14px; font-weight: 500; background: rgb(255 252 245 / 0.07); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.12);
    transition: background 0.3s;
  }
  .hdr__menu:hover { background: rgb(255 252 245 / 0.12); }
  .hdr__burger { width: 30px; height: 30px; border-radius: 50%; display: grid; place-content: center; gap: 4px; background: rgb(255 252 245 / 0.1); }
  .hdr__burger i { display: block; width: 12px; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform 0.4s var(--ease); }
  .hdr__menu:hover .hdr__burger i:last-child { transform: translateX(3px); }
  @media (max-width: 1240px) {
    .hdr__nav { display: none; }
    .hdr__end, .hdr__nav + .hdr__end { margin-left: auto; }
  }
  @media (max-width: 560px) {
    .hdr__fam { display: none; }
    .hdr { padding-top: 10px; }
    .hdr__in { height: 54px; padding-left: 16px; }
    .hdr__cta { display: none; }
    .hdr__menu-txt { display: none; }
    .hdr__menu { padding: 0 6px; }
  }

  /* ── the menu ── */
  .menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--ink); color: var(--cream); overflow-y: auto; overscroll-behavior: contain;
  }
  .menu::backdrop { background: rgb(60 30 22 / 0.5); }
  .menu[open] { animation: menu-in 0.7s var(--ease) both; }
  .menu.closing { animation: menu-out 0.45s var(--ease-in-out) both; }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes menu-out { from { clip-path: inset(0 0 0 0); } to { clip-path: inset(0 0 100% 0); } }
  .menu__in { min-height: 100%; display: flex; flex-direction: column; padding-block: 18px 40px; }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: calc(var(--header-h) - 18px); }
  .menu__logo { width: 120px; color: var(--cream); }
  .menu__close {
    display: inline-flex; align-items: center; gap: 12px; height: 42px; padding: 0 8px 0 16px; border-radius: 999px;
    font-family: var(--f-mono); font-weight: 520; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.25);
  }
  .menu__close svg { width: 28px; height: 28px; padding: 6px; border-radius: 50%; background: rgb(255 252 245 / 0.1); }
  .menu__nav { margin-block: clamp(28px, 6vh, 72px) auto; }
  .menu__nav ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .menu__nav li { border-bottom: 1px solid var(--line); }
  .menu[open] .menu__nav li { animation: item-in 0.9s var(--ease) both; animation-delay: calc(0.12s + var(--i) * 0.035s); }
  @keyframes item-in { from { opacity: 0; transform: translateY(18px); } }
  .menu__nav a {
    display: grid; grid-template-columns: 4.2em 1fr auto; align-items: baseline; gap: 12px; padding: clamp(6px, 1.1vh, 12px) 0;
    transition: color 0.3s, padding 0.5s var(--ease);
  }
  .menu__n { font-family: var(--f-mono); font-weight: 520; font-size: 11px; color: var(--amber); letter-spacing: 0.06em; }
  .menu__t { font-family: var(--f-display); font-weight: 640; font-stretch: 78%; font-size: clamp(2rem, 5vh + 1rem, 4.4rem); line-height: 1; letter-spacing: -0.035em; }
  .menu__am { font-size: 14px; color: var(--muted); }
  .menu__nav a:hover { color: var(--amber); padding-left: 10px; }
  .menu__nav a[aria-current] .menu__t { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; letter-spacing: -0.01em; color: var(--amber); }
  .menu__foot {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; margin-top: 40px;
    font-size: 14px; color: var(--bone);
  }
  .menu__foot p + p { margin-top: 8px; }
  .menu__foot a { display: block; }
  .menu__foot a:hover { color: var(--amber); }
</style>
