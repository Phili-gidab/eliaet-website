---
import { ORG, CONTACT, SOCIAL, FOOTER_LINKS, EXTERNAL } from '../copy/site'
import { SUBSCRIBE } from '../copy/home'
interface Props { newsletter?: boolean }
const { newsletter = true } = Astro.props
const social = SOCIAL.filter((s) => s.href)
const year = new Date().getFullYear()
---

<footer class="ftr sheet lit" data-footer>
  <div class="wrap">
    {newsletter && (
      <>
        <div class="ftr__news">
          <div>
            <p class="label"><b>ዜና</b> Newsletter</p>
            <h2 class="h3 mt-s">{SUBSCRIBE.title}<em>.</em></h2>
            <p class="ftr__note">{SUBSCRIBE.text}</p>
          </div>
          <form class="ftr__form" action="/api/forms/subscribe" method="post" data-form="subscribe" novalidate>
            <label class="sr-only" for="ftr-email">E-mail address</label>
            <input id="ftr-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button class="btn" type="submit">Subscribe <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
            <p class="ftr__msg" role="status" aria-live="polite" data-form-msg></p>
          </form>
        </div>

        <div class="stitch ftr__stitch" aria-hidden="true"></div>
      </>
    )}

    <!-- the full lockup from the brand guide: the logo with the association's name in Amharic and English -->
    <a href="/" class="ftr__lockup">
      <img class="ftr__lockup-wide" src="/media/brand/elia-lockup-reverse.svg" alt={`ELIA, ${ORG.amharic}, ${ORG.name}`} width="1244" height="184" loading="lazy" decoding="async" />
      <img class="ftr__lockup-tall" src="/media/brand/elia-lockup-reverse-stacked.svg" alt={`ELIA, ${ORG.amharic}, ${ORG.name}`} width="640" height="286" loading="lazy" decoding="async" />
    </a>

    <div class="ftr__main">
      <div class="ftr__col">
        <p class="label"><b>01</b> Office</p>
        <address>
          {CONTACT.address.lines.map((l) => <span>{l}</span>)}
          <span>P.O. Box {CONTACT.poBox}</span>
        </address>
        <a class="link small" href={CONTACT.map.link} target="_blank" rel="noopener">Open in Maps</a>
      </div>
      <div class="ftr__col">
        <p class="label"><b>02</b> Contact</p>
        <ul role="list">
          {CONTACT.phones.map((p) => <li><a href={p.href}><span class="ftr__k">{p.label}</span>{p.value}</a></li>)}
          {CONTACT.emails.map((e) => <li><a href={`mailto:${e.value}`}><span class="ftr__k">{e.label}</span>{e.value}</a></li>)}
        </ul>
      </div>
      {Object.entries(FOOTER_LINKS).map(([title, links], i) => (
        <div class="ftr__col">
          <p class="label"><b>{String(i + 3).padStart(2, '0')}</b> {title}</p>
          <ul role="list">{links.map((l) => <li><a href={l.to}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>

  </div>

  <!-- the brand line, pressed into a strap of chestnut hide (styles/leather.css) -->
  <div class="ftr__strap hide hide--chestnut stitched" aria-hidden="true">
    <div class="wrap">
      <p class="ftr__giant"><span class="t-press">From the highlands,</span> <em class="t-press">to the world.</em></p>
    </div>
  </div>

  <div class="wrap">
    <div class="ftr__base">
      <p>© {year} {ORG.name}. All rights reserved.</p>
      <p class="ftr__links">
        <a href={EXTERNAL.shop} target="_blank" rel="noopener">Leathers of Ethiopia</a>
        <a href={EXTERNAL.aalfSite} target="_blank" rel="noopener">allafricanleatherfair.org</a>
        {social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--ink-1); color: var(--bone); padding-block: clamp(72px, 9vw, 128px) 36px; overflow: hidden; }
  /* the strap: a band of hide across the whole width, stitched along both edges, the line pressed into it */
  .ftr__strap {
    --stitch-in: 14px; margin-top: clamp(56px, 8vw, 120px); padding-block: clamp(44px, 6vw, 84px);
    --hide-veil: linear-gradient(180deg, rgb(255 220 180 / 0.05), transparent 40%, rgb(0 0 0 / 0.18));
    box-shadow: inset 0 1px 0 rgb(255 230 200 / 0.08), inset 0 -1px 0 rgb(0 0 0 / 0.4), 0 -1px 0 rgb(0 0 0 / 0.35);
  }
  .ftr__strap::before { inset: var(--stitch-in) -4px; border-inline: 0; }
  .ftr__giant {
    font-family: var(--f-display); font-weight: 800; font-stretch: 75%; letter-spacing: -0.03em;
    word-spacing: 0.04em; line-height: 0.95; font-size: clamp(2.8rem, 7.3vw, 6.5rem); white-space: nowrap;
  }
  .ftr__giant em { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; letter-spacing: -0.03em; }
  @media (max-width: 760px) { .ftr__giant { white-space: normal; font-size: clamp(2.8rem, 15vw, 5rem); line-height: 1.02; } }
  .ftr__news { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 6vw, 96px); align-items: end; }
  .ftr__news .h3 { color: var(--cream); max-width: 16ch; }
  .ftr__note { margin-top: 16px; max-width: 44ch; color: var(--muted); }
  .ftr__form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; position: relative; }
  .ftr__form input[type='email'] {
    height: 56px; padding: 0 22px; border-radius: 999px; border: 0; background: rgb(255 252 245 / 0.05); color: var(--cream);
    box-shadow: inset 0 0 0 1px var(--line-2); font-size: 16px; transition: box-shadow 0.25s, background 0.25s;
  }
  .ftr__form input[type='email']:focus { outline: none; background: rgb(255 252 245 / 0.08); box-shadow: inset 0 0 0 1px rgb(226 160 37 / 0.7), 0 0 0 4px rgb(226 160 37 / 0.12); }
  .ftr__form input::placeholder { color: rgb(255 252 245 / 0.38); }
  .ftr__form .btn { min-height: 56px; }
  .ftr__msg { grid-column: 1 / -1; min-height: 1.4em; font-size: 14px; color: var(--amber); padding-left: 22px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .ftr__stitch { margin-block: clamp(48px, 7vw, 88px) clamp(40px, 5vw, 64px); }
  .ftr__lockup { display: block; width: min(100%, 880px); margin-bottom: clamp(44px, 5vw, 72px); }
  .ftr__lockup img { width: 100%; height: auto; }
  .ftr__lockup-tall { display: none; }
  @media (max-width: 700px) {
    .ftr__lockup { width: min(100%, 420px); }
    .ftr__lockup-wide { display: none; }
    .ftr__lockup-tall { display: block; }
  }
  .ftr__main { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 28px; }
  .ftr__col { font-size: 14.5px; line-height: 1.55; }
  .ftr__col .label { margin-bottom: 16px; }
  .ftr__col address { font-style: normal; display: grid; margin-bottom: 12px; }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .ftr__col a:hover { color: var(--amber); }
  .ftr__k { display: block; font-family: var(--f-mono); font-weight: 520; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ftr__base { margin-top: 26px; padding-top: 0; display: flex; flex-wrap: wrap; gap: 10px 32px; font-size: 13px; color: var(--muted); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 18px; margin-left: auto; }
  .ftr__links a:hover { color: var(--amber); }
  @media (max-width: 1080px) {
    .ftr__main { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .ftr__news { grid-template-columns: 1fr; }
    .ftr__form { grid-template-columns: 1fr; }
    .ftr__links { margin-left: 0; }
  }
  @media (max-width: 480px) {
    .ftr__main { grid-template-columns: 1fr; }
  }
</style>
