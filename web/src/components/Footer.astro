---
import { ORG, CONTACT, SOCIAL, FOOTER_LINKS, EXTERNAL } from '../copy/site'
import { SUBSCRIBE } from '../copy/home'
interface Props { newsletter?: boolean }
const { newsletter = true } = Astro.props
const social = SOCIAL.filter((s) => s.href)
const year = new Date().getFullYear()
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>'
---

<!-- the footer, on the brand brown: the newsletter, the association's lockup with the two ways in (join, write), its
     address and links in four columns, and, set large across the whole width as its signature, the last words of
     ELIA's 2026 profile (the brand line itself heads the home page) -->
<footer class="ftr sheet" data-footer data-tone="dark">
  <div class="wrap">
    {newsletter && (
      <div class="ftr__news">
        <div>
          <h2 class="ftr__title">{SUBSCRIBE.title.replace(/ updates$/, '')} <em>updates</em>.</h2>
          <p class="ftr__note">{SUBSCRIBE.text}</p>
        </div>
        <form class="ftr__form" action="/api/forms/subscribe" method="post" data-form="subscribe" data-ok="Thank you. You are subscribed; a confirmation is on its way to your inbox." novalidate>
          <div class="ftr__field">
            <label class="sr-only" for="ftr-email">E-mail address</label>
            <input id="ftr-email" name="email" type="email" autocomplete="email" required placeholder="Your e-mail address" />
            <input class="hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button class="btn" type="submit">Subscribe <Fragment set:html={arrow} /></button>
          </div>
          <p class="ftr__msg" role="status" aria-live="polite" data-form-msg></p>
        </form>
      </div>
    )}

    <div class="ftr__top">
      <!-- the full lockup from the brand guide: the logo with the association's name in Amharic and English -->
      <a href="/" class="ftr__lockup">
        <img class="ftr__lockup-wide" src="/media/brand/elia-lockup-reverse.svg" alt={`ELIA, ${ORG.amharic}, ${ORG.name}`} width="1244" height="184" loading="lazy" decoding="async" />
        <img class="ftr__lockup-tall" src="/media/brand/elia-lockup-reverse-stacked.svg" alt={`ELIA, ${ORG.amharic}, ${ORG.name}`} width="640" height="286" loading="lazy" decoding="async" />
      </a>
      <div class="ftr__cta">
        <a class="btn" href="/members#apply">Become a member <Fragment set:html={arrow} /></a>
        <a class="btn btn--ghost" href="/contact">Write to the secretariat</a>
      </div>
    </div>

    <div class="ftr__main">
      <div class="ftr__col">
        <p class="ftr__h">Office</p>
        <address>
          {CONTACT.address.lines.map((l) => <span>{l}</span>)}
          <span>P.O. Box {CONTACT.poBox}</span>
        </address>
        <a class="ftr__more" href={CONTACT.map.link} target="_blank" rel="noopener">Open in Maps <Fragment set:html={arrow} /></a>
      </div>
      <div class="ftr__col">
        <p class="ftr__h">Contact</p>
        <ul role="list">
          {CONTACT.phones.map((p) => <li><a href={p.href}>{p.value}</a></li>)}
          {CONTACT.emails.map((e) => <li><a href={`mailto:${e.value}`}><span class="ftr__k">{e.label}</span>{e.value}</a></li>)}
        </ul>
      </div>
      {Object.entries(FOOTER_LINKS).map(([title, links]) => (
        <div class="ftr__col">
          <p class="ftr__h">{title}</p>
          <ul role="list">{links.map((l) => <li><a href={l.to}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </div>

  <!-- the signature, as large as the page is wide: three short invitations, the first in the grain of tan leather -->
  <p class="ftr__sign"><span class="ftr__s1">Meet us.</span> <span class="ftr__s2">Source from us.</span> <span class="ftr__s3">Invest with us.</span></p>

  <div class="wrap">
    <div class="ftr__base">
      <p>© {year} {ORG.name}. All rights reserved.</p>
      <p class="ftr__links">
        <a href={EXTERNAL.shop} target="_blank" rel="noopener">Leathers of Ethiopia</a>
        <a href={EXTERNAL.aalfSite} target="_blank" rel="noopener">allafricanleatherfair.org</a>
        {social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--ink); color: var(--bone); padding-block: clamp(80px, 9vw, 132px) 30px; overflow: hidden; }
  .ftr.sheet { box-shadow: none; }

  /* the newsletter: a big line to the left, one long field to write on to the right */
  .ftr__news {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px clamp(28px, 6vw, 96px); align-items: end;
    padding-bottom: clamp(48px, 6vw, 84px); margin-bottom: clamp(48px, 6vw, 84px); border-bottom: 1px solid rgb(255 252 245 / 0.14);
  }
  .ftr__title {
    max-width: 12ch; color: var(--cream); font-family: var(--f-display); font-weight: 760; font-stretch: 80%;
    font-size: clamp(2.4rem, 1.4rem + 3.2vw, 4.4rem); line-height: 0.95; letter-spacing: -0.035em;
  }
  .ftr__title em { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; color: var(--amber); letter-spacing: -0.03em; }
  .ftr__note { margin-top: 18px; max-width: 44ch; color: rgb(255 252 245 / 0.66); font-size: 15.5px; }
  .ftr__form { display: grid; gap: 14px; }
  .ftr__field {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14px;
    padding: 8px 8px 8px 24px; border-radius: 999px; background: rgb(255 252 245 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.16); transition: box-shadow 0.3s;
  }
  .ftr__field:focus-within { box-shadow: inset 0 0 0 1.5px var(--amber), 0 0 0 4px rgb(226 160 37 / 0.16); }
  .ftr__field input[type='email'] {
    min-width: 0; height: 48px; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--cream);
    font-size: 17px; letter-spacing: -0.005em;
  }
  .ftr__field input[type='email']:focus { outline: none; }
  .ftr__field input::placeholder { color: rgb(255 252 245 / 0.42); }
  .ftr__field .btn { min-height: 48px; }
  .ftr__field .btn :global(svg), .ftr__cta .btn :global(svg) { width: 18px; height: 18px; margin-left: 2px; }
  .ftr__msg { min-height: 1.4em; padding-left: 24px; font-size: 14px; color: var(--amber); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* the lockup, and the two ways in beside it */
  .ftr__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px 40px; margin-bottom: clamp(44px, 5vw, 72px); }
  .ftr__lockup { display: block; width: min(100%, 640px); }
  .ftr__lockup img { width: 100%; height: auto; }
  .ftr__lockup-tall { display: none; }
  .ftr__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* four columns, each under a small amber heading */
  .ftr__main { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 28px; padding-top: 28px; border-top: 1px solid rgb(255 252 245 / 0.14); }
  .ftr__col { font-size: 15px; line-height: 1.55; }
  .ftr__h { margin: 0 0 16px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber); }
  .ftr__col address { font-style: normal; display: grid; margin-bottom: 14px; color: rgb(255 252 245 / 0.82); }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ftr__col a { color: rgb(255 252 245 / 0.82); transition: color 0.25s; }
  .ftr__col a:hover { color: var(--amber); }
  .ftr__k { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 252 245 / 0.5); }
  .ftr__more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--cream) !important; }
  .ftr__more :global(svg) { width: 16px; height: 16px; transition: transform 0.4s var(--ease); }
  .ftr__more:hover :global(svg) { transform: translateX(4px); }

  /* the signature across the whole width: "Meet us." cut from tan leather, "Source from us." in a light italic,
     "Invest with us." drawn in amber outline */
  .ftr__sign {
    margin: clamp(64px, 8vw, 120px) 0 0; padding-inline: 2vw; white-space: nowrap; text-align: center;
    font-family: var(--f-display); font-weight: 800; font-stretch: 75%; letter-spacing: -0.04em; line-height: 0.9;
    font-size: 6.5vw; user-select: none;
  }
  .ftr__s1 {
    color: var(--amber); background: url('/media/leather/tan.webp') 30% 40% / 640px auto, var(--amber); background-blend-mode: soft-light;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .ftr__s2 { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; letter-spacing: -0.03em; color: rgb(255 252 245 / 0.92); }
  .ftr__s3 { color: transparent; -webkit-text-stroke: max(1.2px, 0.022em) var(--amber); paint-order: stroke; }
  @media (forced-colors: active) { .ftr__s3 { color: CanvasText; -webkit-text-stroke: 0; } }

  .ftr__base {
    display: flex; flex-wrap: wrap; gap: 10px 32px; margin-top: clamp(28px, 3vw, 44px); padding-top: 22px;
    border-top: 1px solid rgb(255 252 245 / 0.14); font-size: 13px; color: rgb(255 252 245 / 0.6);
  }
  .ftr__base p { margin: 0; }
  .ftr__base .ftr__links { display: flex; flex-wrap: wrap; gap: 18px; margin-left: auto; }
  .ftr__links a:hover { color: var(--amber); }

  @media (max-width: 1080px) {
    .ftr__main { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .ftr__news { grid-template-columns: 1fr; }
    .ftr__base .ftr__links { margin-left: 0; }
    .ftr__sign { white-space: normal; font-size: 13vw; line-height: 0.92; text-align: left; padding-inline: var(--gutter); }
    .ftr__s1, .ftr__s2, .ftr__s3 { display: block; }
  }
  @media (max-width: 700px) {
    .ftr__lockup { width: min(100%, 360px); }
    .ftr__lockup-wide { display: none; }
    .ftr__lockup-tall { display: block; }
  }
  @media (max-width: 480px) {
    .ftr__main { grid-template-columns: 1fr; }
    .ftr__field { padding-left: 18px; }
    .ftr__field .btn { padding-inline: 16px; }
  }
</style>
