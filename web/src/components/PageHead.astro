---
/* The top of every inner page: stamped label, a display title that rises in line by line, a lede, and
   optionally a picture or a film beside it. */
import { responsive } from '../lib/media'
import Film from './Film.astro'
interface Props {
  index?: string
  eyebrow: string
  amharic?: string
  title: string[]
  lede?: string
  image?: string
  imageAlt?: string
  /** a film beside the title instead of a picture. Its frame is tall (4:5) beside the title and wide (16:11) above
      it on narrow screens, which are mostly phones held upright: so `phone`, the film's wide cut, is given to the
      Film as its "tall" rendition (the one it plays on upright screens), and the tall cut plays everywhere else */
  film?: {
    base: string; sizes: number[]; poster: string; label: string; start?: number; rate?: number; bg?: string
    phone?: { base: string; sizes: number[]; poster: string }
  }
  /** the page colour's light grey-taupe by default (the brand guide's taupe 20), or the page colour, or brown */
  tone?: 'dark' | 'paper' | 'mist'
}
const { index = '01', eyebrow, amharic, title, lede, image, imageAlt = '', film, tone = 'mist' } = Astro.props
---

<section class:list={['ph', tone === 'dark' ? 'lit' : 'sec--paper', { 'sec--mist': tone === 'mist', 'ph--img': image || film }]} data-tone={tone === 'dark' ? 'dark' : 'light'}>
  <div class="ph__in wrap">
    <div class="ph__text">
      <p class="label label--rule" data-reveal="fade"><b>{index}</b> {eyebrow}{amharic && <span class="geez" lang="am">{amharic}</span>}</p>
      <h1 class="h1 lines ph__title">
        {/* a space between the lines, so the heading reads as words (to search engines, screen readers, a copy) */}
        {title.map((t, i) => <Fragment><span class="ln" style={`--i:${i}`}><span set:html={t} /></span>{i < title.length - 1 && ' '}</Fragment>)}
      </h1>
      {lede && <p class="lede ph__lede" data-reveal style="--d:.25s">{lede}</p>}
      <slot />
    </div>
    {image && (
      <div class="ph__media frame" data-reveal="mask" style="--d:.15s">
        <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" decoding="async" {...responsive(image, '(max-width: 900px) 92vw, 520px')} />
      </div>
    )}
    {film && !image && (
      <div class="ph__media frame" data-reveal="mask" style={`--d:.15s;--film-bg:${film.bg ?? 'var(--hide)'}`}>
        <Film class="ph__film" wide={{ base: film.base, sizes: film.sizes }} poster={film.poster} label={film.label} formats="vp9,h264"
          tall={film.phone && { base: film.phone.base, sizes: film.phone.sizes }} posterTall={film.phone?.poster}
          loop={false} toggle={false} posterLoading="lazy" posterWhen="still" start={film.start} rate={film.rate} />
      </div>
    )}
  </div>
  <div class="ph__stitch wrap" aria-hidden="true"><div class="stitch"></div></div>
</section>
<script is:inline>
  /* the top of the page rises in as soon as it is first painted, without waiting for the page's script to arrive */
  (function (s) { if (s) requestAnimationFrame(function () { requestAnimationFrame(function () { s.querySelectorAll('[data-reveal], .lines').forEach(function (e) { e.classList.add('in') }) }) }) })(document.currentScript && document.currentScript.previousElementSibling)
</script>

<style>
  .ph { position: relative; padding-top: calc(var(--header-h) + clamp(56px, 9vw, 140px)); padding-bottom: clamp(40px, 5vw, 72px); background: var(--ink); }
  .ph.sec--paper { background: var(--paper); }
  .ph.sec--paper.sec--mist { background: var(--mist); }
  .ph__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 88px); align-items: end; }
  .ph--img .ph__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  .ph__title { margin-top: 26px; max-width: 16ch; }
  .ph__lede { margin-top: 28px; max-width: 46ch; }
  .ph__media { aspect-ratio: 4 / 5; max-height: 72vh; box-shadow: inset 0 0 0 1px var(--line), 0 40px 80px -40px rgb(0 0 0 / 0.9); }
  .ph.sec--paper .ph__media { box-shadow: 0 40px 80px -46px rgb(60 30 22 / 0.5); }
  .ph__media :global(.ph__film) { position: absolute; inset: 0; }
  .ph__stitch { margin-top: clamp(48px, 7vw, 96px); }
  /* on a light page head, what a page sets into it (an address, a note, tabs, a list, written for the dark) takes
     the dark ink: the colours it is drawn in are turned round here; the fair's leather ticket keeps its own */
  .ph.sec--paper .ph__text { --cream: var(--brand-brown); --bone: var(--brown-80); --muted: #66544e; --line: rgb(60 30 22 / 0.14); --line-2: rgb(60 30 22 / 0.22); }
  .ph.sec--paper .ph__text :global(.ticket) { --cream: #fffcf5; --bone: #d3cccb; --muted: #bdb3b1; --line: rgb(255 252 245 / 0.1); --line-2: rgb(255 252 245 / 0.18); }
  .ph.sec--paper :global(.ph-note a) { color: var(--brand-brown); text-decoration-color: rgb(60 30 22 / 0.4); }
  .ph.sec--paper :global(.toc__n) { color: #66544e; }
  .ph.sec--paper :global(.ntab:hover) { background: rgb(60 30 22 / 0.06); }
  @media (max-width: 900px) {
    .ph--img .ph__in { grid-template-columns: 1fr; }
    .ph__media { aspect-ratio: 16 / 11; }
  }
</style>
