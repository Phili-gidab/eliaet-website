---
/* The home page's opening: the film of a tannery at work, inside and out, with its copy played in step.
   The film is the clock (scripts/story.ts): each chapter's words come in at their moment in the film and leave
   before the next; the last chapter (the page's h1, the buttons) stays on the film's final frame.
   As the page scrolls on, the film steps back into a panel and the next section slides over it. */
import Film from './Film.astro'
import { STORY, HERO } from '../copy/home'
import { ORG } from '../copy/site'
import { AALF_2026 } from '../copy/aalf'

const words = (html: string) =>
  html
    .split(/(<em>.*?<\/em>)/)
    .flatMap((part) =>
      part.startsWith('<em>')
        ? [`<span class="w"><em>${part.slice(4, -5)}</em></span>`]
        : part.split(/\s+/).filter(Boolean).map((w) => `<span class="w">${w}</span>`),
    )
    .map((w, i) => w.replace('class="w"', `class="w" style="--i:${i}"`))
    .join(' ')
const pad = (n: number) => String(n).padStart(2, '0')
const beats = JSON.stringify({
  end: STORY.end,
  chapters: [...STORY.chapters.map((c) => ({ id: c.id, t0: c.t0, t1: c.t1, in: c.in, out: c.out })),
             { id: STORY.final.id, t0: STORY.final.t0, t1: STORY.end, in: STORY.final.in, out: null }],
})
const finalTitle = HERO.title.join(' ').replace('to the world.', '<em>to the world.</em>')
---

<section class="story" aria-labelledby="story-title" data-story data-beats={beats}>
  <div class="story__stage" data-story-stage>
    <Film
      class="story__film"
      manual
      toggle={false}
      loop={false}
      formats="av1,vp9,h264"
      wide={{ base: '/film/tannery', sizes: [960, 1600] }}
      tall={{ base: '/film/tannery-m', sizes: [540, 720] }}
      poster="/film/tannery-start-1600.webp"
      posterTall="/film/tannery-m-start-720.webp"
      label="A film of a tannery at work: drums turning, hides moving through the machines and over an overhead conveyor, a table of finished leather goods, then out through the loading door to the tannery's yard in the Ethiopian highlands."
    />
    <picture class="story__end" aria-hidden="true">
      <source media="(orientation: portrait) and (max-width: 900px)" srcset="/film/tannery-m-end-720.webp" />
      <img src="/film/tannery-end-1600.webp" alt="" decoding="async" />
    </picture>
    <div class="story__shade" aria-hidden="true"></div>

    <div class="story__copy wrap">
      {STORY.chapters.map((c, i) => (
        <article class="ch" data-ch={c.id} aria-hidden="true">
          <p class="label ch__label"><b>{pad(i + 1)}</b> {c.label}{c.amharic && <span class="geez" lang="am">{c.amharic}</span>}</p>
          <p class="ch__title" set:html={words(c.title)} />
          <p class="ch__line">{c.line}</p>
        </article>
      ))}
      <article class="ch ch--final" data-ch={STORY.final.id}>
        <p class="pill ch__pill"><i></i>{ORG.name} <span class="geez" lang="am">{ORG.amharic}</span></p>
        <h1 class="ch__title ch__title--final" id="story-title" set:html={words(finalTitle)} />
        <p class="ch__line ch__lede">{HERO.lede}</p>
        <div class="row ch__ctas">
          <a class="btn" href="/members">Meet the members <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" /></svg></a>
          <a class="btn btn--ghost" href="/aalf">AALF 2026<span class="ch__dates"> · {AALF_2026.dates}</span></a>
        </div>
      </article>
    </div>

    <nav class="rail wrap" aria-label="Chapters of the film">
      <ol role="list" class="rail__list">
        {[...STORY.chapters, { id: STORY.final.id, label: STORY.final.label }].map((c, i) => (
          <li>
            <button type="button" class="rail__seg" data-seek={c.id}>
              <span class="rail__lbl"><b>{pad(i + 1)}</b> {c.label}</span>
              <span class="rail__bar"><i></i></span>
            </button>
          </li>
        ))}
      </ol>
      <button type="button" class="rail__btn" data-story-toggle aria-label="Pause the film" aria-pressed="false">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.5v13M15.5 5.5v13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
        <svg class="i-replay" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12a7 7 0 1 0 2.05-4.95M5 4.5V8h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </nav>
  </div>
</section>

<style>
  .story { position: relative; height: 130svh; background: var(--ink); }
  .story__stage {
    position: sticky; top: 0; height: 100svh; overflow: hidden; color: var(--cream); isolation: isolate;
    transform-origin: 50% 0; will-change: transform;
    transform: scale(calc(1 - var(--away, 0) * 0.07)); border-radius: calc(var(--away, 0) * 36px);
  }
  .story__stage::after {
    content: ''; position: absolute; inset: 0; z-index: 6; pointer-events: none; background: #000; opacity: calc(var(--away, 0) * 0.55);
  }
  .story :global(.story__film) { position: absolute; inset: 0; z-index: 0; }
  .story__end { position: absolute; inset: 0; z-index: 1; opacity: 0; transition: opacity 1.2s var(--ease); }
  .story__end img { width: 100%; height: 100%; object-fit: cover; }
  .story.is-end .story__end { opacity: 1; }
  .story__shade {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(180deg, rgb(12 9 7 / 0.55) 0%, rgb(12 9 7 / 0) 20%),
      linear-gradient(0deg, rgb(12 9 7 / 0.92) 0%, rgb(12 9 7 / 0.6) 22%, rgb(12 9 7 / 0) 50%),
      radial-gradient(110% 85% at 0% 100%, rgb(12 9 7 / 0.72), transparent 66%);
  }

  /* the chapters share one place, bottom left, above the rail */
  .story__copy {
    position: absolute; inset: auto 0 0; z-index: 3; display: grid; padding-bottom: clamp(108px, 15vh, 156px);
  }
  .ch { grid-area: 1 / 1; align-self: end; max-width: min(820px, 92vw); pointer-events: none; }
  .ch.on { pointer-events: auto; }
  .ch__label { margin-bottom: 18px; text-shadow: 0 1px 12px rgb(0 0 0 / 0.6); }
  .ch__line { text-shadow: 0 1px 18px rgb(0 0 0 / 0.5); }
  .ch__title {
    font-family: var(--f-display); font-weight: 640; font-stretch: 80%; letter-spacing: -0.026em; line-height: 0.88;
    font-size: clamp(3rem, 1.2rem + 6.2vw, 7.6rem); text-wrap: balance; text-shadow: 0 2px 40px rgb(0 0 0 / 0.35);
  }
  .ch__title :global(em) { font-family: var(--f-serif); font-style: italic; font-weight: 400; font-stretch: normal; letter-spacing: -0.02em; color: var(--amber); }
  .ch__title--final { font-size: clamp(3.2rem, 1.2rem + 7vw, 8.6rem); }
  .ch__line { margin-top: 20px; max-width: 46ch; font-size: var(--step-1); line-height: 1.45; color: rgb(245 236 223 / 0.84); text-wrap: pretty; }
  .ch__pill { margin-bottom: 22px; }
  .ch__ctas { margin-top: 30px; }

  /* the motion: words rise out of a blur as their chapter comes in, and lift away as it leaves */
  .ch :global(.w) { display: inline-block; }
  :global(.js) .ch .ch__label, :global(.js) .ch .ch__line, :global(.js) .ch .ch__ctas, :global(.js) .ch .ch__pill { opacity: 0; transform: translateY(12px); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease); }
  :global(.js) .ch :global(.w) {
    opacity: 0; transform: translateY(0.42em); filter: blur(12px);
    transition: opacity 0.55s var(--ease), transform 0.8s var(--ease), filter 0.6s var(--ease);
    transition-delay: calc(var(--i) * 0.035s);
  }
  :global(.js) .ch.on .ch__label { opacity: 1; transform: none; transition-delay: 0s; }
  :global(.js) .ch.on :global(.w) { opacity: 1; transform: none; filter: none; transition-delay: calc(0.12s + var(--i) * 0.06s); transition-duration: 0.9s, 1.1s, 0.9s; }
  :global(.js) .ch.on .ch__line, :global(.js) .ch.on .ch__pill { opacity: 1; transform: none; transition-delay: 0.55s; }
  :global(.js) .ch.on .ch__ctas { opacity: 1; transform: none; transition-delay: 0.8s; }
  :global(.js) .ch.gone :global(.w) { opacity: 0; transform: translateY(-0.3em); filter: blur(10px); transition-delay: calc(var(--i) * 0.02s); }
  :global(.js) .ch.gone .ch__label, :global(.js) .ch.gone .ch__line { opacity: 0; transform: translateY(-8px); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ch :global(.w), :global(.js) .ch .ch__label, :global(.js) .ch .ch__line, :global(.js) .ch .ch__ctas, :global(.js) .ch .ch__pill { transition: opacity 0.4s linear; transform: none; filter: none; }
  }
  /* without the script the last chapter simply stands */
  :global(html:not(.js)) .ch:not(.ch--final) { display: none; }

  /* the rail: one segment per chapter; each fills with its part of the film; a click goes there */
  .rail { position: absolute; left: 0; right: 0; bottom: clamp(22px, 4vh, 40px); z-index: 4; display: flex; align-items: center; gap: 14px; margin-inline: auto; }
  .rail__list { flex: 1; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .rail__seg { display: grid; gap: 10px; width: 100%; text-align: left; padding: 8px 0; }
  .rail__lbl { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(245 236 223 / 0.5); transition: color 0.4s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail__lbl b { color: rgb(246 183 75 / 0.6); font-weight: 500; margin-right: 6px; transition: color 0.4s; }
  .rail__bar { position: relative; display: block; height: 2px; border-radius: 2px; background: rgb(255 240 220 / 0.18); overflow: hidden; }
  .rail__bar i { position: absolute; inset: 0; background: var(--amber); transform-origin: left; transform: scaleX(var(--p, 0)); box-shadow: 0 0 12px var(--amber); }
  .rail__seg:hover .rail__lbl, .rail__seg.on .rail__lbl { color: var(--cream); }
  .rail__seg.on .rail__lbl b { color: var(--amber); }
  .rail__btn {
    flex: none; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; color: var(--cream);
    background: rgb(20 15 12 / 0.45); box-shadow: inset 0 0 0 1px rgb(255 236 210 / 0.18); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: background 0.25s, transform 0.4s var(--spring);
  }
  .rail__btn:hover { background: rgb(20 15 12 / 0.7); transform: scale(1.06); }
  .rail__btn svg { width: 18px; height: 18px; grid-area: 1 / 1; }
  .rail__btn .i-play, .rail__btn .i-replay { display: none; }
  .story[data-state='paused'] .rail__btn .i-pause { display: none; }
  .story[data-state='paused'] .rail__btn .i-play { display: block; }
  .story.is-end .rail__btn .i-pause, .story.is-end .rail__btn .i-play { display: none; }
  .story.is-end .rail__btn .i-replay { display: block; }

  /* the brand film plays first on a first visit: everything waits behind it */
  :global(.intro-on) .story__copy, :global(.intro-on) .rail { opacity: 0; }
  .story__copy, .rail { transition: opacity 1s var(--ease); }

  @media (max-width: 900px) and (orientation: portrait) {
    .story__shade {
      background:
        linear-gradient(180deg, rgb(12 9 7 / 0.7) 0%, rgb(12 9 7 / 0) 22%),
        linear-gradient(0deg, rgb(12 9 7 / 0.95) 0%, rgb(12 9 7 / 0.75) 30%, rgb(12 9 7 / 0) 58%);
    }
    .story__copy { padding-bottom: 96px; }
    .ch__title { font-size: clamp(2.7rem, 12vw, 4.2rem); }
    .ch__title--final { font-size: clamp(2.9rem, 13vw, 4.6rem); }
    .ch__line { font-size: 1rem; margin-top: 14px; }
    .ch__pill .geez { display: none; }
    .ch__dates { display: none; }
    .rail__lbl { display: none; }
    .rail__list { gap: 6px; }
  }
  @media (max-width: 560px) {
    .ch__ctas { flex-wrap: nowrap; gap: 8px; }
    .ch__ctas :global(.btn) { padding-inline: 16px; font-size: 14px; }
  }
</style>

<script>
  import '../scripts/story'
</script>
