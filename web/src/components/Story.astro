---
/* The home page's opening. It starts on the page colour with the ELIA mark cut out of it: through the mark, the
   film of a tannery at work. Once the logo has drawn itself the page zooms on its own through the mark's dot until the
   film fills the screen (the door, scripts/story.ts; scrolling does the same, and takes over); the film then plays on
   with its copy in step. The film is the clock: each chapter's words come
   in at their moment and leave before the next; the last chapter (the page's h1, the buttons) stays on the film's
   final frame, which never stands still: it drifts, follows the pointer, and its chimney keeps smoking.
   As the page scrolls on, the film is held where it is and the next section slides up over it, as everywhere else.
   Without the script, or for less motion, there is no door: the film's last frame and the last chapter. */
import Film from './Film.astro'
import { STORY, HERO, PINS } from '../copy/home'
import { ORG } from '../copy/site'
import { AALF_2026 } from '../copy/aalf'
import { ETHIOPIA, ETHIOPIA_START } from '../brand/ethiopia'

const words = (html: string) =>
  html
    .split(/(<em>.*?<\/em>)/)
    .flatMap((part) =>
      part.startsWith('<em>')
        ? [`<span class="w"><em>${part.slice(4, -5)}</em></span>`]
        : part.split(/\s+/).filter(Boolean).map((w) => `<span class="w">${w}</span>`),
    )
    .map((w, i) => w.replace('class="w"', `class="w" style="--i:${i}"`))
    .join(' ')
const pad = (n: number) => String(n).padStart(2, '0')
const beats = JSON.stringify({
  end: STORY.end,
  chapters: [...STORY.chapters.map((c) => ({ id: c.id, t0: c.t0, t1: c.t1, in: c.in, out: c.out })),
             { id: STORY.final.id, t0: STORY.final.t0, t1: STORY.end, in: STORY.final.in, out: null }],
})
const finalTitle = HERO.title.join(' ').replace('to the world.', '<em>to the world.</em>')
---

<script is:inline>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.hdr = 'light'
</script>
<section class="story" aria-labelledby="story-title" data-story data-beats={beats} data-tone="dark">
  <div class="story__stage" data-story-stage>
    <!-- the film and what rides on it: under the door until it opens -->
    <div class="story__view" data-story-view>
      <Film
        class="story__film"
        manual
        toggle={false}
        loop={false}
        formats="av1,vp9,h264"
        wide={{ base: '/film/tannery', sizes: [960, 1600] }}
        tall={{ base: '/film/tannery-m', sizes: [540, 720] }}
        poster="/film/tannery-start-1600.webp"
        posterTall="/film/tannery-m-start-720.webp"
        label="A film of a tannery at work: drums turning, hides moving through the machines and over an overhead conveyor, a table of finished leather goods, then out through the loading door to the tannery's yard in the Ethiopian highlands."
      />
      <picture class="story__end" aria-hidden="true">
        <source media="(orientation: portrait) and (max-width: 900px)" srcset="/film/tannery-m-end-720.webp" />
        <img src="/film/tannery-end-1600.webp" alt="" decoding="async" fetchpriority="low" />
      </picture>
      <canvas class="story__smoke" data-smoke aria-hidden="true"></canvas>
      <div class="story__shade" aria-hidden="true"></div>

      <div class="story__pins" aria-hidden="true" data-pins="/film/pins.json">
        {PINS.map((p) => (
          <div class="pin" data-pin={p.id}>
            <i class="pin__dot"></i>
            <span class="pin__stem"></span>
            <span class="pin__tag">{p.n && <b>{p.n}</b>}{p.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- the door: the page colour with the ELIA lockup set into it and the film inside the mark, drawn on the graphics
         card (scripts/door-gl.ts); over it, for the opening only, the outline of Ethiopia the brand film starts from -->
    <canvas class="story__door" data-door aria-hidden="true"></canvas>
    <svg class="story__outline" data-door-outline aria-hidden="true" focusable="false">
      <g data-outline-g>
        <path class="story__outline-path" d={ETHIOPIA} pathLength="1" />
        <circle class="story__outline-dot" cx={ETHIOPIA_START.x} cy={ETHIOPIA_START.y} r="5.2" />
      </g>
    </svg>
    <div class="story__hello wrap" data-door-text aria-hidden="true">
      <p class="story__name"><span>Ethiopian Leather</span> <span>Industries Association</span></p>
      <p class="story__amh geez" lang="am">{ORG.amharic}</p>
    </div>

    <div class="story__copy wrap">
      {STORY.chapters.map((c, i) => (
        <article class="ch" data-ch={c.id} aria-hidden="true">
          <p class="label ch__label"><b>{pad(i + 1)}</b> {c.label}{c.amharic && <span class="geez" lang="am">{c.amharic}</span>}</p>
          <p class="ch__title" set:html={words(c.title)} />
          <p class="ch__line">{c.line}</p>
        </article>
      ))}
      <article class="ch ch--final" data-ch={STORY.final.id}>
        <p class="pill ch__pill"><i></i>{ORG.name} <span class="geez" lang="am">{ORG.amharic}</span></p>
        <h1 class="ch__title ch__title--final" id="story-title" set:html={words(finalTitle)} />
        <p class="ch__line ch__lede">{HERO.lede}</p>
        <div class="row ch__ctas">
          <a class="btn" href="/members">Meet the members <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" /></svg></a>
          <a class="btn btn--ghost" href="/aalf">AALF 2026<span class="ch__dates"> · {AALF_2026.dates}</span></a>
        </div>
      </article>
    </div>

    <nav class="rail wrap" aria-label="Chapters of the film">
      <ol role="list" class="rail__list">
        {[...STORY.chapters, { id: STORY.final.id, label: STORY.final.label }].map((c, i) => (
          <li>
            <button type="button" class="rail__seg" data-seek={c.id}>
              <span class="rail__lbl"><b>{pad(i + 1)}</b> {c.label}</span>
              <span class="rail__bar"><i></i></span>
            </button>
          </li>
        ))}
      </ol>
      <button type="button" class="rail__btn" data-story-toggle aria-label="Pause the film" aria-pressed="false">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.5v13M15.5 5.5v13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
        <svg class="i-replay" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12a7 7 0 1 0 2.05-4.95M5 4.5V8h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </nav>
  </div>
</section>

<style>
  /* the stage stays on screen while the door opens (--door screens of scrolling, set by story.ts) and a little after */
  .story { height: calc(130svh + var(--door, 0) * 100svh); background: var(--ink); }
  /* held by the stacking (scripts/motion.ts) it is sticky; otherwise simply positioned (never both: a relative
     section would be pushed up by the sticky offset) */
  .story:not(.is-stacked) { position: relative; }
  /* the door is there from the first paint (with the script and motion), so nothing jumps when the script arrives:
     the page colour and the name first, the mark as soon as the script has placed it */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .story { --door: 1.6; background: var(--paper); }
    :global(.js) .story .story__door, :global(.js) .story .story__outline { display: block; }
    :global(.js) .story .story__hello { display: grid; }
    :global(.js) .story:not(.is-open) .story__copy, :global(.js) .story:not(.is-open) .rail, :global(.js) .story:not(.is-open) .story__pins { opacity: 0; visibility: hidden; }
  }
  /* the stage stays on screen to the end; then the whole section is held (scripts/motion.ts stacks it like the
     other sections) and the next one slides up over it */
  .story__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; color: var(--cream); isolation: isolate; }
  .story__view { position: absolute; inset: 0; z-index: 0; }
  .story :global(.story__film) { position: absolute; inset: 0; z-index: 0; }
  /* the last frame as a still: exactly the film's last frame (the same picture, the same framing), so the film hands
     over to it without a seam; whatever moves in it afterwards starts from stillness and grows in */
  .story__end { position: absolute; inset: 0; z-index: 1; overflow: hidden; opacity: 0; transition: opacity 0.6s linear; }
  .story__end img { width: 100%; height: 100%; object-fit: cover; }
  .story.is-end .story__end { opacity: 1; }
  .story__smoke { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 2s var(--ease); }
  .story.is-end .story__smoke.is-on { opacity: 1; }
  /* once the living frame is drawn over it (and has faded in), the picture under it is not drawn */
  .story__view:has(.story__smoke.is-on) .story__end { visibility: hidden; transition: opacity 0.6s linear, visibility 0s linear 2.2s; }
  /* where the words sit, a neutral shadow (the film's own colours elsewhere) */
  .story__shade {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      linear-gradient(180deg, rgb(60 30 22 / 0.53) 0%, rgb(60 30 22 / 0) 18%),
      linear-gradient(0deg, rgb(60 30 22 / 0.83) 0%, rgb(60 30 22 / 0.35) 24%, rgb(60 30 22 / 0) 46%),
      radial-gradient(85% 70% at 0% 100%, rgb(60 30 22 / 0.63), transparent 62%);
  }

  /* the final frame never stands still: a slow drift, and (story.ts) it follows the pointer, and the chimney smokes */
  @media (prefers-reduced-motion: no-preference) {
    /* (where the living frame cannot be drawn) the still drifts, starting from exactly where the film stopped */
    .story.is-end .story__end img { animation: story-drift 30s cubic-bezier(0.45, 0, 0.4, 1) 0.8s infinite alternate both; }
    .story.is-end .story__copy { transform: translate3d(calc(var(--px, 0) * 8px), calc(var(--py, 0) * 5px), 0); transition: transform 1.6s var(--ease); }
  }
  @keyframes story-drift {
    from { transform: none; }
    to { transform: scale(1.07) translate3d(-1.2%, -1.4%, 0); }
  }

  /* the door: a canvas the size of the stage (the page colour until it first draws), and the outline over it */
  .story__door { position: absolute; inset: 0; z-index: 6; width: 100%; height: 100%; display: none; background: var(--paper); }
  .story.is-open .story__door, .story.no-door .story__door { visibility: hidden; }
  .story__outline { position: absolute; inset: 0; z-index: 7; width: 100%; height: 100%; display: none; overflow: visible; pointer-events: none; }
  .story.door-played .story__outline, .story.no-door .story__outline { display: none !important; }
  .story__outline-path { fill: none; stroke: var(--brown-80); stroke-width: 7; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  .story__outline-dot { fill: var(--amber); transform-box: fill-box; transform-origin: center; transform: scale(0); }
  .story__hello {
    position: absolute; inset: auto 0 0; z-index: 7; display: none; grid-template-columns: 1fr auto; align-items: end; gap: 12px 40px;
    padding-bottom: clamp(26px, 5vh, 54px); color: var(--ink); opacity: var(--hello, 1); transform: translateY(calc((1 - var(--hello, 1)) * -40px));
  }
  .story.is-open .story__hello, .story.no-door .story__hello { visibility: hidden; }
  .story.no-door { --door: 0 !important; }
  /* the name and the cue come in once the logo has drawn itself (and, should the script never come, by themselves) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .story:not(.door-in) .story__hello > * { opacity: 0; transform: translateY(16px); animation: story-late 0.8s var(--ease) 4s forwards; }
    :global(.js) .story.door-in .story__hello > * { opacity: 1; transform: none; transition: opacity 0.9s var(--ease), transform 1.1s var(--ease); }
    :global(.js) .story.door-in .story__hello > :nth-child(2) { transition-delay: 0.12s; }
  }
  @keyframes story-late { to { opacity: 1; transform: none; } }
  .story__name {
    grid-column: 1; font-family: var(--f-display); font-weight: 760; font-stretch: 78%; letter-spacing: -0.03em; line-height: 0.92;
    font-size: clamp(2rem, 1rem + 3.2vw, 4.4rem); color: var(--ink);
  }
  .story__name span { display: block; }
  .story__amh { grid-column: 1; font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.2rem); color: var(--taupe); }


  /* the pins: a lit dot on the thing, a hairline up from it, its name on a small glass tag. They ride on the film
     (scripts/story.ts moves them frame by frame) and come and go with what they name. */
  .story__pins { position: absolute; inset: 0; z-index: 4; pointer-events: none; overflow: hidden; transition: opacity 1s var(--ease); }
  .pin { position: absolute; left: 0; top: 0; --stem: 46px; will-change: transform; }
  .pin__dot {
    position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--amber), 0 0 0 5px rgb(226 160 37 / 0.14), 0 0 22px rgb(226 160 37 / 0.55);
    transform: scale(0); transition: transform 0.35s var(--ease);
  }
  .pin__dot::after { content: ''; position: absolute; inset: 3.5px; border-radius: 50%; background: var(--amber); }
  .pin__stem {
    position: absolute; left: -0.5px; bottom: 7px; width: 1px; height: var(--stem);
    background: linear-gradient(0deg, rgb(226 160 37 / 0.95), rgb(255 252 245 / 0.5));
    transform-origin: 50% 100%; transform: scaleY(0); transition: transform 0.3s var(--ease);
  }
  .pin__tag {
    position: absolute; left: -1px; bottom: calc(var(--stem) + 9px); display: inline-flex; align-items: center; gap: 0.75em;
    padding: 6px 11px 6px 9px; border-radius: 8px; white-space: nowrap;
    font-family: var(--f-mono); font-size: 11px; font-weight: 450; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream);
    background: rgb(60 30 22 / 0.53); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.16);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    opacity: 0; transform: translateY(6px); transition: opacity 0.25s var(--ease), transform 0.4s var(--ease);
  }
  .pin__tag b { color: var(--amber); font-weight: 500; }
  .pin.is-l .pin__tag { left: auto; right: -1px; }
  .pin.on .pin__dot { transform: scale(1); transition: transform 0.6s var(--spring); }
  .pin.on .pin__stem { transform: scaleY(1); transition: transform 0.5s var(--ease) 0.12s; }
  .pin.on .pin__tag { opacity: 1; transform: none; transition: opacity 0.5s var(--ease) 0.3s, transform 0.7s var(--ease) 0.3s; }
  :global(.intro-on) .story__pins { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .story__pins { display: none; } }

  /* the chapters share one place, bottom left, above the rail */
  .story__copy {
    position: absolute; inset: auto 0 0; z-index: 5; display: grid; padding-bottom: clamp(108px, 15vh, 156px);
    transition: opacity 0.8s var(--ease), transform 1.2s var(--ease);
  }
  .ch { grid-area: 1 / 1; align-self: end; max-width: min(820px, 92vw); pointer-events: none; }
  .ch.on { pointer-events: auto; }
  .ch__label { margin-bottom: 18px; text-shadow: 0 1px 12px rgb(60 30 22 / 0.6); }
  .ch__line { text-shadow: 0 1px 18px rgb(60 30 22 / 0.5); }
  .ch__title {
    font-family: var(--f-display); font-weight: 640; font-stretch: 80%; letter-spacing: -0.026em; line-height: 0.88;
    font-size: clamp(3rem, 1.2rem + 6.2vw, 7.6rem); text-wrap: balance; text-shadow: 0 2px 40px rgb(60 30 22 / 0.35);
  }
  .ch__title :global(em) { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 88%; letter-spacing: -0.02em; color: var(--amber); }
  .ch__title--final { font-size: clamp(3.2rem, 1.2rem + 7vw, 8.6rem); }
  /* the last line takes the light: a slow amber sheen runs across it */
  @media (prefers-reduced-motion: no-preference) {
    .ch--final.on .ch__title--final :global(em) {
      background: linear-gradient(100deg, var(--amber) 0%, var(--amber) 38%, #faefdb 48%, var(--amber) 58%, var(--amber) 100%) 0 0 / 260% 100%;
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      animation: story-sheen 7s var(--ease-in-out) 1.6s infinite;
    }
  }
  @keyframes story-sheen { 0% { background-position: 100% 0; } 45%, 100% { background-position: 0% 0; } }
  .ch__line { margin-top: 20px; max-width: 46ch; font-size: var(--step-1); line-height: 1.45; color: rgb(255 252 245 / 0.86); text-wrap: pretty; }
  .ch__pill { margin-bottom: 22px; }
  .ch__ctas { margin-top: 30px; }

  /* the motion: words rise out of a blur as their chapter comes in, and lift away as it leaves */
  .ch :global(.w) { display: inline-block; }
  :global(.js) .ch .ch__label, :global(.js) .ch .ch__line, :global(.js) .ch .ch__ctas, :global(.js) .ch .ch__pill { opacity: 0; transform: translateY(12px); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease); }
  :global(.js) .ch :global(.w) {
    opacity: 0; transform: translateY(0.42em); filter: blur(12px);
    transition: opacity 0.55s var(--ease), transform 0.8s var(--ease), filter 0.6s var(--ease);
    transition-delay: calc(var(--i) * 0.035s);
  }
  :global(.js) .ch.on .ch__label { opacity: 1; transform: none; transition-delay: 0s; }
  :global(.js) .ch.on :global(.w) { opacity: 1; transform: none; filter: none; transition-delay: calc(0.06s + var(--i) * 0.04s); transition-duration: 0.7s, 0.85s, 0.7s; }
  :global(.js) .ch.on .ch__line, :global(.js) .ch.on .ch__pill { opacity: 1; transform: none; transition-delay: 0.3s; }
  :global(.js) .ch.on .ch__ctas { opacity: 1; transform: none; transition-delay: 0.5s; }
  :global(.js) .ch.gone :global(.w) { opacity: 0; transform: translateY(-0.3em); filter: blur(10px); transition-delay: calc(var(--i) * 0.02s); }
  :global(.js) .ch.gone .ch__label, :global(.js) .ch.gone .ch__line { opacity: 0; transform: translateY(-8px); }
  /* the final title lands bigger: each word drops in from above its line */
  :global(.js) .ch--final :global(.w) { transform: translateY(-0.5em) rotate(-3deg); transform-origin: 0 100%; }
  :global(.js) .ch--final.on :global(.w) { transition-duration: 0.6s, 1.1s, 0.6s; transition-timing-function: var(--ease), var(--spring), var(--ease); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ch :global(.w), :global(.js) .ch .ch__label, :global(.js) .ch .ch__line, :global(.js) .ch .ch__ctas, :global(.js) .ch .ch__pill { transition: opacity 0.4s linear; transform: none; filter: none; }
  }
  /* without the script the last chapter simply stands */
  :global(html:not(.js)) .ch:not(.ch--final) { display: none; }

  /* the rail: one segment per chapter; each fills with its part of the film; a click goes there. Once the film is
     over, it steps back and the replay button stays */
  .rail { position: absolute; left: 0; right: 0; bottom: clamp(22px, 4vh, 40px); z-index: 5; display: flex; align-items: center; gap: 14px; margin-inline: auto; transition: opacity 0.8s var(--ease); }
  .story.is-end .rail__list { opacity: 0.35; transition: opacity 1.2s var(--ease) 1.2s; }
  .story.is-end .rail__list:hover, .story.is-end .rail__list:focus-within { opacity: 1; transition-delay: 0s; }
  .rail__list { flex: 1; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .rail__seg { display: grid; gap: 10px; width: 100%; text-align: left; padding: 8px 0; }
  .rail__lbl { font-family: var(--f-mono); font-weight: 520; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(255 252 245 / 0.55); transition: color 0.4s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail__lbl b { color: rgb(226 160 37 / 0.85); font-weight: 500; margin-right: 6px; transition: color 0.4s; }
  .rail__bar { position: relative; display: block; height: 2px; border-radius: 2px; background: rgb(255 252 245 / 0.18); overflow: hidden; }
  .rail__bar i { position: absolute; inset: 0; background: var(--amber); transform-origin: left; transform: scaleX(var(--p, 0)); box-shadow: 0 0 12px var(--amber); }
  .rail__seg:hover .rail__lbl, .rail__seg.on .rail__lbl { color: var(--cream); }
  .rail__seg.on .rail__lbl b { color: var(--amber); }
  .rail__btn {
    flex: none; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; color: var(--cream);
    background: rgb(60 30 22 / 0.56); box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.18); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: background 0.25s, transform 0.4s var(--spring);
  }
  .rail__btn:hover { background: rgb(60 30 22 / 0.88); transform: scale(1.06); }
  .rail__btn svg { width: 18px; height: 18px; grid-area: 1 / 1; }
  .rail__btn .i-play, .rail__btn .i-replay { display: none; }
  .story[data-state='paused'] .rail__btn .i-pause { display: none; }
  .story[data-state='paused'] .rail__btn .i-play { display: block; }
  .story.is-end .rail__btn .i-pause, .story.is-end .rail__btn .i-play { display: none; }
  .story.is-end .rail__btn .i-replay { display: block; }

  /* the brand film plays first on a first visit (other pages): everything waits behind it */
  :global(.intro-on) .story__copy, :global(.intro-on) .rail { opacity: 0; }

  @media (max-width: 900px) and (orientation: portrait) {
    .story__shade {
      background:
        linear-gradient(180deg, rgb(60 30 22 / 0.63) 0%, rgb(60 30 22 / 0) 22%),
        linear-gradient(0deg, rgb(60 30 22 / 0.95) 0%, rgb(60 30 22 / 0.63) 30%, rgb(60 30 22 / 0) 58%);
    }
    .story__copy { padding-bottom: 96px; }
    .ch__title { font-size: clamp(2.7rem, 12vw, 4.2rem); }
    .ch__title--final { font-size: clamp(2.9rem, 13vw, 4.6rem); }
    .ch__line { font-size: 1rem; margin-top: 14px; }
    .ch__pill .geez { display: none; }
    .pin { --stem: 34px; }
    .pin__tag { font-size: 10px; padding: 5px 9px 5px 8px; letter-spacing: 0.1em; }
    .ch__dates { display: none; }
    /* the chapter names leave the screen but stay with the buttons, for screen readers */
    .rail__lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .rail__seg { position: relative; }
    .rail__list { gap: 6px; }
    .story__hello { grid-template-columns: 1fr; }
