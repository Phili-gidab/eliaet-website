---
/* The 3D stage: leather pieces made in Blender that a visitor can turn. Every piece has a picture rendered in
   Blender from the stage's own camera; that picture is all there is without script, without 3D, or for less motion
   until someone turns it; otherwise the model (scripts/stage3d-gl.ts) takes over from it as the stage comes near. */
import { responsive } from '../lib/media'
import type { StagePiece } from '../copy/stage'

interface Props {
  pieces: StagePiece[]
  class?: string
  sizes?: string
}
const { pieces, class: cls, sizes = '(max-width: 960px) 92vw, 540px' } = Astro.props
const config = pieces.map((p) => ({
  key: p.key, name: p.name, model: p.model, note: p.note, view: p.view,
  label: `${p.alt} A 3D model: drag it, or use the arrow keys, to turn it.`,
}))
---

<figure class:list={['s3d', cls]} data-s3d data-pieces={JSON.stringify(config)}>
  <div class="s3d__view">
    {pieces.map((p, i) => (
      <img
        class:list={['s3d__poster', { 'is-on': i === 0 }]}
        data-poster={p.key}
        src={p.poster}
        alt={i === 0 ? p.alt : ''}
        width="1080"
        height="1350"
        loading="lazy"
        decoding="async"
        {...responsive(p.poster, sizes)}
      />
    ))}
    <canvas class="s3d__canvas" role="img" tabindex="0"></canvas>
    <span class="s3d__hint" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 12h16M4 12l4-4M4 12l4 4M20 12l-4-4M20 12l-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Drag to turn
    </span>
    <span class="s3d__badge" aria-hidden="true">3D</span>
    <button class="s3d__ask" type="button" data-s3d-load hidden>Turn it in 3D</button>
  </div>
  <figcaption class="s3d__bar">
    {pieces.length > 1 && (
      <div class="s3d__tabs" role="group" aria-label="Choose a piece">
        {pieces.map((p, i) => (
          <button type="button" class="s3d__tab" data-piece={p.key} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>
        ))}
      </div>
    )}
    <p class="s3d__note" data-note aria-live="polite">{pieces[0].note}</p>
  </figcaption>
</figure>

<style>
  .s3d { margin: 0; display: grid; gap: 14px; }
  .s3d__view {
    position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); isolation: isolate;
    /* the studio's cream: a paler pool where the piece stands, the floor a touch warmer */
    background:
      radial-gradient(62% 46% at 50% 44%, rgb(255 252 245 / 0.85), rgb(255 252 245 / 0) 72%),
      linear-gradient(180deg, #fffcf5 0%, #faefdb 62%, #f5dfb6 100%);
    box-shadow: inset 0 0 0 1px var(--line-dark);
    touch-action: pan-y;
  }
  .s3d__poster, .s3d__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .s3d__poster { object-fit: cover; opacity: 0; transition: opacity 0.45s var(--ease); }
  .s3d__poster.is-on { opacity: 1; }
  .s3d__canvas { opacity: 0; pointer-events: none; transition: opacity 0.7s var(--ease); cursor: grab; outline: none; }
  .s3d.is-live .s3d__canvas { opacity: 1; pointer-events: auto; }
  .s3d.is-live .s3d__poster { opacity: 0; transition-delay: 0.15s; }
  /* while another piece's model loads, its picture stands in (the model starts from the same view) */
  .s3d.is-live.is-loading .s3d__canvas { opacity: 0; transition-duration: 0.2s; }
  .s3d.is-live.is-loading .s3d__poster.is-on { opacity: 1; transition-delay: 0s; }
  .s3d.is-turning .s3d__canvas { cursor: grabbing; }
  .s3d__canvas:focus-visible { box-shadow: inset 0 0 0 2px var(--ink); border-radius: var(--radius); }

  .s3d__hint, .s3d__badge, .s3d__ask {
    position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px;
    font: 560 11.5px/1 var(--f-text); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink);
    background: rgb(255 252 245 / 0.82); box-shadow: inset 0 0 0 1px var(--line-dark);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .s3d__hint { left: 50%; bottom: 16px; transform: translate(-50%, 6px); padding: 9px 14px; opacity: 0; transition: opacity 0.4s, transform 0.4s var(--ease); pointer-events: none; }
  .s3d__hint svg { width: 16px; height: 16px; }
  .s3d.is-live:not(.is-used) .s3d__hint { opacity: 1; transform: translate(-50%, 0); transition-delay: 0.9s; }
  .s3d__badge { top: 14px; right: 14px; padding: 7px 10px; opacity: 0; transition: opacity 0.4s; }
  .s3d.can-3d .s3d__badge { opacity: 1; }
  .s3d__ask { left: 50%; bottom: 16px; transform: translateX(-50%); padding: 11px 16px; cursor: pointer; }
  .s3d__ask[hidden] { display: none; }

  .s3d__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .s3d__tabs { display: inline-flex; gap: 6px; padding: 4px; border-radius: 999px; background: rgb(60 30 22 / 0.06); }
  :global(html:not(.js)) .s3d__tabs { display: none; }
  .s3d__tab {
    padding: 9px 16px; border-radius: 999px; font: 600 13px/1 var(--f-text); color: var(--brown-80); cursor: pointer;
    transition: background 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .s3d__tab:hover { color: var(--ink); }
  .s3d__tab[aria-pressed='true'] { color: var(--cream); background: var(--ink); }
  .s3d__note { margin: 0; flex: 1 1 220px; color: var(--brown-80); font-size: 14.5px; line-height: 1.45; }
  @media (prefers-reduced-motion: reduce) {
    .s3d__poster, .s3d__canvas, .s3d__hint { transition: none; }
  }
</style>

<script>
  import '../scripts/stage3d'
</script>
