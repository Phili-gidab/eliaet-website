---
/* The top of an inner page as a magazine cover: a screen-high field in the page's own colour from the brand guide,
   the title set huge across it, the page's subject standing in front of the title (a figure cut out of a photograph,
   tools/segment.py, or, on Programs, the leather goods in 3D, scripts/cover3d.ts), a running head with the page's
   number, the lede, and the page's sections as cover lines ("In this issue"). A page can set something of its own
   into the cover's foot (the fair's dates). scripts/motion.ts sets the title in and lets the subject come up; as the
   page scrolls on, the subject rises a little faster than the title, and the next section slides over the cover. */
interface Line { href: string; label: string }
interface Props {
  /** the page's number, as in the menu */
  n: string
  kicker: string
  /** the title, a line each (may hold <em>) */
  title: string[]
  lede?: string
  /** the field's colour (a brand colour or tint) and the type's: brown on the light ones, cream on the dark */
  bg: string
  ink?: 'brown' | 'cream'
  /** the subject: a figure cut out of a photograph, the cut's file and what it shows, how tall it stands (CSS
      height) and how far in from the right it stands; on phones the foot laps over its last few lines (its ground and
      shadow), unless lapM is false (a subject with no ground, which the words would cross) */
  cut?: { src: string; alt: string; h?: string; x?: string; y?: string; w?: number; hgt?: number; lapM?: boolean
    /** the photograph cropped the subject at its top (arms reaching in from above): let it fade in from the page */
    fadeTop?: boolean
    /** the subject's own photograph behind it, in a frame it steps out of: the photograph (the cut's size, the cut
        lying exactly on it) and where the frame's top edge is, from the picture's top */
    scene?: { src: string; top?: string; bleed?: boolean } }
  /** the leather goods in 3D in front of the title (a still picture where 3D cannot be drawn) */
  goods?: { poster: string; alt: string }
  /** or a photograph, in a tall panel at the right that runs off the page's edge and foot */
  photo?: { src: string; alt: string; w: number; hgt: number; focus?: string }
  lines?: Line[]
  /** the title's size (CSS), when its words are longer or shorter than most */
  size?: string
  /** a figure set enormous behind the subject, in a deeper shade of the field (the fair's year) */
  numeral?: string
  /** what the page sets into the foot runs the page's width (an address in three columns) */
  wide?: boolean
}
const { n, kicker, title, lede, bg, ink = 'brown', cut, goods, photo, lines = [], size, numeral, wide = false } = Astro.props
const pad = (v: number) => String(v).padStart(2, '0')
const style = `--cv-bg:${bg};${size ? `--cv-hs:${size};` : ''}${cut?.h ? `--cv-h:${cut.h};` : ''}${cut?.x ? `--cv-x:${cut.x};` : ''}${cut?.y ? `--cv-y:${cut.y};` : ''}`
---

<section class:list={['cover', `cover--${ink}`, { 'cover--goods': goods, 'cover--cut': cut, 'cover--photo': photo, 'cover--lap': cut && cut.lapM !== false, 'cover--wide': wide, 'cover--type': !goods && !cut && !photo }]} data-cover data-tone={ink === 'cream' ? 'dark' : 'light'} style={style}>
  <p class="cover__run wrap" aria-hidden="true">
    <span class="cover__brand">ELIA</span>
    <span class="cover__no">N° {n}</span>
    <i class="cover__rule"></i>
    <span class="cover__kicker">{kicker}</span>
  </p>
  <h1 class="cover__title">
    {title.map((t, i) => <Fragment><span class="ln" style={`--i:${i}`}><span class="ln__in" set:html={t} /></span>{i < title.length - 1 && ' '}</Fragment>)}
  </h1>
  {numeral && <p class="cover__num" aria-hidden="true">{numeral}</p>}
  {cut && (
    cut.scene ? (
      <div class:list={['cover__cut', 'cover__scene', { 'cover__scene--bleed': cut.scene.bleed }]} data-cover-subject style={`aspect-ratio:${cut.w} / ${cut.hgt};--sc-top:${cut.scene.top ?? '34%'}`}>
        <img class="cover__scene-pic" src={cut.scene.src} alt="" width={cut.w} height={cut.hgt} decoding="async" fetchpriority="high" />
        <img class="cover__scene-cut" src={cut.src} alt={cut.alt} width={cut.w} height={cut.hgt} decoding="async" fetchpriority="high" />
      </div>
    ) : (
      <img class:list={['cover__cut', { 'cover__cut--fade': cut.fadeTop }]} data-cover-subject src={cut.src} alt={cut.alt} width={cut.w} height={cut.hgt} decoding="async" fetchpriority="high" />
    )
  )}
  {photo && (
    <figure class="cover__photo" data-cover-subject>
      <img src={photo.src} alt={photo.alt} width={photo.w} height={photo.hgt} decoding="async" fetchpriority="high" style={photo.focus ? `object-position:${photo.focus}` : undefined} />
    </figure>
  )}
  {goods && (
    <div class="cover__goods" data-cover-subject>
      <img class="cover__poster" src={goods.poster} alt="" decoding="async" />
      <canvas class="cover__gl" data-cover-gl role="img" aria-label={goods.alt}></canvas>
    </div>
  )}
  <div class="cover__foot wrap">
    {lede && <p class="cover__lede">{lede}</p>}
    <slot />
    {lines.length > 0 && (
      <nav class="cover__lines" aria-label="On this page">
        <p class="cover__in">In this issue</p>
        <ol role="list">
          {lines.map((l, i) => <li><a href={l.href}><span class="cover__ln">{pad(i + 2)}</span>{l.label}</a></li>)}
        </ol>
      </nav>
    )}
  </div>
</section>
<script is:inline>
  /* the cover's type is set in as soon as it is first painted, without waiting for the page's script */
  (function (s) { if (s) requestAnimationFrame(function () { requestAnimationFrame(function () { s.classList.add('is-in') }) }) })(document.currentScript && document.currentScript.previousElementSibling)
</script>

<style>
  .cover {
    --cv-hs: clamp(4rem, 1rem + 11.5vw, 13.5rem); --cv-h: 84svh; --cv-x: 7vw;
    --ink-c: var(--brand-brown); --soft-c: var(--brown-80); --rule-c: rgb(60 30 22 / 0.4);
    isolation: isolate; overflow: clip; min-height: max(100svh, 640px);
    /* the running head, the title and the foot in one column, the foot at the bottom: on a short screen the cover
       grows rather than letting the foot run over the title */
    display: flex; flex-direction: column;
    background: var(--cv-bg); color: var(--ink-c); color-scheme: light;
    --sheet-bg: var(--cv-bg); --sheet-fg: var(--ink-c);
  }
  /* held in place by the stacking (motion.ts) it is sticky; otherwise it is simply positioned. Never both: a
     relative cover would be pushed up by the sticky offset when it is taller than the screen */
  .cover:not(.is-stacked) { position: relative; }
  .cover--cream { --ink-c: var(--cream); --soft-c: var(--amber-60); --rule-c: rgb(255 252 245 / 0.4); color-scheme: dark; }
  /* a soft light from above, and the brand's fine grain, so the field is a surface and not a flat fill */
  .cover::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 60% at 70% 30%, rgb(255 252 245 / 0.22), transparent 70%), radial-gradient(90% 70% at 50% 110%, rgb(60 30 22 / 0.16), transparent 60%);
  }
  .cover--cream::before { background: radial-gradient(70% 60% at 70% 25%, rgb(226 160 37 / 0.2), transparent 70%); }

  .cover__run {
    position: relative; z-index: 4; display: flex; align-items: center; gap: 14px; margin: 0;
    padding-top: calc(var(--header-h) + 18px);
    font-size: 11.5px; font-weight: 650; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap;
  }
  .cover__brand { font-weight: 800; letter-spacing: 0.22em; }
  .cover__rule { flex: 1; height: 1px; background: var(--rule-c); transform-origin: left; }

  .cover__title {
    position: relative; z-index: 1; margin: max(14px, calc(9svh - 33px)) var(--gutter) 0; max-width: 96vw;
    font-family: var(--f-display); font-size: var(--cv-hs); font-weight: 800; font-stretch: 75%; letter-spacing: -0.05em; line-height: 0.83;
  }
  .cover__title .ln { display: block; overflow: hidden; padding: 0.06em 0.12em 0.3em; margin: -0.06em -0.12em -0.3em; }
  .cover__title .ln__in { display: inline-block; }
  .cover__title :global(em) { font-family: var(--f-text); font-style: italic; font-weight: 300; font-stretch: 100%; letter-spacing: -0.045em; color: var(--soft-c); }
  /* a small italic joining word between two big ones, set on their baseline: it keeps clear of the line above's
     descenders (the j of Projects) */
  .cover__title :global(em.and) { font-size: 0.6em; margin-right: 0.06em; letter-spacing: -0.03em; }

  /* the subject, in front of the title */
  .cover__cut {
    position: absolute; z-index: 2; right: var(--cv-x); bottom: var(--cv-y, 0); height: var(--cv-h); width: auto; max-width: none;
    pointer-events: none; filter: var(--grade, none) drop-shadow(0 30px 40px rgb(60 30 22 / 0.18));
  }
  /* the goods stand behind the title (the type lies over them, as on a cover), clear of the running head */
  .cover__goods { position: absolute; z-index: 0; inset: 0; pointer-events: none; }
  .cover__photo {
    position: absolute; z-index: 2; right: 0; bottom: 0; margin: 0; width: min(40vw, 720px); height: min(80svh, 880px);
    border-radius: var(--radius-l) 0 0 0; overflow: hidden; box-shadow: -30px 0 70px -30px rgb(60 30 22 / 0.55);
  }
  .cover__photo img { width: 100%; height: 100%; object-fit: cover; }
  /* where a long title reaches the photograph, the title lies over it */
  .cover--photo .cover__title { z-index: 3; }
  .cover__cut--fade { -webkit-mask: linear-gradient(180deg, transparent 0%, #000 34%); mask: linear-gradient(180deg, transparent 0%, #000 34%); }
  /* the subject in its own landscape: the photograph shows through a frame from below the shoulders down, and the
     figure, cut from that same photograph and lying exactly on it, rises out of the frame's top edge */
  .cover__scene { width: auto; }
  .cover__scene img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cover__scene-pic { clip-path: inset(var(--sc-top) 0 0 0 round var(--radius-l) var(--radius-l) 0 0); }
  /* or the landscape runs off the page's right edge and foot, half the cover wide, its one free corner rounded */
  .cover__scene--bleed { right: 0; bottom: 0; height: auto; width: min(54vw, 1060px); filter: var(--grade, none) drop-shadow(-24px 0 50px rgb(60 30 22 / 0.35)); }
  .cover__scene--bleed .cover__scene-pic { clip-path: inset(var(--sc-top) 0 0 0 round var(--radius-l) 0 0 0); }
  .cover__gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s var(--ease); }
  .cover.has-gl .cover__gl { opacity: 1; }
  .cover__poster { position: absolute; right: 4vw; bottom: 0; height: 80svh; width: auto; opacity: 0; }
  .cover.no-gl .cover__poster { opacity: 1; }
  .cover.no-gl .cover__gl { display: none; }

  /* the figure behind the subject */
  .cover__num {
    position: absolute; z-index: 1; right: -1.5vw; bottom: 3svh; margin: 0; pointer-events: none;
    font-family: var(--f-display); font-size: min(34vw, 62svh); font-weight: 800; font-stretch: 75%; letter-spacing: -0.06em; line-height: 0.8;
    color: var(--cv-num, rgb(60 30 22 / 0.13)); white-space: nowrap;
  }
  .cover--cream .cover__num { color: var(--cv-num, rgb(226 160 37 / 0.16)); }
  /* a cover of type alone: the figure stands up at the right, across from the title */
  .cover--type .cover__num { top: calc(var(--header-h) + 6svh); bottom: auto; right: var(--gutter); font-size: min(30vw, 52svh); }
  .cover--wide .cover__foot > * { max-width: min(1120px, 100%); }
  /* the contact page's address and its forms' button, set tight in the foot */
  .cover__foot :global(.ledger) { margin-top: 0; }
  .cover__foot :global(.ph-forms) { margin-top: 0; }

  /* what a page sets into the foot is written for the dark: on a light cover its colours turn round, and its
     buttons are brown (amber would not stand out from an amber field); a piece with colours of its own keeps them */
  .cover--brown .cover__foot {
    --cream: var(--brand-brown); --bone: var(--brown-80); --muted: var(--brown-80); --amber: var(--brand-brown);
    --line: rgb(60 30 22 / 0.16); --line-2: rgb(60 30 22 / 0.26);
  }
  .cover--brown .cover__foot :global(.btn:not(.btn--ghost, .btn--keep)) { --bg: #3c1e16; --fg: #fffcf5; box-shadow: 0 12px 30px -14px rgb(60 30 22 / 0.65); }
  .cover--brown .cover__foot :global(.btn:not(.btn--ghost, .btn--keep):hover) { --bg: #5d443d; }
  .cover--brown .cover__foot :global(.btn--ghost) { --fg: #3c1e16; --bg: rgb(60 30 22 / 0.05); box-shadow: inset 0 0 0 1.5px rgb(60 30 22 / 0.32); }
  .cover--brown .cover__foot :global(.ph-note) { background: rgb(255 252 245 / 0.35); }
  .cover--brown .cover__foot :global(.ph-note a) { color: var(--brand-brown); text-decoration-color: rgb(60 30 22 / 0.4); }
  .cover--brown .cover__foot :global(.ntab:hover) { background: rgb(60 30 22 / 0.07); }

  /* the foot: the lede, what the page sets in, the cover lines, down the left, clear of the subject */
  .cover__foot {
    position: relative; z-index: 4; margin-top: auto; padding-top: clamp(28px, 4svh, 48px);
    /* clear of the next sheet's rounded edge and the tab that stands up from it */
    padding-bottom: calc(var(--radius-l) + var(--tab-h) + 30px);
    display: grid; justify-items: start; gap: 22px; pointer-events: none;
  }
  .cover__foot > * { pointer-events: auto; max-width: min(560px, 46vw); }
  /* the cover sets its foot in itself; what a page puts there does not wait for its own reveal */
  .cover__foot :global([data-reveal]) { opacity: 1; transform: none; filter: none; transition: none; }
  .cover__lede { margin: 0; max-width: 40ch !important; font-size: clamp(1.05rem, 0.92rem + 0.45vw, 1.35rem); line-height: 1.42; font-weight: 450; text-wrap: pretty; }
  .cover__lines { width: min(560px, 46vw); }
  .cover__in { margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  .cover__lines ol { margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; border-top: 1px solid var(--rule-c); }
  .cover__lines a {
    display: flex; gap: 14px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--rule-c);
    font-size: 15px; font-weight: 560; transition: padding 0.4s var(--ease), color 0.3s;
  }
  .cover__lines a:hover { padding-left: 8px; }
  .cover__ln { font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; opacity: 0.8; }
  .cover :global(:focus-visible) { outline-color: var(--ink-c); }

  /* set in (without script: simply there) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cover .ln__in { transform: translateY(110%) rotate(2.5deg); transition: transform 1.25s var(--ease); transition-delay: calc(var(--i, 0) * 0.09s + 0.1s); }
    :global(.js) .cover.is-in .ln__in { transform: none; }
    :global(.js) .cover__rule { transform: scaleX(0); transition: transform 1.4s var(--ease-in-out) 0.1s; }
    :global(.js) .cover.is-in .cover__rule { transform: none; }
    :global(.js) .cover__cut { opacity: 0; transform: translateY(7%) scale(1.02); transition: opacity 0.9s var(--ease) 0.25s, transform 1.5s var(--ease) 0.25s; }
    :global(.js) .cover.is-in .cover__cut { opacity: 1; transform: none; }
    :global(.js) .cover__photo { clip-path: inset(100% 0 0 0 round var(--radius-l) 0 0 0); transition: clip-path 1.5s var(--ease-in-out) 0.2s; }
    :global(.js) .cover.is-in .cover__photo { clip-path: inset(0 0 0 0 round var(--radius-l) 0 0 0); }
    :global(.js) .cover__foot { opacity: 0; transform: translateY(18px); transition: opacity 0.9s var(--ease) 0.5s, transform 1.1s var(--ease) 0.5s; }
    :global(.js) .cover.is-in .cover__foot { opacity: 1; transform: none; }
  }

  /* on a phone the cover is read down the screen: the title, the subject straight under it and standing in front of
     its last line, then the lede (or what the page sets in) coming up over the subject's foot */
  @media (max-width: 760px) {
    .cover { --cv-hs: clamp(3rem, 15vw, 5.4rem); min-height: max(100svh, 600px); }
    .cover__run { gap: 10px; font-size: 10.5px; letter-spacing: 0.12em; }
    .cover__kicker { display: none; }
    .cover__title { margin: 3svh var(--gutter) 0; }
    .cover__goods { position: relative; inset: auto; flex: none; height: min(50svh, 122vw); margin-top: -10svh; }
    .cover__poster { right: 50%; translate: 50% 0; height: 100%; }
    .cover__cut { position: relative; right: auto; bottom: auto; flex: none; align-self: center; height: min(60svh, 130vw); margin-top: -6svh; }
    .cover__scene { height: auto; width: min(94vw, 520px); margin: -2svh 0 22px; }
    .cover__photo { position: relative; right: auto; bottom: auto; flex: none; align-self: center; width: calc(100% - 2 * var(--gutter)); height: min(52svh, 112vw); margin: 2svh 0 16px; border-radius: var(--radius-l); box-shadow: none; }
    .cover__scene-pic, .cover__scene--bleed .cover__scene-pic { clip-path: inset(var(--sc-top) 0 0 0 round var(--radius-l)); }
    .cover__scene--bleed { width: min(94vw, 520px); filter: var(--grade, none); }
    .cover__foot { margin-top: 8px; padding-top: 10px; padding-bottom: calc(var(--radius-l) + var(--tab-h) + 30px); gap: 18px; }
    .cover--lap .cover__foot { margin-top: -56px; }
    .cover__foot > * { max-width: none; }
    .cover__lines { width: 100%; }
    .cover__lines ol { column-gap: 16px; }
    .cover__lines a { font-size: 13.5px; padding: 8px 0; gap: 10px; }
    .cover__num { font-size: 46vw; right: 50%; translate: 50% 0; top: calc(var(--header-h) + 24svh); bottom: auto; }
    /* (a cover of type alone has no picture for its numeral to stand behind: on a phone it would only crowd the title) */
    .cover--type .cover__num { display: none; }
  }
</style>
