---
/* Steps in order, joined by a stitched line (the value chain, how ELIA helps a buyer). */
interface Props {
  items: { title: string; text: string }[]
  label?: string
  class?: string
  /** the section's colour, for the ring that sets each number off the stitched line */
  ring?: string
}
const { items, label, class: cls, ring } = Astro.props
---

<ol class:list={['steps', cls]} role="list" aria-label={label} style={`--cols:${items.length}${ring ? `;--sec-bg:${ring}` : ''}`}>
  {items.map((it, i) => (
    <li class="steps__item" data-reveal style={`--d:${i * 0.07}s`}>
      <span class="steps__n figure-num" aria-hidden="true">{i + 1}</span>
      <div>
        <h3 class="steps__t">{it.title}</h3>
        <p class="steps__p">{it.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  :where(.steps) { margin: 0; }
  .steps { --n: 52px; list-style: none; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 18px; position: relative; }
  .steps::before {
    content: ''; position: absolute; top: calc(var(--n) / 2); left: calc(var(--n) / 2); height: 0;
    right: calc((100% - (var(--cols) - 1) * 18px) / var(--cols) - var(--n) / 2);
    border-top: 1.5px dashed rgb(226 160 37 / 0.55);
  }
  .steps__item { position: relative; display: grid; gap: 18px; align-content: start; }
  .steps__n {
    position: relative; width: var(--n); height: var(--n); border-radius: 50%; display: grid; place-items: center;
    font-size: 20px; color: var(--ink); background: var(--amber); box-shadow: 0 0 0 6px var(--sec-bg, var(--ink));
  }
  :global(.sec--paper) .steps__n { box-shadow: 0 0 0 6px var(--paper); }
  .steps__t { font-family: var(--f-display); font-weight: 650; font-stretch: 88%; font-size: 1.3rem; line-height: 1.12; letter-spacing: -0.02em; }
  .steps__p { margin-top: 8px; color: var(--bone); font-size: 15.5px; line-height: 1.55; max-width: 34ch; }
  :global(.sec--paper) .steps__p { color: var(--brown-80); }
  @media (max-width: 900px) {
    .steps { grid-auto-flow: row; gap: 26px; }
    .steps::before { top: calc(var(--n) / 2); bottom: auto; height: calc(100% - var(--n)); left: calc(var(--n) / 2); right: auto; border-top: 0; border-left: 1.5px dashed rgb(226 160 37 / 0.55); }
    .steps__item { grid-template-columns: var(--n) 1fr; }
  }
</style>
