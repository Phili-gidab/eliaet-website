---
// Roboto, the ELIA typeface (brand guide), with its weight and width axes; Noto Sans Ethiopic for Ge'ez (fonts.css)
import '@fontsource-variable/roboto/wdth.css'
import '@fontsource-variable/roboto/wdth-italic.css'
import '../styles/fonts.css'
import '../styles/global.css'
import '../styles/forms.css'
import '../styles/cms.css'
import '../styles/leather.css'
import textUrl from '@fontsource-variable/roboto/files/roboto-latin-wdth-normal.woff2?url'
import italicUrl from '@fontsource-variable/roboto/files/roboto-latin-wdth-italic.woff2?url'
import Header from '../components/Header.astro'
import Loader from '../components/Loader.astro'
import Footer from '../components/Footer.astro'
import LeatherDefs from '../components/LeatherDefs.astro'
import { ORG } from '../copy/site'

interface Props {
  title?: string
  description?: string
  image?: string
  overHero?: boolean
  bodyClass?: string
  /** the page's address, when it is not the file's own (a template the server fills: '/news/@@slug@@') */
  canonicalPath?: string
  /** the link preview's picture exactly as given (a template's '@@image@@', which the server fills with a full URL) */
  imageRaw?: string
  /** pages for signed-in people and the back office: kept out of search engines */
  noindex?: boolean
  /** the header link that is current, when the address alone does not say (a news post: '/news') */
  section?: string
  /** the footer's newsletter sign-up (off on pages with a newsletter section of their own) */
  newsletter?: boolean
}
const {
  title,
  description = ORG.tagline,
  image = '/media/og/elia-og.jpg',
  overHero = false,
  bodyClass = '',
  canonicalPath,
  imageRaw,
  noindex = false,
  section,
  newsletter = true,
} = Astro.props
// pages are built as files (about.html) but served at clean addresses (/about), which is what search engines should see
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/'
const fullTitle = title ? `${title} · ELIA` : `${ORG.name} · ELIA`
const site = String(Astro.site).replace(/\/+$/, '')
const canonical = canonicalPath ? site + canonicalPath : new URL(path, Astro.site).toString()
const ogImage = imageRaw ?? new URL(image, Astro.site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {path !== '/404' && !noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#3c1e16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={textUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ELIA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js')
      try { if (sessionStorage.getItem('elia-intro')) document.documentElement.classList.add('no-intro') } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <LeatherDefs />
    <Loader />
    <a class="skip" href="#main">Skip to content</a>
    <Header path={section ?? path} overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer newsletter={newsletter && !noindex} />
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
