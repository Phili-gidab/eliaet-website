# Copy to server/.env and fill in to have form submissions e-mailed to the secretariat.
# Without SMTP_HOST, submissions are only stored in server/inbox/<form>.jsonl.
PORT=4000
NODE_ENV=production
# INBOX_DIR=inbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ELIA website <no-reply@eliaet.com>
NOTIFY_TO=info@eliaet.com
